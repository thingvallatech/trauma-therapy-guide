---
import { getCollection, type CollectionEntry } from 'astro:content';
import FullscreenLayout from '../../../layouts/FullscreenLayout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n';
import { widgetFor } from '../../../lib/tool-widgets';

export async function getStaticPaths() {
  const tools = await getCollection('tools', (t) => t.data.locale === 'en');
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const Widget = widgetFor(tool.data.componentName);
const exitHref = `/tools/${tool.slug}`;
---

<FullscreenLayout title={`${tool.data.name} — ${t('tools.fullscreenTitleSuffix')}`} exitHref={exitHref}>
  {Widget ? <Widget lang={lang} fullscreen={true} warnings={tool.data.warnings} /> : (
    <div class="text-forest-300 text-sm">Widget not yet implemented.</div>
  )}
</FullscreenLayout>
