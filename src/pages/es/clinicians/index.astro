---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, useTranslatedPath, type Lang } from '../../../i18n';

const lang: Lang = 'es';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout lang={lang} title={t('clinicians.title')} description={t('clinicians.subtitle')}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-forest-900 via-forest-800 to-forest-900 py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl font-semibold text-bronze-gradient mb-4">
          {t('clinicians.title')}
        </h1>
        <p class="text-lg text-forest-100 leading-relaxed">
          {t('clinicians.subtitle')}
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Available Now - Featured Section -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-bronze-500 text-forest-900 text-sm font-medium rounded-full">
            <span class="w-2 h-2 bg-forest-900 rounded-full opacity-80"></span>
            {t('home.availableNow')}
          </span>
        </div>

        <!-- EMDR Featured Card -->
        <a
          href={translatePath('/clinicians/emdr')}
          class="block group relative bg-forest-700 border border-bronze-500 rounded-2xl p-8 text-white overflow-hidden hover:-translate-y-0.5 transition-all duration-300"
        >
          <!-- Background pattern -->
          <div class="absolute inset-0 opacity-10">
            <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
              <defs>
                <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
                  <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#grid)" />
            </svg>
          </div>

          <div class="relative flex flex-col md:flex-row md:items-center gap-6">
            <div class="flex-shrink-0">
              <div class="w-20 h-20 bg-forest-600 rounded-2xl flex items-center justify-center">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
            </div>

            <div class="flex-1">
              <h2 class="font-serif text-2xl md:text-3xl font-semibold mb-2 group-hover:underline decoration-2 underline-offset-4">
                {t('clinicians.emdrTitle')}
              </h2>
              <p class="text-white/90 mb-4 max-w-xl">
                {t('clinicians.emdrDesc')}
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-forest-600 rounded-full text-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('clinicians.8phases')}
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-forest-600 rounded-full text-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('clinicians.fullScripts')}
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-forest-600 rounded-full text-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('clinicians.printReady')}
                </span>
              </div>
            </div>

            <div class="flex-shrink-0 hidden md:block">
              <div class="w-12 h-12 bg-forest-600 rounded-full flex items-center justify-center group-hover:bg-forest-500 transition-colors">
                <svg class="w-6 h-6 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        </a>

        <!-- Resource Library Card -->
        <a
          href={translatePath('/clinicians/resources')}
          class="block group mt-6 bg-sand border border-linen rounded-xl p-6 hover:shadow-md hover:border-forest-300 transition-all duration-200"
        >
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-forest-50 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-forest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold text-charcoal mb-1 group-hover:text-forest-600 transition-colors">
                {t('clinicians.resourceLibrary')}
              </h3>
              <p class="text-charcoal/70 text-sm leading-relaxed">
                {t('clinicians.resourceLibraryDesc')}
              </p>
            </div>
          </div>
        </a>

        <!-- Interactive Tools Card -->
        <a
          href={translatePath('/clinicians/emdr/tools')}
          class="block group mt-6 bg-sand border border-linen rounded-xl p-6 hover:shadow-md hover:border-forest-300 transition-all duration-200"
        >
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-forest-50 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-forest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold text-charcoal mb-1 group-hover:text-forest-600 transition-colors">
                Herramientas Interactivas
              </h3>
              <p class="text-charcoal/70 text-sm leading-relaxed">
                Herramientas EMDR integradas: estimulación bilateral (visual, audio, combinada), escalas SUD/VOC, contenedor, lugar seguro, marcapasos de respiración. Incluye modo pantalla completa para uso en sesión.
              </p>
            </div>
          </div>
        </a>
      </div>

      <!-- Coming Soon Section -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-forest-50 text-forest-600 text-sm font-medium rounded-full">
            {t('home.comingSoon')}
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- TF-CBT Card -->
          <div class="bg-sand border border-linen rounded-xl p-6 opacity-75">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-forest-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-forest-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-lg font-semibold text-forest-900 mb-2">{t('clinicians.tfcbtTitle')}</h3>
                <p class="text-forest-600 text-sm leading-relaxed mb-3">
                  {t('clinicians.tfcbtDesc')}
                </p>
                <span class="inline-block text-xs font-medium px-2 py-1 bg-forest-50 text-forest-600 rounded">
                  {t('clinicians.inDevelopment')}
                </span>
              </div>
            </div>
          </div>

          <!-- PCIT Card -->
          <div class="bg-sand border border-linen rounded-xl p-6 opacity-75">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-forest-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-forest-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-lg font-semibold text-forest-900 mb-2">{t('clinicians.pcitTitle')}</h3>
                <p class="text-forest-600 text-sm leading-relaxed mb-3">
                  {t('clinicians.pcitDesc')}
                </p>
                <span class="inline-block text-xs font-medium px-2 py-1 bg-forest-50 text-forest-600 rounded">
                  {t('clinicians.inDevelopment')}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- How to Use Section -->
      <div class="bg-sand rounded-xl border border-linen p-8 max-w-3xl">
        <h2 class="font-serif text-xl font-semibold text-forest-900 mb-4">
          {t('clinicians.howToUseTitle')}
        </h2>
        <div class="space-y-4 text-charcoal">
          <p>
            {t('clinicians.howToUseDesc')}
          </p>
          <ul class="list-disc list-inside space-y-2 text-sm">
            <li>{t('clinicians.howToUse1')}</li>
            <li>{t('clinicians.howToUse2')}</li>
            <li>{t('clinicians.howToUse3')}</li>
            <li>{t('clinicians.howToUse4')}</li>
          </ul>
          <p class="text-sm">
            {t('clinicians.howToUseNote')}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
