---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ClinicalBanner from '../../../../components/ClinicalBanner.astro';
import References from '../../../../components/References.astro';
import Callout from '../../../../components/Callout.astro';
import { useTranslations, useTranslatedPath, type Lang } from '../../../../i18n';
import type { TranslationKey } from '../../../../i18n/ui';

const lang: Lang = 'es';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const phases = [
  { num: 1, title: 'Historia y planificación del tratamiento', shortTitle: t('phase.1.short' as TranslationKey), description: 'Recopilación de la historia clínica y planificación del tratamiento' },
  { num: 2, title: 'Preparación', shortTitle: t('phase.2.short' as TranslationKey), description: 'Estabilización y desarrollo de recursos' },
  { num: 3, title: 'Evaluación', shortTitle: t('phase.3.short' as TranslationKey), description: 'Identificación del recuerdo blanco y mediciones iniciales' },
  { num: 4, title: 'Desensibilización', shortTitle: t('phase.4.short' as TranslationKey), description: 'Reprocesamiento con estimulación bilateral' },
  { num: 5, title: 'Instalación', shortTitle: t('phase.5.short' as TranslationKey), description: 'Fortalecimiento de la cognición positiva' },
  { num: 6, title: 'Exploración corporal', shortTitle: t('phase.6.short' as TranslationKey), description: 'Comprobación del malestar corporal residual' },
  { num: 7, title: 'Cierre', shortTitle: t('phase.7.short' as TranslationKey), description: 'Estabilización al finalizar la sesión' },
  { num: 8, title: 'Reevaluación', shortTitle: t('phase.8.short' as TranslationKey), description: 'Revisión del progreso del tratamiento' },
];
---

<BaseLayout lang={lang} title={t('emdr.title')} description={t('emdr.description')}>
  <section class="py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="text-sm mb-6">
        <ol class="flex items-center gap-2 text-forest-500">
          <li><a href={translatePath('/clinicians')} class="hover:text-bronze-600 transition-colors">{t('breadcrumb.clinicians')}</a></li>
          <li>/</li>
          <li class="text-forest-900">{t('breadcrumb.emdr')}</li>
        </ol>
      </nav>

    <ClinicalBanner lang={lang} />


      <!-- Header -->
      <div class="max-w-3xl mb-12">
        <h1 class="font-serif text-4xl font-semibold text-bronze-gradient mb-4">
          {t('emdr.title')}
        </h1>
        <p class="text-lg text-charcoal leading-relaxed">
          {t('emdr.description')}
        </p>
      </div>

      <!-- Jump to Phase - Quick Access -->
      <div class="mb-8 flex flex-wrap items-center gap-2">
        <span class="text-sm text-forest-500 mr-1">{t('phase.jumpTo')}</span>
        {phases.map((phase) => (
          <a
            href={translatePath(`/clinicians/emdr/phase-${phase.num}`)}
            class="w-9 h-9 flex items-center justify-center rounded-full bg-forest-50 text-charcoal text-sm font-medium hover:bg-bronze-500 hover:text-forest-900 transition-colors"
            title={`${t('phase.phase')} ${phase.num}: ${phase.shortTitle}`}
          >
            {phase.num}
          </a>
        ))}
      </div>

      <!-- Print Package Button -->
      <div class="mb-8">
        <a
          href={translatePath('/clinicians/emdr/print-package')}
          class="inline-flex items-center gap-3 px-5 py-3 bg-bronze-500 text-forest-900 rounded-lg hover:bg-bronze-400 transition-colors font-medium"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          {t('emdr.printPackage')}
          <span class="text-forest-900/70 text-sm font-normal">{t('emdr.printPackageNote')}</span>
        </a>
      </div>

      <!-- Tools Link -->
      <div class="mb-8">
        <a
          href="/es/clinicians/emdr/tools"
          class="inline-flex items-center gap-3 px-5 py-3 bg-forest-700 border border-forest-500 text-forest-100 rounded-lg hover:bg-forest-600 transition-colors font-medium"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
          </svg>
          Herramientas EMDR interactivas
          <span class="text-forest-300 text-sm font-normal">(estimulación bilateral, escalas, contención)</span>
        </a>
      </div>

      <!-- Quick Reference -->
      <Callout lang={lang} type="tip" title={t('emdr.quickRefTitle')}>
        <p class="mb-2">{t('emdr.quickRefDesc')}</p>
        <ol class="list-decimal list-inside space-y-1">
          <li>{t('emdr.quickRef1')}</li>
          <li>{t('emdr.quickRef2')}</li>
          <li>{t('emdr.quickRef3')}</li>
        </ol>
      </Callout>

      <!-- Phases Grid -->
      <div class="mt-12">
        <h2 class="font-serif text-2xl font-semibold text-forest-900 mb-6">
          {t('emdr.the8Phases')}
        </h2>

        <div class="grid md:grid-cols-2 gap-4">
          {phases.map((phase) => (
            <a
              href={translatePath(`/clinicians/emdr/phase-${phase.num}`)}
              class="flex items-start gap-4 p-4 bg-sand border border-linen rounded-lg hover:border-forest-300 hover:bg-forest-50 transition-all group"
            >
              <div class="flex-shrink-0 w-10 h-10 bg-forest-50 text-bronze-700 rounded-full flex items-center justify-center font-semibold group-hover:bg-bronze-500 group-hover:text-forest-900 transition-colors">
                {phase.num}
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-forest-900 group-hover:text-bronze-600 transition-colors">
                  {phase.title}
                </h3>
                <p class="text-sm text-forest-600 mt-1">
                  {phase.description}
                </p>
              </div>
              <svg class="w-5 h-5 text-forest-200 group-hover:text-bronze-600 group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <section class="mt-10 p-6 border border-linen rounded-lg" aria-labelledby="spanish-handouts-heading">
        <h2 id="spanish-handouts-heading" class="font-serif text-2xl text-forest-900 mb-4">Formularios y guiones en español</h2>
        <p class="text-charcoal mb-4">Abre una hoja individual o selecciona varias en el paquete de impresión.</p>
        <ul class="grid sm:grid-cols-2 gap-3 text-sm text-charcoal">
          <li><a class="underline" href="/es/clinicians/emdr/intake-form">Fase 1: formulario de evaluación inicial</a></li>
          {[2, 3, 4, 5, 6, 7, 8].map((phase) => <li><a class="underline" href={`/es/clinicians/emdr/phase-${phase}-scripts`}>Fase {phase}: guiones de {phases[phase - 1].title.toLowerCase()}</a></li>)}
          <li><a class="underline" href="/es/clinicians/emdr/phase-2-resource-safe-place">Recurso: lugar seguro o tranquilo</a></li>
          <li><a class="underline" href="/es/clinicians/emdr/phase-2-resource-container">Recurso: contenedor</a></li>
          <li><a class="underline" href="/es/clinicians/emdr/phase-2-resource-lightstream">Recurso: corriente de luz</a></li>
          <li><a class="underline" href="/es/clinicians/emdr/phase-2-resource-breathing">Recurso: respiración</a></li>
        </ul>
      </section>

      <!-- Key Concepts -->
      <div class="mt-16 grid md:grid-cols-2 gap-8">
        <div class="bg-sand rounded-lg p-6">
          <h3 class="font-serif text-lg font-semibold text-forest-900 mb-4">
            {t('emdr.coreComponents')}
          </h3>
          <ul class="space-y-3 text-sm text-charcoal">
            <li class="flex items-start gap-2">
              <span class="font-semibold text-bronze-500 w-20 flex-shrink-0">CN:</span>
              Cognición negativa: creencia irracional sobre sí mismo
            </li>
            <li class="flex items-start gap-2">
              <span class="font-semibold text-bronze-500 w-20 flex-shrink-0">CP:</span>
              Cognición positiva: creencia deseada sobre sí mismo
            </li>
            <li class="flex items-start gap-2">
              <span class="font-semibold text-bronze-500 w-20 flex-shrink-0">VOC:</span>
              Validez de la cognición: qué tan verdadera se siente la CP (1–7)
            </li>
            <li class="flex items-start gap-2">
              <span class="font-semibold text-bronze-500 w-20 flex-shrink-0">SUD:</span>
              Unidades subjetivas de perturbación (0–10)
            </li>
            <li class="flex items-start gap-2">
              <span class="font-semibold text-bronze-500 w-20 flex-shrink-0">EB:</span>
              Estimulación bilateral: movimientos oculares, golpecitos o tonos
            </li>
          </ul>
        </div>

        <div class="bg-sand rounded-lg p-6">
          <h3 class="font-serif text-lg font-semibold text-forest-900 mb-4">
            {t('emdr.sessionFlow')}
          </h3>
          <ol class="space-y-2 text-sm text-charcoal list-decimal list-inside">
            <li>Abrir con la reevaluación (fase 8)</li>
            <li>Continuar con el blanco anterior o seleccionar uno nuevo</li>
            <li>Evaluar si el blanco es nuevo (fase 3)</li>
            <li>Desensibilizar hasta SUD = 0 o un nivel ecológico (fase 4)</li>
            <li>Instalar hasta VOC = 7 o un nivel ecológico (fase 5)</li>
            <li>Explorar el cuerpo hasta resolver el malestar residual (fase 6)</li>
            <li>Realizar el cierre (fase 7)</li>
          </ol>
        </div>
      </div>

      <!-- Resources -->
      <div class="mt-12 p-6 border border-linen rounded-lg">
        <h3 class="font-serif text-lg font-semibold text-forest-900 mb-3">
          {t('emdr.trainingResources')}
        </h3>
        <p class="text-sm text-charcoal mb-4">
          {t('emdr.trainingNote')}
        </p>
        <ul class="text-sm text-forest-600 space-y-1">
          <li>
            <span class="text-bronze-500">EMDRIA:</span> Asociación Internacional de EMDR — emdria.org (sitio externo en inglés)
          </li>
          <li>
            <span class="text-bronze-500">EMDR Institute:</span> Fundado por Francine Shapiro — emdr.com (sitio externo en inglés)
          </li>
        </ul>
      </div>
    </div>
    <References lang={lang} />
  </section>
</BaseLayout>
