---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolShell from '../../../components/tools/ToolShell.astro';
import { widgetFor } from '../../../lib/tool-widgets';
import type { Lang } from '../../../i18n';
import { useTranslations } from '../../../i18n';

const lang: Lang = 'es';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const tools = await getCollection('tools', (t) => t.data.locale === 'es');
  return tools.map((tool) => ({
    params: { slug: tool.slug.replace(/es$/, '') },
    props: { tool },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { Content } = await tool.render();

const Widget = widgetFor(tool.data.componentName);
---

<BaseLayout title={tool.data.name} description={tool.data.shortDescription} noAnalytics={true} lang={lang}>
  <ToolShell tool={tool} lang={lang}>
    {Widget ? <Widget lang={lang} warnings={tool.data.warnings} /> : (
      <div class="p-6 border border-dashed border-forest-600 rounded-lg text-forest-300 text-sm">
        {t('tools.widgetNotImplemented')} <code>{tool.data.componentName}</code>.
      </div>
    )}
  </ToolShell>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 prose prose-invert">
    <Content />
  </article>
</BaseLayout>
