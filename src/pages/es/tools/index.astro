---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Herramientas EMDR Interactivas" description="Herramientas EMDR interactivas — estimulación bilateral, instalación de recursos, escalas de evaluación y ejercicios de regulación. Integradas en el sitio, gratis, sin seguimiento." lang="es">
  <section class="bg-gradient-to-br from-forest-900 via-forest-800 to-forest-900 py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl font-semibold text-bronze-gradient mb-4">
          Herramientas EMDR Interactivas
        </h1>
        <p class="text-lg text-forest-100 leading-relaxed">
          Estimulación bilateral, instalación de recursos, escalas de evaluación y ejercicios de regulación — todo integrado en el sitio. Gratis, sin cuentas, sin seguimiento. Elige el conjunto que buscas:
        </p>
      </div>
    </div>
  </section>

  <section class="dark-zone py-10 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href="/es/clinicians/emdr/tools"
          class="block group bg-forest-800 border border-forest-600 rounded-2xl p-8 hover:border-bronze-500 hover:bg-forest-700 transition-all duration-200"
        >
          <div class="w-14 h-14 bg-forest-700 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-bronze-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h2 class="font-serif text-2xl font-semibold text-forest-100 mb-2 group-hover:text-bronze-400 transition-colors">
            Para Profesionales
          </h2>
          <p class="text-forest-200 leading-relaxed mb-4">
            Herramientas de entrega de EMB (visual, audio, combinado, auto-tapping), ejercicios de preparación, escalas de evaluación y herramientas de regulación. Agrupadas por fase EMDR. Incluye modo pantalla completa para uso en sesión.
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-bronze-400 group-hover:gap-2 transition-all">
            Abrir herramientas clínicas
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <a
          href="/es/families/emdr/tools"
          class="block group bg-forest-800 border border-forest-600 rounded-2xl p-8 hover:border-bronze-500 hover:bg-forest-700 transition-all duration-200"
        >
          <div class="w-14 h-14 bg-forest-700 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-bronze-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h2 class="font-serif text-2xl font-semibold text-forest-100 mb-2 group-hover:text-bronze-400 transition-colors">
            Para Pacientes y Familias
          </h2>
          <p class="text-forest-200 leading-relaxed mb-4">
            Juegos y ejercicios para practicar en casa con tu hijo — lugar seguro, contenedor, marcapasos de respiración, enraizamiento, rueda de sentimientos, abrazo de mariposa. Un apoyo, no un reemplazo de la terapia.
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-bronze-400 group-hover:gap-2 transition-all">
            Abrir herramientas para familias
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
