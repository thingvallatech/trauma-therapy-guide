---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalmFrontDoor from '../../components/CalmFrontDoor.astro';
import { useTranslations, type Lang } from '../../i18n';

const lang: Lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('nav.home')}
  description={t('home.lede')}
>
  <CalmFrontDoor lang={lang} />
</BaseLayout>
