---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, useTranslatedPath, type Lang } from '../../../i18n';

const lang: Lang = 'es';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={t('families.tfcbtTitle')} description={t('families.tfcbtDesc')} lang={lang}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <ol class="flex items-center gap-2 text-forest-500">
        <li><a href={translatePath('/families')} class="hover:text-bronze-600 transition-colors">{t('breadcrumb.families')}</a></li>
        <li>/</li>
        <li class="text-forest-900">TF-CBT</li>
      </ol>
    </nav>

    <!-- Header with visual emphasis -->
    <header class="mb-10">
      <div class="flex items-start gap-4">
        <div class="w-16 h-16 bg-bronze-500 rounded-2xl flex items-center justify-center text-white flex-shrink-0">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <div>
          <p class="text-bronze-500 font-medium text-sm uppercase tracking-wide">Para entender el tratamiento de tu hijo/a</p>
          <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-bronze-gradient">
            {t('families.tfcbtTitle')}
          </h1>
        </div>
      </div>
    </header>

    <!-- Key points as horizontal pills -->
    <div class="flex flex-wrap gap-2 mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-600 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t('families.evidenceBased')}
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-600 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Los padres son parte del equipo
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-600 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Desarrolla habilidades de afrontamiento
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-600 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Enfoque estructurado
      </span>
    </div>

    <!-- Two column layout for main content -->
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Left column: Main content cards -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Understanding TF-CBT Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Para entender TF-CBT
            </h2>
          </div>
          <div class="p-5 space-y-4">
            <p class="text-charcoal leading-relaxed">
              TF-CBT son las siglas en inglés de <strong>Terapia Cognitivo-Conductual Centrada en el Trauma</strong>. Es una terapia estructurada diseñada especialmente para niños y adolescentes que han vivido un trauma.
            </p>
            <p class="text-charcoal leading-relaxed">
              A diferencia de algunas terapias en las que solo asiste el niño, TF-CBT te incluye a ti <strong>como aliado en la sanación de tu hijo/a</strong>. Aprenderás las mismas habilidades que tu hijo/a está aprendiendo, para poder apoyarlo en casa.
            </p>
            <p class="text-charcoal leading-relaxed">
              La terapia ayuda a los niños a entender lo que sienten sobre lo que pasó, a desarrollar habilidades sanas de afrontamiento y a procesar su trauma de manera segura y gradual.
            </p>
            <div class="p-4 bg-forest-50 border-l-4 border-forest-200 rounded-r-lg">
              <p class="text-sm font-medium text-forest-900 mb-1">Sólido respaldo científico</p>
              <p class="text-sm text-charcoal">TF-CBT se ha estudiado ampliamente y es uno de los tratamientos más eficaces para el trauma infantil y el TEPT. Funciona para muchos tipos de trauma.</p>
            </div>
          </div>
        </div>

        <!-- The PRACTICE Model Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-bronze-600 to-bronze-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
              El modelo PRACTICE
            </h2>
          </div>
          <div class="p-5">
            <p class="text-charcoal mb-6">
              TF-CBT sigue un enfoque estructurado llamado <strong>PRACTICE</strong> (por sus siglas en inglés). Cada letra representa un componente del tratamiento. El terapeuta de tu hijo/a te explicará cada parte en detalle a lo largo del proceso.
            </p>

            <div class="space-y-4">
              <div class="bg-forest-50/50 rounded-lg p-4 border-l-4 border-forest-200">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-forest-500 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">P</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Psicoeducación</h3>
                    <p class="text-sm text-forest-600 mt-1">Aprender sobre el trauma y cómo afecta al cerebro y al cuerpo. Tanto tú como tu hijo/a reciben esta información.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-forest-200">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-bronze-500 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">R</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Relajación</h3>
                    <p class="text-sm text-forest-600 mt-1">Aprender técnicas para calmarse, como ejercicios de respiración y relajación muscular, para manejar el estrés y la ansiedad.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-bronze-500">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-forest-400 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">A</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Modulación afectiva</h3>
                    <p class="text-sm text-forest-600 mt-1">Identificar y manejar las emociones intensas. Construir un vocabulario para las emociones y aprender formas sanas de expresarlas.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-bronze-400">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-bronze-400 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">C</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Afrontamiento cognitivo</h3>
                    <p class="text-sm text-forest-600 mt-1">Entender cómo se conectan los pensamientos, los sentimientos y las conductas. Aprender a notar patrones de pensamiento poco útiles.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50/50 rounded-lg p-4 border-l-4 border-forest-200">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-forest-500 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">T</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Narrativa del trauma</h3>
                    <p class="text-sm text-forest-600 mt-1">Contar poco a poco su historia del trauma de forma segura y acompañada. Esto ocurre solo cuando tu hijo/a está listo/a y cuenta con las habilidades de afrontamiento que necesita.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50/50 rounded-lg p-4 border-l-4 border-forest-200">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-forest-400 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">I</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Dominio in vivo <span class="font-normal text-forest-600 text-sm">(práctica en la vida real)</span></h3>
                    <p class="text-sm text-forest-600 mt-1">Enfrentar los recordatorios del trauma en la vida real, paso a paso. Se usa cuando la evitación interfiere con las actividades de todos los días.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-bronze-500">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-bronze-500 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">C</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Sesiones conjuntas</h3>
                    <p class="text-sm text-forest-600 mt-1">Padres e hijo/a se reúnen para compartir la narrativa del trauma y fortalecer su vínculo. Es una experiencia de sanación muy poderosa para las familias.</p>
                  </div>
                </div>
              </div>

              <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-forest-200">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 bg-forest-500 text-white rounded-lg flex items-center justify-center font-bold text-sm flex-shrink-0">E</span>
                  <div>
                    <h3 class="font-semibold text-forest-900">Fortalecer la seguridad</h3>
                    <p class="text-sm text-forest-600 mt-1">Desarrollar habilidades de seguridad y planificar para el futuro. Ayudar a tu hijo/a a sentirse preparado/a y con confianza de aquí en adelante.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column: Sticky Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-24 space-y-6">
          <!-- How to Support Your Child -->
          <div class="bg-sand rounded-xl border border-linen overflow-hidden">
            <div class="bg-bronze-500 px-4 py-3">
              <h2 class="text-white font-semibold text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                How to Support Your Child
              </h2>
            </div>
            <div class="p-4 space-y-4">
              <div>
                <h3 class="text-xs font-semibold text-forest-500 uppercase tracking-wide mb-2">During Treatment</h3>
                <ul class="space-y-1.5 text-sm text-charcoal">
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Attend your parent sessions
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Practice skills together at home
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Praise their effort and courage
                  </li>
                </ul>
              </div>

              <div>
                <h3 class="text-xs font-semibold text-forest-500 uppercase tracking-wide mb-2">When They Share</h3>
                <ul class="space-y-1.5 text-sm text-charcoal">
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Listen calmly without interrupting
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Validate their feelings
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Thank them for trusting you
                  </li>
                </ul>
              </div>

              <div>
                <h3 class="text-xs font-semibold text-forest-500 uppercase tracking-wide mb-2">At Home</h3>
                <ul class="space-y-1.5 text-sm text-charcoal">
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Keep consistent routines
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Use relaxation techniques together
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-600 mt-0.5">&bull;</span>
                    Be patient — progress isn't linear
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- For Caregivers Note -->
          <div class="bg-gradient-to-br from-forest-50 to-forest-50/50 rounded-xl border border-forest-200 overflow-hidden">
            <div class="px-4 py-3 border-b border-forest-200">
              <h2 class="font-semibold text-forest-900 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                For Caregivers
              </h2>
            </div>
            <div class="p-4">
              <p class="text-sm text-charcoal leading-relaxed">
                Hearing about your child's trauma can bring up difficult feelings of your own. This is normal. Talk to the therapist about getting support for yourself — taking care of you helps you take care of them.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Back Link -->
    <div class="mt-12 pt-8 border-t border-linen">
      <a href={translatePath('/families')} class="text-bronze-700 hover:text-bronze-600 transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        {t('families.backToFamilies')}
      </a>
    </div>
  </div>
</BaseLayout>
