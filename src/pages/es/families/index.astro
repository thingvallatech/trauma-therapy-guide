---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, useTranslatedPath, type Lang } from '../../../i18n';

const lang: Lang = 'es';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout lang={lang} title={t('families.title')} description={t('families.subtitle')}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-forest-900 via-forest-800 to-forest-900 py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl font-semibold text-bronze-gradient mb-4">
          {t('families.title')}
        </h1>
        <p class="text-lg text-forest-100 leading-relaxed">
          {t('families.subtitle')}
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Available Now - Featured Section -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-bronze-500 text-forest-900 text-sm font-medium rounded-full">
            <span class="w-2 h-2 bg-forest-900 rounded-full animate-pulse"></span>
            {t('home.availableNow')}
          </span>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- EMDR Card -->
          <a
            href={translatePath('/families/emdr')}
            class="block group relative bg-forest-700 border border-bronze-500 rounded-2xl p-6 text-white overflow-hidden transition-all duration-300 hover:-translate-y-1"
          >
            <!-- Background pattern -->
            <div class="absolute inset-0 opacity-10">
              <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <defs>
                  <pattern id="grid-emdr" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#grid-emdr)" />
              </svg>
            </div>

            <div class="relative">
              <div class="w-14 h-14 bg-forest-600 rounded-xl flex items-center justify-center mb-4">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>

              <h2 class="font-serif text-xl font-semibold mb-2 group-hover:underline decoration-2 underline-offset-4">
                {t('families.emdrTitle')}
              </h2>
              <p class="text-forest-200 text-sm mb-4">
                {t('families.emdrDesc')}
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-forest-600 rounded-full text-xs">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('families.evidenceBased')}
                </span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-forest-600 rounded-full text-xs">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('families.childPaced')}
                </span>
              </div>
              <div class="mt-4 flex items-center gap-1 text-sm font-medium text-bronze-400 group-hover:gap-2 transition-all">
                {t('families.learnMore')}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>

          <!-- TF-CBT Card -->
          <a
            href={translatePath('/families/tfcbt')}
            class="block group relative bg-forest-700 border border-bronze-500 rounded-2xl p-6 text-white overflow-hidden transition-all duration-300 hover:-translate-y-1"
          >
            <!-- Background pattern -->
            <div class="absolute inset-0 opacity-10">
              <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <defs>
                  <pattern id="grid-tfcbt" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#grid-tfcbt)" />
              </svg>
            </div>

            <div class="relative">
              <div class="w-14 h-14 bg-forest-600 rounded-xl flex items-center justify-center mb-4">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>

              <h2 class="font-serif text-xl font-semibold mb-2 group-hover:underline decoration-2 underline-offset-4">
                {t('families.tfcbtTitle')}
              </h2>
              <p class="text-forest-200 text-sm mb-4">
                {t('families.tfcbtDesc')}
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-forest-600 rounded-full text-xs">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('families.evidenceBased')}
                </span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-forest-600 rounded-full text-xs">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t('families.parentsInvolved')}
                </span>
              </div>
              <div class="mt-4 flex items-center gap-1 text-sm font-medium text-bronze-400 group-hover:gap-2 transition-all">
                {t('families.learnMore')}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Recommended Reading Card -->
          <a
            href={translatePath('/families/resources')}
            class="block group relative bg-gradient-to-br from-wood-400 to-wood-500 rounded-2xl p-6 text-white overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div class="absolute inset-0 opacity-10">
              <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <defs>
                  <pattern id="grid-resources" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#grid-resources)" />
              </svg>
            </div>

            <div class="relative">
              <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm mb-4">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>

              <h2 class="font-serif text-xl font-semibold mb-2 group-hover:underline decoration-2 underline-offset-4">
                {t('families.readingTitle')}
              </h2>
              <p class="text-white/85 text-sm mb-4">
                {t('families.readingDesc')}
              </p>
              <div class="mt-4 flex items-center gap-1 text-sm font-medium text-white/90 group-hover:gap-2 transition-all">
                {t('families.browseResources')}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>

        </div>
      </div>

      <!-- Coming Soon Section -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-forest-50 text-forest-600 text-sm font-medium rounded-full">
            {t('home.comingSoon')}
          </span>
        </div>

        <div class="grid md:grid-cols-1 gap-6 max-w-md">
          <!-- PCIT Card -->
          <div class="bg-sand border border-linen rounded-xl p-6 opacity-75">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-forest-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-forest-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-lg font-semibold text-forest-900 mb-2">{t('families.pcitTitle')}</h3>
                <p class="text-forest-600 text-sm leading-relaxed mb-3">
                  {t('families.pcitDesc')}
                </p>
                <span class="inline-block text-xs font-medium px-2 py-1 bg-forest-50 text-forest-600 rounded">
                  {t('clinicians.inDevelopment')}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- How You Can Help Section -->
      <div class="bg-sand rounded-xl border border-linen p-8 max-w-3xl">
        <h2 class="font-serif text-xl font-semibold text-forest-900 mb-4">
          {t('families.howToHelpTitle')}
        </h2>
        <div class="space-y-4 text-charcoal">
          <p>
            {t('families.howToHelpDesc')}
          </p>
          <ul class="list-disc list-inside space-y-2 text-sm">
            <li>{t('families.howToHelp1')}</li>
            <li>{t('families.howToHelp2')}</li>
            <li>{t('families.howToHelp3')}</li>
            <li>{t('families.howToHelp4')}</li>
            <li>{t('families.howToHelp5')}</li>
          </ul>
          <p class="text-sm">
            {t('families.howToHelpNote')}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
