---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslatedPath, type Lang } from '../../../i18n';

const lang: Lang = 'es';
const translatePath = useTranslatedPath(lang);
---

<BaseLayout lang={lang} title="Para pacientes y familias" description="Entender la terapia de trauma — una guía para pacientes, padres y cuidadores que navegan un tratamiento basado en evidencia.">
  <div class="fam-hub">
    <header class="fam-hero">
      <p class="fam-kicker">Para pacientes y familias</p>
      <h1 class="fam-h1">Entiende lo que está <em>pasando</em>.</h1>
      <p class="fam-lede">
        Ya sea que estés en terapia de trauma o acompañando a alguien que lo está, estas guías explican qué sucede en el tratamiento sin jerga abrumadora.
      </p>
    </header>

    <section class="fam-row" aria-label="Terapias">
      <a href={translatePath('/families/emdr')} class="fam-card">
        <div class="who">EMDR</div>
        <div class="what">¿Qué es la terapia EMDR?</div>
        <p>Cómo funciona, qué esperar sesión a sesión y cómo apoyar a tu hijo entre sesiones.</p>
        <span class="fam-cta">Leer la guía →</span>
      </a>

      <a href={translatePath('/families/tfcbt')} class="fam-card">
        <div class="who">TF-CBT</div>
        <div class="what">¿Qué es la TF-CBT?</div>
        <p>La TCC Enfocada en el Trauma ayuda a los niños a procesar el trauma con la participación de los padres. El modelo PRACTICE, explicado.</p>
        <span class="fam-cta">Leer la guía →</span>
      </a>
    </section>

    <section class="fam-row-2" aria-label="Más para familias">
      <a href={translatePath('/families/resources')} class="fam-mini">
        <h3>Lectura recomendada</h3>
        <p>Libros y recursos para ayudarte a entender el trauma y apoyar la sanación de tu hijo.</p>
      </a>
      <a href={translatePath('/families/emdr/tools')} class="fam-mini">
        <h3>Juegos y herramientas para calmar</h3>
        <p>Lugar seguro, contenedor, respiración, enraizamiento — ejercicios suaves para practicar en casa con tu hijo.</p>
      </a>
    </section>

    <section class="fam-help" aria-labelledby="help-h">
      <h2 id="help-h" class="fam-h2">Cómo puedes ayudar</h2>
      <p>
        Es natural tener preguntas e inquietudes sobre la terapia de tu hijo. Aprender sobre el tratamiento puede ayudarte a sentirte con más confianza y mejor preparado para apoyarlo.
      </p>
      <ul>
        <li>Ten paciencia — la sanación toma tiempo y no siempre es lineal.</li>
        <li>Mantén la comunicación abierta sin presionar.</li>
        <li>Conserva las rutinas y la estabilidad en casa.</li>
        <li>Pregunta al terapeuta cómo apoyar habilidades específicas en casa.</li>
        <li>Cuídate tú también — tu bienestar importa.</li>
      </ul>
      <p class="fam-small">Las guías de este sitio están escritas en lenguaje claro por terapeutas de trauma que trabajan con familias todos los días.</p>
    </section>

    <section class="fam-coming" aria-label="En desarrollo">
      <h2 class="fam-h2">En desarrollo</h2>
      <ol>
        <li>
          <div class="code">PCIT</div>
          <div class="name">Terapia de Interacción Padres-Hijos<small>Fortalece el vínculo entre padres e hijos y enseña habilidades efectivas de crianza.</small></div>
          <div class="stat">Planificado</div>
        </li>
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .fam-hub {
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    max-width: 980px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    line-height: 1.6;
  }

  .fam-hero { margin-bottom: 36px; max-width: 60ch; }
  .fam-kicker {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin: 0 0 14px;
  }
  .fam-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    max-width: 18ch;
  }
  .fam-h1 em { font-style: italic; color: var(--color-copper); }
  .fam-lede { font-size: 17px; color: var(--color-ink-2); margin: 0; }

  .fam-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 28px 0;
  }
  .fam-card {
    display: block;
    padding: 22px 22px 24px;
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  .fam-card:hover {
    border-color: var(--color-copper);
    box-shadow: 0 6px 20px rgba(20, 20, 10, 0.06);
  }
  .fam-card .who {
    font: 600 10.5px/1 var(--font-mono);
    color: var(--color-copper);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .fam-card .what {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .fam-card p {
    margin: 0 0 14px;
    font-size: 13.5px;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .fam-cta {
    font: 500 13px/1 var(--font-mono);
    color: var(--color-copper);
    letter-spacing: 0.04em;
  }

  .fam-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 12px 0 36px;
  }
  .fam-mini {
    display: block;
    padding: 16px 18px;
    background: var(--color-paper-2);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .fam-mini:hover { background: var(--color-card); }
  .fam-mini h3 {
    font-family: var(--font-display);
    font-size: 16.5px;
    font-weight: 500;
    margin: 0 0 4px;
    color: var(--color-ink);
  }
  .fam-mini p {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .fam-h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    color: var(--color-ink);
  }

  .fam-help {
    background: var(--color-paper-2);
    border: 1px solid var(--color-line, #e5e1d6);
    border-radius: 14px;
    padding: 24px 26px 26px;
    margin: 40px 0;
  }
  .fam-help p { color: var(--color-ink-2); font-size: 15px; margin: 0 0 12px; }
  .fam-help ul {
    margin: 0 0 12px;
    padding-left: 22px;
    color: var(--color-ink-2);
    font-size: 15px;
  }
  .fam-help ul li { margin: 4px 0; }
  .fam-small { color: var(--color-muted); font-size: 13.5px; margin: 0 !important; }

  .fam-coming { margin: 40px 0 0; }
  .fam-coming ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fam-coming li {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--color-line, #e5e1d6);
    align-items: center;
  }
  .fam-coming li:last-child { border-bottom: 1px solid var(--color-line, #e5e1d6); }
  .fam-coming .code {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--color-muted);
  }
  .fam-coming .name { font-size: 14.5px; color: var(--color-ink-2); }
  .fam-coming .name small {
    display: block;
    color: var(--color-muted);
    font-size: 12.5px;
    margin-top: 2px;
  }
  .fam-coming .stat {
    font: 500 11px/1 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .fam-hub { padding: 24px 16px 56px; }
    .fam-row { grid-template-columns: 1fr; }
    .fam-row-2 { grid-template-columns: 1fr; }
    .fam-coming li { grid-template-columns: 60px 1fr; gap: 12px; }
    .fam-coming .stat { grid-column: 2; }
  }
</style>
