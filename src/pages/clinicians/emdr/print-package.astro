---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClinicalBanner from '../../../components/ClinicalBanner.astro';

// Define all printable pages in order with section grouping
const printablePages = [
  { url: '/clinicians/emdr/intake-form', title: 'Intake Form', section: 'Phase 1: History & Treatment Planning', sectionNum: 1 },
  { url: '/clinicians/emdr/phase-2-scripts', title: 'Preparation Scripts', section: 'Phase 2: Preparation', sectionNum: 2 },
  { url: '/clinicians/emdr/phase-2-resource-safe-place', title: 'Safe Place Resource', section: null },
  { url: '/clinicians/emdr/phase-2-resource-container', title: 'Container Resource', section: null },
  { url: '/clinicians/emdr/phase-2-resource-lightstream', title: 'Lightstream Resource', section: null },
  { url: '/clinicians/emdr/phase-2-resource-breathing', title: 'Breathing Resource', section: null },
  { url: '/clinicians/emdr/phase-3-scripts', title: 'Assessment Scripts', section: 'Phase 3: Assessment', sectionNum: 3 },
  { url: '/clinicians/emdr/phase-4-scripts', title: 'Desensitization Scripts', section: 'Phase 4: Desensitization', sectionNum: 4 },
  { url: '/clinicians/emdr/phase-5-scripts', title: 'Installation Scripts', section: 'Phase 5: Installation', sectionNum: 5 },
  { url: '/clinicians/emdr/phase-6-scripts', title: 'Body Scan Scripts', section: 'Phase 6: Body Scan', sectionNum: 6 },
  { url: '/clinicians/emdr/phase-7-scripts', title: 'Closure Scripts', section: 'Phase 7: Closure', sectionNum: 7 },
  { url: '/clinicians/emdr/phase-8-scripts', title: 'Reevaluation Scripts', section: 'Phase 8: Reevaluation', sectionNum: 8 },
];
---

<BaseLayout title="EMDR Print Package" description="Complete EMDR protocol printable package - all phases and resources in one document.">
  <style>
    /* ========================================
       COMPREHENSIVE PRINT STYLES
       Includes all formatting from individual pages
       ======================================== */

    /* Base script box styling */
    .script-box {
      border-left: 3px solid #2D5A3D;
      background: #f8faf8;
      padding: 0.75rem 1rem;
      margin: 0.5rem 0;
      font-style: italic;
    }

    /* Phase-specific script box colors */
    /* Phase 2 - Teal */
    .script-box-teen {
      border-left-color: #0d9488;
      background: #f0fdfa;
    }
    /* Phase 2 resources - child version */
    .script-box-child {
      border-left-color: #f59e0b;
      background: #fffbeb;
    }

    /* Notes lines */
    .notes-line {
      border-bottom: 1px solid #d1d5db;
      min-height: 1.2rem;
      margin-bottom: 0.3rem;
      display: block;
    }

    /* Assessment step styling */
    .assessment-step {
      padding: 0.5rem;
      margin-bottom: 0.5rem;
    }

    /* Section divider page styling */
    .section-divider {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 9.5in;
      text-align: center;
      background: linear-gradient(135deg, #f0fdf4 0%, #f8faf8 100%);
      border: 3px solid #2D5A3D;
      border-radius: 0;
    }
    .section-divider .phase-number {
      width: 120px;
      height: 120px;
      background: #2D5A3D;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      font-weight: bold;
      margin-bottom: 1.5rem;
      font-family: 'Lora', Georgia, serif;
    }
    .section-divider .phase-title {
      font-family: 'Lora', Georgia, serif;
      font-size: 2rem;
      font-weight: 600;
      color: #2C2C2C;
      margin-bottom: 0.5rem;
    }
    .section-divider .phase-subtitle {
      font-size: 1rem;
      color: #2C2C2C;
      opacity: 0.7;
    }
    .section-divider .emdr-badge {
      margin-top: 2rem;
      padding: 0.5rem 1.5rem;
      background: #2D5A3D;
      color: white;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border-radius: 9999px;
    }

    @media print {
      @page {
        size: letter;
        margin: 0.4in;
      }
      .no-print { display: none !important; }
      body {
        background: white !important;
        font-size: 10pt !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      #print-content {
        padding: 0 !important;
        max-width: 100% !important;
      }
      .print-page {
        page-break-after: always;
        break-after: page;
        min-height: 9.5in;
        padding: 0 !important;
        margin: 0 !important;
      }
      .print-page:last-child {
        page-break-after: avoid;
        break-after: avoid;
      }
      .print-container {
        max-width: 100% !important;
        padding: 0 !important;
      }

      /* Tighten print spacing to prevent overflow */
      .mb-6 { margin-bottom: 0.75rem !important; }
      .mb-5 { margin-bottom: 0.6rem !important; }
      .mb-4 { margin-bottom: 0.5rem !important; }
      .mb-3 { margin-bottom: 0.4rem !important; }
      .p-6 { padding: 0.6rem !important; }
      .p-5 { padding: 0.55rem !important; }
      .p-4 { padding: 0.5rem !important; }
      .p-3 { padding: 0.4rem !important; }
      .p-2 { padding: 0.3rem !important; }
      .gap-6 { gap: 0.6rem !important; }
      .gap-5 { gap: 0.55rem !important; }
      .gap-4 { gap: 0.5rem !important; }
      .gap-3 { gap: 0.4rem !important; }
      .py-8, .py-6 { padding-top: 0 !important; padding-bottom: 0 !important; }
      header { margin-bottom: 0.5rem !important; padding-bottom: 0.3rem !important; }
      h2 { margin-bottom: 0.3rem !important; }
      section { margin-bottom: 0.5rem !important; }

      /* Script box print optimization */
      .script-box {
        padding: 0.4rem 0.6rem !important;
        margin: 0.25rem 0 !important;
      }
      .assessment-step {
        padding: 0.4rem !important;
        margin-bottom: 0.4rem !important;
      }
      .notes-line {
        border-bottom: 1px solid #d1d5db;
        min-height: 1.2rem;
        margin-bottom: 0.3rem;
      }

      /* Section divider print styles */
      .section-divider {
        page-break-after: always;
        break-after: page;
        min-height: 9.5in;
        padding: 0 !important;
        margin: 0 !important;
        background: linear-gradient(135deg, #f0fdf4 0%, #f8faf8 100%) !important;
        border: 3px solid #2D5A3D !important;
      }
    }

    /* ========================================
       LOADING STATE STYLES (screen only)
       ======================================== */

    #loading-state {
      min-height: 50vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .loading-spinner {
      width: 48px;
      height: 48px;
      border: 4px solid #1D3A27;
      border-top-color: #B08D57;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .progress-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.25rem 0;
      font-size: 0.875rem;
      color: #679B73;
    }

    .progress-item.loaded {
      color: #B08D57;
    }

    .progress-item.loading {
      color: #679B73;
    }

    .progress-item.error {
      color: #dc2626;
    }

    .check-icon, .loading-icon, .error-icon {
      width: 1rem;
      height: 1rem;
    }

    .loading-icon {
      animation: spin 1s linear infinite;
    }

    /* Practice header - hidden on screen, visible in print */
    .practice-header {
      display: none;
    }

    @media print {
      .practice-header {
        display: block;
        text-align: right;
        font-size: 9pt;
        font-style: italic;
        color: #679B73;
        margin-bottom: 4pt;
      }
      .practice-header:empty {
        display: none;
      }
    }
  </style>

    <ClinicalBanner />

  <!-- Print header bar -->
  <div class="no-print bg-forest-800 text-white py-3 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/clinicians/emdr" class="text-white/80 hover:text-white transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to EMDR
        </a>
        <span class="text-white/40">|</span>
        <span class="text-sm">Complete EMDR Print Package</span>
      </div>
      <button
        id="print-btn"
        disabled
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-2 bg-bronze-500 text-forest-900 rounded-lg hover:bg-bronze-400 transition-colors text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span id="print-btn-text">Loading...</span>
      </button>
    </div>
  </div>

  <!-- Practice Name Customization -->
  <div class="no-print max-w-4xl mx-auto px-4 pt-4">
    <div class="flex items-center gap-3 p-3 bg-forest-800 border border-forest-600 rounded-lg">
      <label for="practice-name" class="text-sm text-forest-300 flex-shrink-0">Practice Name:</label>
      <input
        type="text"
        id="practice-name"
        placeholder="Enter your practice name (appears on printed pages)"
        class="flex-1 px-3 py-1.5 bg-forest-700 border border-forest-600 rounded text-sm text-forest-100 placeholder:text-forest-500 focus:outline-none focus:ring-2 focus:ring-bronze-500"
      />
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Loading state -->
    <div id="loading-state" class="no-print">
      <div class="loading-spinner mb-4"></div>
      <h2 class="font-serif text-xl font-semibold text-forest-100 mb-2">Preparing Print Package</h2>
      <p class="text-forest-400 mb-6">Loading all EMDR protocol pages...</p>

      <div id="progress-list" class="w-full max-w-md">
        {printablePages.map((page, index) => (
          <div class="progress-item" data-index={index}>
            <svg class="check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <svg class="loading-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <svg class="error-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="w-4 h-4 rounded-full border border-current flex-shrink-0 pending-dot"></span>
            <span>{page.title}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Print content container -->
    <div id="print-content"></div>
  </div>

  <script define:vars={{ printablePages }}>
    async function loadPrintPackage() {
      const printContent = document.getElementById('print-content');
      const loadingState = document.getElementById('loading-state');
      const printBtn = document.getElementById('print-btn');
      const printBtnText = document.getElementById('print-btn-text');
      const progressItems = document.querySelectorAll('.progress-item');

      let loadedCount = 0;
      let errorCount = 0;

      function updateProgress(index, status) {
        const item = progressItems[index];
        const checkIcon = item.querySelector('.check-icon');
        const loadingIcon = item.querySelector('.loading-icon');
        const errorIcon = item.querySelector('.error-icon');
        const pendingDot = item.querySelector('.pending-dot');

        // Hide all icons first
        checkIcon.classList.add('hidden');
        loadingIcon.classList.add('hidden');
        errorIcon.classList.add('hidden');
        pendingDot.classList.add('hidden');

        item.classList.remove('loaded', 'loading', 'error');

        if (status === 'loading') {
          loadingIcon.classList.remove('hidden');
          item.classList.add('loading');
        } else if (status === 'loaded') {
          checkIcon.classList.remove('hidden');
          item.classList.add('loaded');
        } else if (status === 'error') {
          errorIcon.classList.remove('hidden');
          item.classList.add('error');
        } else {
          pendingDot.classList.remove('hidden');
        }
      }

      for (let i = 0; i < printablePages.length; i++) {
        const page = printablePages[i];
        updateProgress(i, 'loading');

        try {
          // Insert section divider if this page starts a new section
          if (page.section) {
            const divider = document.createElement('div');
            divider.className = 'section-divider print-page';
            divider.innerHTML = `
              <div class="phase-number">${page.sectionNum}</div>
              <div class="phase-title">${page.section}</div>
              <div class="phase-subtitle">EMDR Protocol Reference</div>
              <div class="emdr-badge">Clinical Scripts & Resources</div>
            `;
            printContent.appendChild(divider);
          }

          const response = await fetch(page.url);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          const html = await response.text();

          // Parse HTML and extract print-page elements
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const printPages = doc.querySelectorAll('.print-page');

          // Append each print-page to our content
          printPages.forEach(printPage => {
            // Clone and import the node
            const clonedPage = printPage.cloneNode(true);
            printContent.appendChild(clonedPage);
          });

          // Grab styles from each page that might contain unique styling
          const styles = doc.querySelectorAll('style');
          styles.forEach(style => {
            const content = style.textContent;
            // Only grab styles with relevant selectors we don't already have
            if (content.includes('border-left-color') ||
                content.includes('script-box') ||
                content.includes('tracking-box') ||
                content.includes('cognition-')) {
              // Check if we already have similar styles
              const existingStyles = document.querySelectorAll('style[data-source]');
              let isDuplicate = false;
              existingStyles.forEach(existing => {
                if (existing.textContent === content) isDuplicate = true;
              });
              if (!isDuplicate) {
                const clonedStyle = style.cloneNode(true);
                clonedStyle.setAttribute('data-source', page.url);
                document.head.appendChild(clonedStyle);
              }
            }
          });

          loadedCount++;
          updateProgress(i, 'loaded');

        } catch (error) {
          console.error(`Failed to load ${page.url}:`, error);
          errorCount++;
          updateProgress(i, 'error');
        }
      }

      // Hide loading state and enable print button
      loadingState.style.display = 'none';
      printBtn.disabled = false;

      // Inject practice-header element at the top of each .print-page
      const allPrintPages = printContent.querySelectorAll('.print-page');
      allPrintPages.forEach(page => {
        const header = document.createElement('div');
        header.className = 'practice-header';
        page.insertBefore(header, page.firstChild);
      });

      if (errorCount > 0) {
        printBtnText.textContent = `Print Package (${loadedCount}/${printablePages.length} pages)`;
      } else {
        printBtnText.textContent = 'Print Full Package';
      }
    }

    // Update all practice headers when the input changes
    document.getElementById('practice-name').addEventListener('input', function() {
      const value = this.value.trim();
      document.querySelectorAll('.practice-header').forEach(header => {
        header.textContent = value;
      });
    });

    // Start loading when page is ready
    document.addEventListener('DOMContentLoaded', loadPrintPackage);
  </script>
    <!-- Print Disclaimer -->
    <div class="mt-8 pt-4 border-t border-gray-300 text-xs text-gray-500">
      <p><strong>Disclaimer:</strong> This material is compiled from published clinical protocols and peer-reviewed sources. It is intended as a reference for trained clinicians only and does not replace formal EMDR training, supervision, or clinical judgment. Not for distribution to clients. Sources: Shapiro (2018), EMDRIA Guidelines, WHO (2013), APA (2017).</p>
    </div>
</BaseLayout>
