---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Define all printable pages in order
const printablePages = [
  { url: '/clinicians/emdr/intake-form', title: 'Intake Form' },
  { url: '/clinicians/emdr/phase-2-scripts', title: 'Phase 2: Preparation Scripts' },
  { url: '/clinicians/emdr/phase-2-resource-safe-place', title: 'Phase 2: Safe Place Resource' },
  { url: '/clinicians/emdr/phase-2-resource-container', title: 'Phase 2: Container Resource' },
  { url: '/clinicians/emdr/phase-2-resource-lightstream', title: 'Phase 2: Lightstream Resource' },
  { url: '/clinicians/emdr/phase-2-resource-breathing', title: 'Phase 2: Breathing Resource' },
  { url: '/clinicians/emdr/phase-3-scripts', title: 'Phase 3: Assessment Scripts' },
  { url: '/clinicians/emdr/phase-4-scripts', title: 'Phase 4: Desensitization Scripts' },
  { url: '/clinicians/emdr/phase-5-scripts', title: 'Phase 5: Installation Scripts' },
  { url: '/clinicians/emdr/phase-6-scripts', title: 'Phase 6: Body Scan Scripts' },
  { url: '/clinicians/emdr/phase-7-scripts', title: 'Phase 7: Closure Scripts' },
  { url: '/clinicians/emdr/phase-8-scripts', title: 'Phase 8: Reevaluation Scripts' },
];
---

<BaseLayout title="EMDR Print Package" description="Complete EMDR protocol printable package - all phases and resources in one document.">
  <style>
    @media print {
      @page {
        size: letter;
        margin: 0.4in;
      }
      .no-print { display: none !important; }
      body {
        background: white !important;
        font-size: 10pt !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      #print-content {
        padding: 0 !important;
      }
      .print-page {
        page-break-after: always;
        break-after: page;
      }
      .print-page:last-child {
        page-break-after: avoid;
        break-after: avoid;
      }
    }

    #loading-state {
      min-height: 50vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .loading-spinner {
      width: 48px;
      height: 48px;
      border: 4px solid #e5e7eb;
      border-top-color: #2D5A3D;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .progress-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.25rem 0;
      font-size: 0.875rem;
      color: #6b7280;
    }

    .progress-item.loaded {
      color: #2D5A3D;
    }

    .progress-item.loading {
      color: #0d9488;
    }

    .progress-item.error {
      color: #dc2626;
    }

    .check-icon, .loading-icon, .error-icon {
      width: 1rem;
      height: 1rem;
    }

    .loading-icon {
      animation: spin 1s linear infinite;
    }
  </style>

  <!-- Print header bar -->
  <div class="no-print bg-forest-600 text-white py-3 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/clinicians/emdr" class="text-white/80 hover:text-white transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to EMDR
        </a>
        <span class="text-white/40">|</span>
        <span class="text-sm">Complete EMDR Print Package</span>
      </div>
      <button
        id="print-btn"
        disabled
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-2 bg-white text-forest-700 rounded-lg hover:bg-forest-50 transition-colors text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span id="print-btn-text">Loading...</span>
      </button>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Loading state -->
    <div id="loading-state" class="no-print">
      <div class="loading-spinner mb-4"></div>
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-2">Preparing Print Package</h2>
      <p class="text-charcoal/60 mb-6">Loading all EMDR protocol pages...</p>

      <div id="progress-list" class="w-full max-w-md">
        {printablePages.map((page, index) => (
          <div class="progress-item" data-index={index}>
            <svg class="check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <svg class="loading-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <svg class="error-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="w-4 h-4 rounded-full border border-current flex-shrink-0 pending-dot"></span>
            <span>{page.title}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Print content container -->
    <div id="print-content"></div>
  </div>

  <script define:vars={{ printablePages }}>
    async function loadPrintPackage() {
      const printContent = document.getElementById('print-content');
      const loadingState = document.getElementById('loading-state');
      const printBtn = document.getElementById('print-btn');
      const printBtnText = document.getElementById('print-btn-text');
      const progressItems = document.querySelectorAll('.progress-item');

      let loadedCount = 0;
      let errorCount = 0;

      function updateProgress(index, status) {
        const item = progressItems[index];
        const checkIcon = item.querySelector('.check-icon');
        const loadingIcon = item.querySelector('.loading-icon');
        const errorIcon = item.querySelector('.error-icon');
        const pendingDot = item.querySelector('.pending-dot');

        // Hide all icons first
        checkIcon.classList.add('hidden');
        loadingIcon.classList.add('hidden');
        errorIcon.classList.add('hidden');
        pendingDot.classList.add('hidden');

        item.classList.remove('loaded', 'loading', 'error');

        if (status === 'loading') {
          loadingIcon.classList.remove('hidden');
          item.classList.add('loading');
        } else if (status === 'loaded') {
          checkIcon.classList.remove('hidden');
          item.classList.add('loaded');
        } else if (status === 'error') {
          errorIcon.classList.remove('hidden');
          item.classList.add('error');
        } else {
          pendingDot.classList.remove('hidden');
        }
      }

      for (let i = 0; i < printablePages.length; i++) {
        const page = printablePages[i];
        updateProgress(i, 'loading');

        try {
          const response = await fetch(page.url);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          const html = await response.text();

          // Parse HTML and extract print-page elements
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const printPages = doc.querySelectorAll('.print-page');

          // Append each print-page to our content
          printPages.forEach(printPage => {
            // Clone and import the node
            const clonedPage = printPage.cloneNode(true);
            printContent.appendChild(clonedPage);
          });

          // Also grab any relevant styles
          if (i === 0) {
            const styles = doc.querySelectorAll('style');
            styles.forEach(style => {
              if (style.textContent.includes('.script-box') ||
                  style.textContent.includes('.notes-line') ||
                  style.textContent.includes('print')) {
                const clonedStyle = style.cloneNode(true);
                document.head.appendChild(clonedStyle);
              }
            });
          }

          loadedCount++;
          updateProgress(i, 'loaded');

        } catch (error) {
          console.error(`Failed to load ${page.url}:`, error);
          errorCount++;
          updateProgress(i, 'error');
        }
      }

      // Hide loading state and enable print button
      loadingState.style.display = 'none';
      printBtn.disabled = false;

      if (errorCount > 0) {
        printBtnText.textContent = `Print Package (${loadedCount}/${printablePages.length} pages)`;
      } else {
        printBtnText.textContent = 'Print Full Package';
      }
    }

    // Start loading when page is ready
    document.addEventListener('DOMContentLoaded', loadPrintPackage);
  </script>
</BaseLayout>
