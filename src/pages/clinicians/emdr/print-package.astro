---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClinicalBanner from '../../../components/ClinicalBanner.astro';

// Define all printable pages in order with section grouping
const printablePages = [
  { url: '/clinicians/emdr/intake-form', title: 'Intake Form', section: 'Phase 1: History & Treatment Planning', sectionNum: 1 },
  { url: '/clinicians/emdr/phase-2-scripts', title: 'Preparation Scripts', section: 'Phase 2: Preparation', sectionNum: 2 },
  { url: '/clinicians/emdr/phase-2-resource-safe-place', title: 'Safe Place Resource', section: null },
  { url: '/clinicians/emdr/phase-2-resource-container', title: 'Container Resource', section: null },
  { url: '/clinicians/emdr/phase-2-resource-lightstream', title: 'Lightstream Resource', section: null },
  { url: '/clinicians/emdr/phase-2-resource-breathing', title: 'Breathing Resource', section: null },
  { url: '/clinicians/emdr/phase-3-scripts', title: 'Assessment Scripts', section: 'Phase 3: Assessment', sectionNum: 3 },
  { url: '/clinicians/emdr/phase-4-scripts', title: 'Desensitization Scripts', section: 'Phase 4: Desensitization', sectionNum: 4 },
  { url: '/clinicians/emdr/phase-5-scripts', title: 'Installation Scripts', section: 'Phase 5: Installation', sectionNum: 5 },
  { url: '/clinicians/emdr/phase-6-scripts', title: 'Body Scan Scripts', section: 'Phase 6: Body Scan', sectionNum: 6 },
  { url: '/clinicians/emdr/phase-7-scripts', title: 'Closure Scripts', section: 'Phase 7: Closure', sectionNum: 7 },
  { url: '/clinicians/emdr/phase-8-scripts', title: 'Reevaluation Scripts', section: 'Phase 8: Reevaluation', sectionNum: 8 },
];
---

<BaseLayout title="EMDR Print Package" description="Select EMDR intake forms, clinical scripts and preparation resources to print or save as PDF.">
  <style is:global>
    /* ========================================
       COMPREHENSIVE PRINT STYLES
       Includes all formatting from individual pages
       ======================================== */

    /* Base script box styling */
    .script-box {
      border-left: 3px solid #2D5A3D;
      background: #f8faf8;
      padding: 0.75rem 1rem;
      margin: 0.5rem 0;
      font-style: italic;
    }

    /* Phase-specific script box colors */
    /* Phase 2 - Teal */
    .script-box-teen {
      border-left-color: #0d9488;
      background: #f0fdfa;
    }
    /* Phase 2 resources - child version */
    .script-box-child {
      border-left-color: #f59e0b;
      background: #fffbeb;
    }

    /* Notes lines */
    .notes-line {
      border-bottom: 1px solid #d1d5db;
      min-height: 1.2rem;
      margin-bottom: 0.3rem;
      display: block;
    }

    /* Assessment step styling */
    .assessment-step {
      padding: 0.5rem;
      margin-bottom: 0.5rem;
    }

    /* Section divider page styling */
    .section-divider {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 9.5in;
      text-align: center;
      background: linear-gradient(135deg, #f0fdf4 0%, #f8faf8 100%);
      border: 3px solid #2D5A3D;
      border-radius: 0;
    }
    .section-divider .phase-number {
      width: 120px;
      height: 120px;
      background: #2D5A3D;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      font-weight: bold;
      margin-bottom: 1.5rem;
      font-family: 'Lora', Georgia, serif;
    }
    .section-divider .phase-title {
      font-family: 'Lora', Georgia, serif;
      font-size: 2rem;
      font-weight: 600;
      color: #2C2C2C;
      margin-bottom: 0.5rem;
    }
    .section-divider .phase-subtitle {
      font-size: 1rem;
      color: #2C2C2C;
      opacity: 0.7;
    }
    .section-divider .emdr-badge {
      margin-top: 2rem;
      padding: 0.5rem 1.5rem;
      background: #2D5A3D;
      color: white;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border-radius: 9999px;
    }

    @media print {
      @page {
        size: letter;
        margin: 0.4in;
      }
      .no-print { display: none !important; }
      body {
        background: white !important;
        font-size: 10pt !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      #print-content {
        padding: 0 !important;
        max-width: 100% !important;
      }
      .print-page {
        page-break-after: always;
        break-after: page;
        min-height: 9.5in;
        padding: 0 !important;
        margin: 0 !important;
      }
      .print-page:last-child {
        page-break-after: avoid;
        break-after: avoid;
      }
      .print-container {
        max-width: 100% !important;
        padding: 0 !important;
      }

      /* Tighten print spacing to prevent overflow */
      .mb-6 { margin-bottom: 0.75rem !important; }
      .mb-5 { margin-bottom: 0.6rem !important; }
      .mb-4 { margin-bottom: 0.5rem !important; }
      .mb-3 { margin-bottom: 0.4rem !important; }
      .p-6 { padding: 0.6rem !important; }
      .p-5 { padding: 0.55rem !important; }
      .p-4 { padding: 0.5rem !important; }
      .p-3 { padding: 0.4rem !important; }
      .p-2 { padding: 0.3rem !important; }
      .gap-6 { gap: 0.6rem !important; }
      .gap-5 { gap: 0.55rem !important; }
      .gap-4 { gap: 0.5rem !important; }
      .gap-3 { gap: 0.4rem !important; }
      .py-8, .py-6 { padding-top: 0 !important; padding-bottom: 0 !important; }
      header { margin-bottom: 0.5rem !important; padding-bottom: 0.3rem !important; }
      h2 { margin-bottom: 0.3rem !important; }
      section { margin-bottom: 0.5rem !important; }

      /* Script box print optimization */
      .script-box {
        padding: 0.4rem 0.6rem !important;
        margin: 0.25rem 0 !important;
      }
      .assessment-step {
        padding: 0.4rem !important;
        margin-bottom: 0.4rem !important;
      }
      .notes-line {
        border-bottom: 1px solid #d1d5db;
        min-height: 1.2rem;
        margin-bottom: 0.3rem;
      }

      /* Section divider print styles */
      .section-divider {
        page-break-after: always;
        break-after: page;
        min-height: 9.5in;
        padding: 0 !important;
        margin: 0 !important;
        background: linear-gradient(135deg, #f0fdf4 0%, #f8faf8 100%) !important;
        border: 3px solid #2D5A3D !important;
      }
    }

    /* ========================================
       LOADING STATE STYLES (screen only)
       ======================================== */

    #loading-state {
      min-height: 50vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .loading-spinner {
      width: 48px;
      height: 48px;
      border: 4px solid #B3CDB9;
      border-top-color: #2D5A3D;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .progress-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.25rem 0;
      font-size: 0.875rem;
      color: #679B73;
    }

    .progress-item.loaded {
      color: #2D5A3D;
    }

    .progress-item.loading {
      color: #679B73;
    }

    .progress-item.error {
      color: #dc2626;
    }

    .check-icon, .loading-icon, .error-icon {
      width: 1rem;
      height: 1rem;
    }

    .loading-icon {
      animation: spin 1s linear infinite;
    }

    /* Practice header - hidden on screen, visible in print */
    .practice-header {
      display: none;
    }

    @media print {
      .practice-header {
        display: block;
        text-align: right;
        font-size: 9pt;
        font-style: italic;
        color: #2D5A3D;
        margin-bottom: 4pt;
      }
      .practice-header:empty {
        display: none;
      }
    }
  </style>

    <ClinicalBanner />
    <fieldset class="no-print max-w-4xl mx-auto p-4 my-6 border border-forest-300 rounded-lg">
      <legend class="font-semibold px-2">Choose documents to print</legend>
      <p class="text-sm mb-3">Intake forms, phase scripts and preparation resources. This package does not include the full phase articles. Long documents span several printed pages.</p>
      <div class="grid sm:grid-cols-2 gap-2">{printablePages.map((page, index) => <label class="flex items-center gap-3 py-2"><input type="checkbox" name="print-section" value={index} checked class="w-5 h-5" />{page.title}</label>)}</div>
      <div class="flex gap-6 my-3"><button type="button" id="select-all" class="underline min-h-11">Select all</button><button type="button" id="select-none" class="underline min-h-11">Select none</button></div>
      <p id="selection-status" role="status" aria-live="polite">Loading documents…</p>
      <p class="text-sm mt-3">Choose your printer or “Save as PDF” in the print dialog. Use Letter or A4, turn off browser headers and footers if desired, and review the preview.</p>
      <noscript><p>JavaScript loads this combined package. Open individual documents from the EMDR protocol page to print without JavaScript.</p></noscript>
    </fieldset>

  <!-- Print header bar -->
  <div class="no-print bg-sand text-charcoal py-3 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 flex flex-wrap gap-3 items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/clinicians/emdr" class="text-forest-600 hover:text-forest-800 transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to EMDR
        </a>
        <span class="text-forest-300">|</span>
        <span class="text-sm text-charcoal">Complete EMDR Print Package</span>
      </div>
      <button
        id="print-btn"
        disabled
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-2 bg-forest-500 text-white rounded-lg hover:bg-forest-600 transition-colors text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span id="print-btn-text">Loading...</span>
      </button>
    </div>
  </div>

  <!-- Practice Name Customization -->
  <div class="no-print max-w-4xl mx-auto px-4 pt-4">
    <div class="flex flex-wrap items-center gap-3 p-3 bg-sand border border-linen rounded-lg">
      <label for="practice-name" class="text-sm text-forest-600 flex-shrink-0">Practice Name:</label>
      <input
        type="text"
        id="practice-name"
        style="min-width:0"
        placeholder="Enter your practice name (appears on printed pages)"
        class="flex-1 px-3 py-1.5 bg-forest-50 border border-linen rounded text-sm text-forest-900 placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-forest-500"
      />
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Loading state -->
    <div id="loading-state" class="no-print">
      <div class="loading-spinner mb-4"></div>
      <h2 class="font-serif text-xl font-semibold text-forest-900 mb-2">Preparing Print Package</h2>
      <p class="text-forest-500 mb-6">Loading all EMDR protocol pages...</p>

      <div id="progress-list" class="w-full max-w-md">
        {printablePages.map((page, index) => (
          <div class="progress-item" data-index={index}>
            <svg class="check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <svg class="loading-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <svg class="error-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="w-4 h-4 rounded-full border border-current flex-shrink-0 pending-dot"></span>
            <span>{page.title}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Print content container -->
    <div id="print-content"></div>
  </div>

  <script define:vars={{ printablePages }}>
    const printContent = document.getElementById('print-content');
    const printBtn = document.getElementById('print-btn');
    const printBtnText = document.getElementById('print-btn-text');
    const choices = [...document.querySelectorAll('input[name="print-section"]')];
    const status = document.getElementById('selection-status');
    const ready = new Set();
    const failed = new Set();
    let loading = true;
    function updateSelection() {
      choices.forEach((choice, index) => {
        const section = document.querySelector(`[data-print-section="${index}"]`);
        if (section) section.hidden = !choice.checked;
      });
      const selected = choices.filter(choice => choice.checked);
      const missing = selected.filter(choice => !ready.has(Number(choice.value)));
      printBtn.disabled = loading || !selected.length || missing.length > 0;
      status.textContent = loading ? 'Loading documents…' : missing.length
        ? `${missing.length} selected documents could not load. Reload this page to retry, or deselect them before printing.`
        : `${selected.length} documents selected. Review the print preview for page count.`;
      printBtnText.textContent = 'Print selection or save as PDF';
    }
    choices.forEach(choice => choice.addEventListener('change', updateSelection));
    document.getElementById('select-all').addEventListener('click', () => { choices.forEach(choice => { choice.checked = true; }); updateSelection(); });
    document.getElementById('select-none').addEventListener('click', () => { choices.forEach(choice => { choice.checked = false; }); updateSelection(); });
    document.getElementById('practice-name').addEventListener('input', function() {
      document.querySelectorAll('.practice-header').forEach(header => { header.textContent = this.value.trim(); });
    });
    async function loadPrintPackage() {
      const progressItems = document.querySelectorAll('.progress-item');
      for (let index = 0; index < printablePages.length; index++) {
        const page = printablePages[index];
        try {
          const response = await fetch(page.url);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
          const pages = doc.querySelectorAll('.print-page');
          if (!pages.length) throw new Error('No printable content found');
          const section = document.createElement('section');
          section.dataset.printSection = String(index);
          section.hidden = !choices[index].checked;
          pages.forEach(page => {
            const clone = page.cloneNode(true);
            // Source handouts have fixed folios; browser pagination differs in a combined package.
            clone.querySelectorAll('header p').forEach(label => {
              if (/^Page \d+ of \d+$/.test(label.textContent.trim())) label.remove();
            });
            const header = document.createElement('div'); header.className = 'practice-header';
            header.textContent = document.getElementById('practice-name').value.trim();
            clone.prepend(header); section.append(clone);
          });
          printContent.append(section);
          for (const style of doc.querySelectorAll('style')) {
            const duplicate = [...document.querySelectorAll('style[data-source]')].some(existing => existing.textContent === style.textContent);
            if (!duplicate) { const clone = style.cloneNode(true); clone.dataset.source = page.url; document.head.append(clone); }
          }
          // Production Astro extracts each page's scoped styles into linked CSS.
          // The cloned nodes retain those scope attributes and need their stylesheet.
          for (const link of doc.querySelectorAll('link[rel="stylesheet"]')) {
            const href = new URL(link.getAttribute('href'), response.url).href;
            if (![...document.querySelectorAll('link[rel="stylesheet"]')].some(existing => existing.href === href)) {
              await new Promise((resolve, reject) => {
                const stylesheet = document.createElement('link'); stylesheet.rel = 'stylesheet'; stylesheet.href = href;
                stylesheet.onload = resolve; stylesheet.onerror = () => reject(new Error('Print styles did not load'));
                document.head.append(stylesheet);
              });
            }
          }
          ready.add(index);
          progressItems[index]?.classList.add('loaded');
          progressItems[index]?.querySelector('.check-icon')?.classList.remove('hidden');
          progressItems[index]?.querySelector('.pending-dot')?.classList.add('hidden');
        } catch (error) {
          failed.add(index);
          console.error(`Could not load print document ${page.url}`, error);
          progressItems[index]?.classList.add('error');
        }
      }
      loading = false;
      document.getElementById('loading-state').hidden = true;
      updateSelection();
    }
    loadPrintPackage();
  </script>
    <!-- Print Disclaimer -->
    <div class="mt-8 pt-4 border-t border-gray-300 text-xs text-gray-500">
      <p><strong>Disclaimer:</strong> This material is compiled from published clinical protocols and peer-reviewed sources. It is intended as a reference for trained clinicians only and does not replace formal EMDR training, supervision, or clinical judgment. Not for distribution to clients. Sources: Shapiro (2018), EMDRIA Guidelines, WHO (2013), APA (2017).</p>
    </div>
</BaseLayout>

<style is:global>
@media print {
  #print-content header { display: block !important; break-inside: avoid; break-after: avoid-page; }
  #print-content [hidden] { display: none !important; }
  #print-content [data-print-section] { break-before: auto; margin-bottom: 1.5rem !important; }
  #print-content .print-page { min-height: 0 !important; break-after: auto !important; page-break-after: auto !important; margin-bottom: 1rem !important; }
  #print-content h1, #print-content h2, #print-content h3 { display: block !important; break-inside: avoid; break-after: avoid-page; }
  #print-content h2 > span, #print-content h3 > span { display: inline-flex; vertical-align: middle; margin-right: 0.3rem; }
  #print-content p, #print-content li { line-height: 1.4 !important; orphans: 3; widows: 3; }
  #print-content .text-sm { font-size: 10pt !important; }
}
@media(max-width:640px) { #print-content { overflow-wrap:anywhere; } #print-content table { display:block; overflow-x:auto; max-width:100%; } }
</style>
