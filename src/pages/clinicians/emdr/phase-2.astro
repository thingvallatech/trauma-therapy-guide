---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClinicalBanner from '../../../components/ClinicalBanner.astro';
import References from '../../../components/References.astro';
import PhaseNav from '../../../components/PhaseNav.astro';
---

<BaseLayout title="Phase 2: Preparation - EMDR" description="Preparing the client for EMDR processing by teaching stabilization techniques, establishing safety resources, and introducing bilateral stimulation.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6 no-print">
      <ol class="flex items-center gap-2 text-forest-400">
        <li><a href="/clinicians" class="hover:text-forest-600 transition-colors">Clinicians</a></li>
        <li>/</li>
        <li><a href="/clinicians/emdr" class="hover:text-forest-600 transition-colors">EMDR</a></li>
        <li>/</li>
        <li class="text-forest-100">Phase 2</li>
      </ol>
    </nav>

    <ClinicalBanner />

    <!-- Header with visual emphasis -->
    <header class="mb-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-gradient-to-br from-forest-600 to-forest-700 rounded-2xl flex items-center justify-center text-bronze-400 font-serif text-2xl font-bold">
            2
          </div>
          <div>
            <p class="text-bronze-500 font-medium text-sm uppercase tracking-wide">Phase 2 of 8</p>
            <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-bronze-gradient">
              Preparation
            </h1>
          </div>
        </div>
        <div class="no-print flex items-center gap-2">
          <a
            href="/clinicians/emdr/phase-2-scripts"
            class="inline-flex items-center gap-2 px-4 py-2 bg-bronze-500 text-forest-900 rounded-lg hover:bg-bronze-400 transition-colors text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Print Scripts
          </a>
          <button
            onclick="window.print()"
            class="inline-flex items-center gap-2 px-4 py-2 bg-forest-700 border border-forest-500 text-forest-100 rounded-lg hover:bg-forest-700 transition-colors text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print Page
          </button>
        </div>
      </div>
    </header>

    <!-- Goals as horizontal pills -->
    <div class="flex flex-wrap gap-2 mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-700 text-bronze-400 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Psychoeducation
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-700 text-bronze-400 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Assess readiness
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-700 text-bronze-400 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Introduce BLS
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-700 text-bronze-400 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Establish resources
      </span>
    </div>

    <!-- Two column layout for main content -->
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Left column: Main content cards -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Psychoeducation Script Card -->
        <div class="bg-forest-800 rounded-xl border border-forest-600 overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
              Psychoeducation Script
            </h2>
          </div>
          <div class="p-5">
            <div class="bg-forest-700/50 rounded-lg p-4 border-l-4 border-forest-500 mb-4">
              <p class="text-sm text-forest-100 italic leading-relaxed">
                "Think of your brain like a streaming service with different channels. When something really stressful or upsetting happens, it's like one channel gets stuck, replaying the same scene over and over. No matter how much time passes, that memory can still pop up with the same intensity, making you feel like you're stuck in the past."
              </p>
            </div>
            <div class="bg-forest-700/50 rounded-lg p-4 border-l-4 border-forest-500 mb-4">
              <p class="text-sm text-forest-100 italic leading-relaxed">
                "EMDR helps 'unstick' that channel so your brain can process the memory the way it was meant to—like any other event from your past, without it constantly interrupting your present. We do this using bilateral stimulation, which is like pressing 'play' instead of 'rewind.'"
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-forest-600">
              <h3 class="text-sm font-semibold text-forest-400 uppercase tracking-wide mb-3">Child-Friendly Version</h3>
              <div class="bg-forest-700 rounded-lg p-4 border-l-4 border-bronze-500">
                <p class="text-sm text-forest-100 italic leading-relaxed">
                  "Your brain is like a train on a track. Most of the time, it moves forward just fine. But if something really upsetting happens, it's like the train gets stuck on a broken piece of track and can't move on. EMDR helps fix that track so your brain train can keep going."
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Readiness Signs Card -->
        <div class="bg-forest-800 rounded-xl border border-forest-600 overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Signs Client is NOT Ready
            </h2>
          </div>
          <div class="p-5">
            <div class="grid sm:grid-cols-2 gap-3">
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Suicidal ideation or crisis</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Active self-harming behaviors</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Addictive behaviors</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Lengthy anger outbursts</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Unable to experience positive emotions</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Cannot tolerate calmness</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">New medications (allow stabilization)</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Inability to stay present</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Trance states or memory lapses</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Trauma ongoing or occurring presently</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Stability concerns (lack of support)</span>
              </div>
              <div class="flex items-start gap-2 p-2 bg-forest-700 rounded-lg">
                <span class="text-bronze-400 mt-0.5">×</span>
                <span class="text-sm text-forest-100">Upcoming court proceedings</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Resource Exercises Card -->
        <div class="bg-forest-800 rounded-xl border border-forest-600 overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              Resource Exercises
            </h2>
          </div>
          <div class="p-5">
            <p class="text-sm text-forest-300 mb-4">Click each resource to access printable scripts for teens and children.</p>
            <div class="grid sm:grid-cols-2 gap-4">
              <a href="/clinicians/emdr/phase-2-resource-safe-place" class="block group border-2 border-forest-500 rounded-xl p-4 hover:border-bronze-400 transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-10 h-10 bg-forest-700 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-bronze-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                  </div>
                  <svg class="w-4 h-4 text-forest-400 group-hover:text-bronze-500 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-forest-100 mb-1 group-hover:text-bronze-400">Safe Place</h3>
                <p class="text-sm text-forest-300 italic">"Imagine a place where you feel safe. What do you see, hear, and feel there?"</p>
              </a>
              <a href="/clinicians/emdr/phase-2-resource-container" class="block group border-2 border-forest-500 rounded-xl p-4 hover:border-bronze-400 transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-10 h-10 bg-forest-700 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-forest-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                    </svg>
                  </div>
                  <svg class="w-4 h-4 text-forest-400 group-hover:text-forest-400 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-forest-100 mb-1 group-hover:text-forest-400">Container</h3>
                <p class="text-sm text-forest-300 italic">"If distressing thoughts arise, visualize placing them in a secure container."</p>
              </a>
              <a href="/clinicians/emdr/phase-2-resource-lightstream" class="block group border-2 border-bronze-500 rounded-xl p-4 hover:border-bronze-400 transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-10 h-10 bg-forest-700 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                  </div>
                  <svg class="w-4 h-4 text-bronze-400 group-hover:text-amber-500 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-forest-100 mb-1 group-hover:text-amber-500">Light Stream</h3>
                <p class="text-sm text-forest-300 italic">"Imagine a warm, healing light flowing through the body."</p>
              </a>
              <a href="/clinicians/emdr/phase-2-resource-breathing" class="block group border-2 border-forest-200 rounded-xl p-4 hover:border-forest-400 transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-10 h-10 bg-forest-700 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-bronze-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                    </svg>
                  </div>
                  <svg class="w-4 h-4 text-forest-400 group-hover:text-forest-600 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-forest-100 mb-1 group-hover:text-forest-300">Breathing (10 Techniques)</h3>
                <p class="text-sm text-forest-300 italic">"Breathe in for four counts, hold for four, exhale for four."</p>
              </a>
            </div>

            <div class="mt-5 pt-4 border-t border-forest-600">
              <h3 class="text-sm font-semibold text-forest-400 uppercase tracking-wide mb-3">Stop Signal</h3>
              <div class="bg-forest-700 rounded-lg p-4">
                <p class="text-sm text-forest-100 italic">"If you need to pause, use a stop signal like raising your hand or saying 'stop.' What feels natural to you?"</p>
                <p class="text-xs text-forest-400 mt-2">For younger children, create a personalized stop sign.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- BLS Options Card -->
        <div class="bg-forest-800 rounded-xl border border-forest-600 overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              Bilateral Stimulation Options
            </h2>
          </div>
          <div class="p-5">
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <div class="bg-forest-700/50 rounded-lg p-2 text-center text-sm text-forest-100">Eye movement tracking</div>
              <div class="bg-forest-700/50 rounded-lg p-2 text-center text-sm text-forest-100">Puppet tracking</div>
              <div class="bg-forest-700/50 rounded-lg p-2 text-center text-sm text-forest-100">Wand following</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Hand taps</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Butterfly Hug</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Gorilla Tapping</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Brushes</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Drum beat</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Tappers</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Magic Headphones</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Marching in place</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Bilateral ball toss</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Bilateral dance</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Bilateral drawing</div>
              <div class="bg-forest-700 rounded-lg p-2 text-center text-sm text-forest-100">Hopscotch</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right column: Sticky Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-24 space-y-6">
          <!-- Quick Checklist -->
          <div class="bg-forest-800 rounded-xl border border-forest-600 overflow-hidden">
          <div class="bg-forest-700 px-4 py-3">
            <h2 class="text-white font-semibold text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              Quick Checklist
            </h2>
          </div>
          <div class="p-4">
            <ol class="space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</span>
                <span>Explain EMDR with age-appropriate metaphor</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</span>
                <span>Assess readiness markers</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</span>
                <span>Teach Safe Place exercise</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</span>
                <span>Teach Container exercise</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">5</span>
                <span>Practice breathing techniques</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">6</span>
                <span>Establish stop signal</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">7</span>
                <span>Introduce & practice BLS method</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-700 text-bronze-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">8</span>
                <span>Reinforce client's control</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- Clinical Considerations -->
        <div class="bg-forest-800 rounded-xl border border-amber-500 overflow-hidden">
          <div class="px-4 py-3 border-b border-amber-500">
            <h2 class="font-semibold text-amber-800 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Clinical Notes
            </h2>
          </div>
          <ul class="p-4 space-y-2 text-sm text-amber-900/80">
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Preparation length varies by client complexity
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Some clients need extensive stabilization
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Complex trauma may require extended Phase 2
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              <strong>Ensure resources are strong before Phase 3</strong>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Practice between sessions to strengthen
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Document preferred resources & BLS method
            </li>
          </ul>
        </div>

        <!-- Closing Script -->
        <div class="bg-gradient-to-br from-forest-700/50 to-forest-700 rounded-xl border border-forest-600 overflow-hidden">
          <div class="px-4 py-3 border-b border-forest-600">
            <h2 class="font-semibold text-forest-300 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Closing Script
            </h2>
          </div>
          <div class="p-4">
            <p class="text-sm text-forest-300 italic">
              "You've done great. Use these skills if anything comes up between sessions. You are in control. We'll move at your pace. Do you feel ready to begin processing next time?"
            </p>
          </div>
        </div>
        </div>
      </div>
    </div>

    <!-- Contraindications & Modified Protocols -->
    <div class="mt-10 bg-amber-900/20 border border-amber-700/40 rounded-xl overflow-hidden">
      <div class="px-5 py-3 border-b border-amber-700/40 bg-amber-900/30">
        <h2 class="font-semibold text-amber-300 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Contraindications & Modified Protocols
        </h2>
      </div>
      <div class="p-5 space-y-4">
        <p class="text-sm text-forest-200">
          EMDR processing (Phases 3-8) should be deferred or modified when any of the following are present. Ensure adequate preparation and consultation before proceeding.
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <h3 class="text-sm font-semibold text-amber-300 mb-2">Defer Processing</h3>
            <ul class="space-y-1.5 text-sm text-forest-200">
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Active suicidality or self-harm
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Unstable psychosis or mania
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Insufficient affect regulation capacity
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Ongoing danger in the home or environment
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Substance dependence with active withdrawal
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-amber-300 mb-2">Modify Protocol</h3>
            <ul class="space-y-1.5 text-sm text-forest-200">
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Dissociative disorders (use stabilization-focused approach)
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Complex/developmental trauma (extended preparation)
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Very young children (use adapted child protocol)
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Medical conditions affecting eye movement
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 mt-0.5">&#x2022;</span>
                Pregnancy (consult specialized protocols)
              </li>
            </ul>
          </div>
        </div>
        <p class="text-xs text-forest-400 mt-2">
          Always consult your supervisor and refer to Shapiro (2018) Chapter 4 and EMDRIA guidelines for detailed contraindication assessment.
        </p>
      </div>
    </div>

    <References />
    <!-- Navigation -->
    <div class="phase-nav mt-10">
      <PhaseNav currentPhase={2} />
    </div>
  </div>
</BaseLayout>
