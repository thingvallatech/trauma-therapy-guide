---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClinicalBanner from '../../../components/ClinicalBanner.astro';
import References from '../../../components/References.astro';
import PhaseNav from '../../../components/PhaseNav.astro';
---

<BaseLayout title="Phase 4: Desensitization - EMDR" description="Processing the target memory using bilateral stimulation until the disturbance is neutralized.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6 no-print">
      <ol class="flex items-center gap-2 text-forest-500">
        <li><a href="/clinicians" class="hover:text-forest-600 transition-colors">Clinicians</a></li>
        <li>/</li>
        <li><a href="/clinicians/emdr" class="hover:text-forest-600 transition-colors">EMDR</a></li>
        <li>/</li>
        <li class="text-forest-900">Phase 4</li>
      </ol>
    </nav>

    <ClinicalBanner />

    <!-- Header with visual emphasis -->
    <header class="mb-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-gradient-to-br from-forest-600 to-forest-700 rounded-2xl flex items-center justify-center text-bronze-700 font-serif text-2xl font-bold">
            4
          </div>
          <div>
            <p class="text-bronze-500 font-medium text-sm uppercase tracking-wide">Phase 4 of 8</p>
            <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-bronze-gradient">
              Desensitization
            </h1>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/clinicians/emdr/phase-4-scripts"
            class="no-print inline-flex items-center gap-2 px-4 py-2 bg-bronze-500 text-forest-900 rounded-lg hover:bg-bronze-400 transition-colors text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Print Scripts
          </a>
          <button
            onclick="window.print()"
            class="no-print inline-flex items-center gap-2 px-4 py-2 bg-forest-50 border border-forest-200 text-forest-900 rounded-lg hover:bg-forest-50 transition-colors text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print
          </button>
        </div>
      </div>
    </header>

    <!-- Goals as horizontal pills -->
    <div class="flex flex-wrap gap-2 mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-700 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Process disturbing material
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-700 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Reduce SUD to 0
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-700 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Allow adaptive integration
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-forest-50 text-bronze-700 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Follow associative processing
      </span>
    </div>

    <!-- Two column layout for main content -->
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Left column: Main content cards -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Setup Script Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Setup Script
            </h2>
          </div>
          <div class="p-5">
            <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-bronze-500 mb-4">
              <p class="text-sm text-forest-900 italic leading-relaxed">
                "Remember that this is not happening now and you are safe. I am right here with you. Let whatever happens happen, just notice what is coming up for you. Any thoughts, images, emotions and body sensations. Remember that there is no right or wrong, just watch what is coming up and notice them as you would observe the scenery from a moving train. You can use your stop signal if needed."
              </p>
            </div>
          </div>
        </div>

        <!-- Beginning Processing Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Beginning Processing
            </h2>
          </div>
          <div class="p-5">
            <div class="bg-forest-50/50 rounded-lg p-4 border-l-4 border-forest-200 mb-4">
              <p class="text-sm text-forest-900 italic leading-relaxed">
                "Now I am inviting you to hold in your mind and body:<br/>
                • The image<br/>
                • The negative belief: [state NC]<br/>
                • The emotions: [state emotions]<br/>
                • That you feel in your [body location]<br/><br/>
                And I am going to [client's preferred BLS method] for you to follow."
              </p>
            </div>
            <div class="bg-forest-50 rounded-lg p-3 text-center">
              <p class="text-sm font-medium text-forest-600">Begin bilateral stimulation: 24-36 passes (~30 seconds)</p>
            </div>
          </div>
        </div>

        <!-- Between Sets Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              Between Sets
            </h2>
          </div>
          <div class="p-5">
            <div class="grid sm:grid-cols-2 gap-4 mb-4">
              <div class="border-2 border-forest-200 rounded-xl p-4">
                <h3 class="font-semibold text-forest-900 mb-2 text-sm">After Each Set:</h3>
                <div class="bg-forest-50 rounded-lg p-3">
                  <p class="text-sm text-forest-900 italic">"Let's stop, take a breath, let it go... What are you noticing now?"</p>
                </div>
                <p class="text-xs text-forest-500 mt-2 text-center">or</p>
                <div class="bg-forest-50 rounded-lg p-3 mt-2">
                  <p class="text-sm text-forest-900 italic">"What is happening now?"</p>
                </div>
              </div>
              <div class="border-2 border-forest-200 rounded-xl p-4">
                <h3 class="font-semibold text-forest-900 mb-2 text-sm">Continue Processing:</h3>
                <div class="bg-forest-50/50 rounded-lg p-3">
                  <p class="text-sm text-forest-900 italic">"Go with that."</p>
                </div>
                <p class="text-xs text-forest-500 mt-2 text-center">or</p>
                <div class="bg-forest-50/50 rounded-lg p-3 mt-2">
                  <p class="text-sm text-forest-900 italic">"Notice that."</p>
                </div>
                <p class="text-xs text-forest-500 mt-2 text-center">Resume BLS (24-36 passes)</p>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-linen">
              <h3 class="text-sm font-semibold text-forest-500 uppercase tracking-wide mb-3">Return to Target</h3>
              <div class="bg-forest-50 rounded-lg p-4">
                <p class="text-sm text-forest-900 italic mb-2">"When you go back to the original incident, what do you get now?"</p>
                <p class="text-sm text-forest-900 italic">"On a scale of 0-10, how disturbing does it feel now?"</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Processing Guidelines Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Processing Guidelines
            </h2>
          </div>
          <div class="p-5">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <h3 class="text-sm font-semibold text-forest-900 mb-3">Stay Out of the Way</h3>
                <p class="text-sm text-forest-600 mb-3">Processing continues spontaneously unless:</p>
                <ul class="space-y-2 text-sm text-charcoal">
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-700 mt-1">•</span>
                    Information processing stalls
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-700 mt-1">•</span>
                    Two consecutive negative responses
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-700 mt-1">•</span>
                    Client shifts into hypo/hyper arousal
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-bronze-700 mt-1">•</span>
                    Client uses stop signal
                  </li>
                </ul>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-forest-900 mb-3">What Clients May Experience</h3>
                <ul class="space-y-2 text-sm text-charcoal">
                  <li class="flex items-start gap-2">
                    <span class="text-forest-500 mt-1">•</span>
                    New images or memories
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-forest-500 mt-1">•</span>
                    Different emotions (sometimes intense)
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-forest-500 mt-1">•</span>
                    Body sensations shifting
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-forest-500 mt-1">•</span>
                    Insights or new thoughts
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-forest-500 mt-1">•</span>
                    Nothing noticeable (this is okay)
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Understanding Interweaves Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-bronze-600 to-bronze-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              Understanding Interweaves
            </h2>
          </div>
          <div class="p-5">
            <!-- What are Interweaves -->
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-forest-900 mb-2">What Are Interweaves?</h3>
              <p class="text-sm text-forest-600 leading-relaxed">
                Interweaves are strategic therapeutic interventions used <strong>only when processing becomes stuck</strong>. They introduce new information or perspectives to help restart the client's adaptive information processing system. Think of them as gentle "jump starts" that provide what the client needs to continue processing on their own.
              </p>
            </div>

            <!-- Signs of Stuck Processing -->
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-forest-900 mb-2">Signs Processing is Stuck</h3>
              <div class="grid sm:grid-cols-2 gap-3">
                <div class="bg-forest-50/50 rounded-lg p-3 border border-amber-500">
                  <h4 class="text-xs font-semibold text-amber-800 uppercase tracking-wide mb-2">Looping</h4>
                  <ul class="text-xs text-amber-900/80 space-y-1">
                    <li>• Same material repeats 2-3 sets</li>
                    <li>• SUD not changing</li>
                    <li>• Returning to same emotion/image</li>
                  </ul>
                </div>
                <div class="bg-forest-50 rounded-lg p-3 border border-bronze-500">
                  <h4 class="text-xs font-semibold text-bronze-700 uppercase tracking-wide mb-2">Blocking</h4>
                  <ul class="text-xs text-forest-600 space-y-1">
                    <li>• Client reports "nothing" or "blank"</li>
                    <li>• Sudden dissociation or numbing</li>
                    <li>• Avoidance of specific material</li>
                  </ul>
                </div>
                <div class="bg-forest-50 rounded-lg p-3 border border-forest-200">
                  <h4 class="text-xs font-semibold text-forest-600 uppercase tracking-wide mb-2">Abreaction Stall</h4>
                  <ul class="text-xs text-forest-600 space-y-1">
                    <li>• Intense emotion not shifting</li>
                    <li>• Client overwhelmed for extended time</li>
                    <li>• Hyper/hypo arousal persists</li>
                  </ul>
                </div>
                <div class="bg-forest-50 rounded-lg p-3 border border-forest-200">
                  <h4 class="text-xs font-semibold text-forest-600 uppercase tracking-wide mb-2">Feeder Memory</h4>
                  <ul class="text-xs text-forest-600 space-y-1">
                    <li>• Earlier memory driving current block</li>
                    <li>• Core belief preventing integration</li>
                    <li>• May need to target earlier memory</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Before Using Interweaves -->
            <div class="bg-forest-50/50 rounded-lg p-4 border-l-4 border-forest-200 mb-5">
              <h4 class="text-sm font-semibold text-forest-600 mb-2">Before Using an Interweave, Try:</h4>
              <ul class="text-sm text-forest-600 space-y-1">
                <li>• Changing BLS speed, direction, or type</li>
                <li>• Adjusting set length (longer for cognitive, shorter for emotional)</li>
                <li>• Adding auditory or tactile BLS</li>
                <li>• Asking client to verbalize what they're seeing</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Types of Interweaves Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
              </svg>
              Types of Interweaves
            </h2>
          </div>
          <div class="p-5 space-y-4">

            <!-- Cognitive Interweaves -->
            <details class="border border-forest-200 rounded-lg overflow-hidden" open>
              <summary class="bg-forest-50 px-4 py-3 cursor-pointer hover:bg-forest-50 transition-colors">
                <span class="font-semibold text-forest-600">Cognitive Interweaves</span>
                <span class="text-xs text-forest-500 ml-2">-- Introduce new information or perspective</span>
              </summary>
              <div class="p-4 space-y-3">
                <p class="text-sm text-forest-600">Use when client is stuck in irrational beliefs or distorted thinking:</p>
                <div class="space-y-2">
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-400 text-white text-xs font-bold rounded flex-shrink-0">RESPONSIBILITY</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"Whose fault was it really?"</p>
                      <p class="text-xs text-forest-500 mt-1">"If this happened to a child you know, would you blame them?"</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-400 text-white text-xs font-bold rounded flex-shrink-0">SAFETY</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"Is it over? Are you safe now?"</p>
                      <p class="text-xs text-forest-500 mt-1">"Where are you right now? Look around this room."</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-400 text-white text-xs font-bold rounded flex-shrink-0">CHOICES</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"What choices did you have as a child?"</p>
                      <p class="text-xs text-forest-500 mt-1">"What options were available to you at that age?"</p>
                    </div>
                  </div>
                </div>
              </div>
            </details>

            <!-- Emotional Interweaves -->
            <details class="border border-bronze-500 rounded-lg overflow-hidden">
              <summary class="bg-forest-50 px-4 py-3 cursor-pointer hover:bg-forest-50 transition-colors">
                <span class="font-semibold text-bronze-700">Emotional Interweaves</span>
                <span class="text-xs text-bronze-500 ml-2">-- Access or validate blocked emotions</span>
              </summary>
              <div class="p-4 space-y-3">
                <p class="text-sm text-forest-600">Use when emotions are blocked, minimized, or client is intellectualizing:</p>
                <div class="space-y-2">
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-bronze-500 text-forest-900 text-white text-xs font-bold rounded flex-shrink-0">ACCESSING</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"What would you want to say to them if you could?"</p>
                      <p class="text-xs text-forest-500 mt-1">"If your body could speak right now, what would it say?"</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-bronze-500 text-forest-900 text-white text-xs font-bold rounded flex-shrink-0">VALIDATION</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"It makes sense you would feel that way."</p>
                      <p class="text-xs text-forest-500 mt-1">"Any child in that situation would feel [emotion]."</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-bronze-500 text-forest-900 text-white text-xs font-bold rounded flex-shrink-0">PERMISSION</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"It's okay to feel angry about what happened."</p>
                      <p class="text-xs text-forest-500 mt-1">"What would it be like to let yourself feel that?"</p>
                    </div>
                  </div>
                </div>
              </div>
            </details>

            <!-- Somatic Interweaves -->
            <details class="border border-forest-200 rounded-lg overflow-hidden">
              <summary class="bg-forest-50 px-4 py-3 cursor-pointer hover:bg-forest-50 transition-colors">
                <span class="font-semibold text-forest-600">Somatic Interweaves</span>
                <span class="text-xs text-bronze-500 ml-2">-- Release body-held trauma</span>
              </summary>
              <div class="p-4 space-y-3">
                <p class="text-sm text-forest-600">Use when body sensations persist or defensive responses are stuck:</p>
                <div class="space-y-2">
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-bronze-500 text-forest-900 text-white text-xs font-bold rounded flex-shrink-0">MOVEMENT</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"What does your body want to do right now?"</p>
                      <p class="text-xs text-forest-500 mt-1">"If your hands/feet could move freely, what would they do?"</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-bronze-500 text-forest-900 text-white text-xs font-bold rounded flex-shrink-0">COMPLETION</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"Push against my hands" (for fight response)</p>
                      <p class="text-xs text-forest-500 mt-1">"Imagine your legs running you to safety" (for flight)</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-bronze-500 text-forest-900 text-white text-xs font-bold rounded flex-shrink-0">GROUNDING</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"Feel your feet on the floor right now."</p>
                      <p class="text-xs text-forest-500 mt-1">"Notice where your body feels calm or neutral."</p>
                    </div>
                  </div>
                </div>
              </div>
            </details>

            <!-- Attachment/Parts/Unmet Needs Interweaves -->
            <details class="border border-linen rounded-lg overflow-hidden">
              <summary class="bg-forest-50/50 px-4 py-3 cursor-pointer hover:bg-forest-50 transition-colors">
                <span class="font-semibold text-forest-600">Attachment, Parts & Unmet Needs</span>
                <span class="text-xs text-bronze-500 ml-2">-- Repair developmental wounds</span>
              </summary>
              <div class="p-4 space-y-3">
                <p class="text-sm text-forest-600">Use when attachment wounds, younger parts, or unmet needs block processing:</p>
                <div class="space-y-2">
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-500 text-white text-xs font-bold rounded flex-shrink-0">YOUNGER SELF</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"What does that younger part of you need to hear?"</p>
                      <p class="text-xs text-forest-500 mt-1">"Can your adult self go comfort that child?"</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-500 text-white text-xs font-bold rounded flex-shrink-0">PROTECTIVE PARTS</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"What is this part trying to protect you from?"</p>
                      <p class="text-xs text-forest-500 mt-1">"Can you thank this part for trying to keep you safe?"</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-500 text-white text-xs font-bold rounded flex-shrink-0">UNMET NEEDS</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"What did you need then that you didn't get?"</p>
                      <p class="text-xs text-forest-500 mt-1">"Imagine receiving what you needed from a safe figure."</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-2 rounded bg-forest-50/50">
                    <span class="inline-block px-2 py-0.5 bg-forest-500 text-white text-xs font-bold rounded flex-shrink-0">REPAIR</span>
                    <div>
                      <p class="text-sm text-forest-900 italic">"Imagine a nurturing figure providing what was missing."</p>
                      <p class="text-xs text-forest-500 mt-1">"What would it feel like to receive that care now?"</p>
                    </div>
                  </div>
                </div>
              </div>
            </details>

          </div>
        </div>

      </div>

      <!-- Right column: Sticky Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-24 space-y-6">
          <!-- Quick Checklist -->
          <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-forest-50 px-4 py-3">
            <h2 class="text-white font-semibold text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              Quick Checklist
            </h2>
          </div>
          <div class="p-4">
            <ol class="space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</span>
                <span>Remind client of safety & stop signal</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</span>
                <span>Activate target (image + NC + emotions + body)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</span>
                <span>Begin BLS (24-36 passes)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</span>
                <span>"What do you notice?" after each set</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">5</span>
                <span>"Go with that" -- continue</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">6</span>
                <span>Return to target when needed</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">7</span>
                <span>Check SUD when client reports calm</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">8</span>
                <span>Continue until SUD = 0 or ecological</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- Move to Phase 5 -->
        <div class="bg-gradient-to-br from-forest-50/50 to-forest-50 rounded-xl border border-linen overflow-hidden">
          <div class="px-4 py-3 border-b border-linen">
            <h2 class="font-semibold text-forest-600 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              When to Move to Phase 5
            </h2>
          </div>
          <div class="p-4">
            <p class="text-sm text-forest-600">Continue Phase 4 until:</p>
            <ul class="mt-2 space-y-1 text-sm text-forest-600">
              <li class="flex items-center gap-2">
                <span class="text-forest-500">✓</span>
                SUD = 0, or
              </li>
              <li class="flex items-center gap-2">
                <span class="text-forest-500">✓</span>
                SUD is ecological (as low as realistic)
              </li>
            </ul>
          </div>
        </div>

        <!-- Clinical Considerations -->
        <div class="bg-sand rounded-xl border border-amber-500 overflow-hidden">
          <div class="px-4 py-3 border-b border-amber-500">
            <h2 class="font-semibold text-amber-800 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Clinical Notes
            </h2>
          </div>
          <ul class="p-4 space-y-2 text-sm text-amber-900/80">
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              <strong>Trust the process</strong> -- avoid leading
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Incomplete sessions need Phase 7 closure
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              High abreaction not always necessary
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Watch for looping or blocking patterns
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Use interweaves sparingly
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-1">•</span>
              Document channel changes during processing
            </li>
          </ul>
        </div>
        </div>
      </div>
    </div>

    <References />
    <!-- Navigation -->
    <div class="phase-nav mt-10">
      <PhaseNav currentPhase={4} />
    </div>
  </div>
</BaseLayout>
