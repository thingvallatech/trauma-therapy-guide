---
import { getEntry } from 'astro:content';
import PhaseLayout from '../../../layouts/PhaseLayout.astro';

const entry = await getEntry('emdr-phases', 'phase-5');
if (!entry) throw new Error('phase-5 not found');
---

<PhaseLayout
  phase={entry.data.phase}
  title={entry.data.title}
  shortTitle={entry.data.shortTitle}
  description={entry.data.description}
  goals={entry.data.goals}
>
    <!-- Two column layout for main content -->
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Left column: Main content cards -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Opening Script Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-bronze-600 to-bronze-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
              Opening Script
            </h2>
          </div>
          <div class="p-5">
            <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-bronze-500">
              <p class="text-sm text-forest-900 italic leading-relaxed">
                "We are now moving into the installation phase. This is where we strengthen a positive belief so that it fully integrates with the memory we've been processing. The goal is to help your brain connect the memory with a more adaptive, empowering belief."
              </p>
            </div>
          </div>
        </div>

        <!-- Installation Steps Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Installation Steps
            </h2>
          </div>
          <div class="p-5 space-y-4">
            <!-- Step 1 -->
            <div class="border-l-4 border-bronze-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-500 text-white rounded-full flex items-center justify-center text-xs font-bold">1</span>
                <h3 class="font-semibold text-forest-900">Verify the Positive Cognition</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"We originally identified [state PC] as the belief you'd like to hold about yourself. Does that still feel right, or would you like to adjust it?"</p>
              </div>
              <p class="text-xs text-forest-500 mt-2">If client wants to modify, collaborate to refine a statement that feels true and empowering.</p>
            </div>

            <!-- Step 2 -->
            <div class="border-l-4 border-forest-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-bronze-500 text-white rounded-full flex items-center justify-center text-xs font-bold">2</span>
                <h3 class="font-semibold text-forest-900">Check Validity of Cognition (VOC)</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"On a scale of 1 to 7, where 1 means 'completely false' and 7 means 'completely true,' how true does this positive belief feel to you now?"</p>
              </div>
              <p class="text-xs text-forest-500 mt-2">If VOC is below 7, continue processing to strengthen the belief.</p>
            </div>

            <!-- Step 3 -->
            <div class="border-l-4 border-forest-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-500 text-white rounded-full flex items-center justify-center text-xs font-bold">3</span>
                <h3 class="font-semibold text-forest-900">Install with BLS</h3>
              </div>
              <div class="bg-forest-50/50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"Hold the positive belief together with the target memory. Let yourself notice whatever happens as we go."</p>
              </div>
              <div class="bg-forest-50 rounded-lg p-2 mt-2 text-center">
                <p class="text-xs font-medium text-forest-600">Begin BLS: 24-36 passes (~30 seconds)</p>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="border-l-4 border-forest-200 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-bronze-500 text-forest-900 rounded-full flex items-center justify-center text-xs font-bold">4</span>
                <h3 class="font-semibold text-forest-900">Check-In</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"Take a breath... let it go. What came up for you?"</p>
              </div>
              <p class="text-xs text-forest-500 mt-2">Continue BLS until getting 2 same responses or no new information. Use interweaves if client shifts into hypo/hyper arousal.</p>
            </div>

            <!-- Step 5 -->
            <div class="border-l-4 border-bronze-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-400 text-white rounded-full flex items-center justify-center text-xs font-bold">5</span>
                <h3 class="font-semibold text-forest-900">Reassess VOC</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"Now, on that same scale from 1 to 7, how true does this belief feel to you?"</p>
              </div>
              <div class="mt-2 grid grid-cols-2 gap-2 text-sm">
                <div class="bg-forest-50 rounded p-2 text-charcoal">
                  <strong>VOC = 7:</strong> Proceed to Body Scan
                </div>
                <div class="bg-forest-50 rounded p-2 text-amber-700">
                  <strong>VOC < 7:</strong> Continue or explore barriers
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- When VOC Won't Reach 7 Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              When VOC Won't Reach 7
            </h2>
          </div>
          <div class="p-5">
            <p class="text-sm text-forest-600 mb-4">Sometimes VOC won't reach 7 due to:</p>
            <div class="grid sm:grid-cols-3 gap-3 mb-4">
              <div class="bg-forest-50 rounded-lg p-3 text-center">
                <p class="text-sm font-medium text-bronze-700">Realistic limitations</p>
                <p class="text-xs text-bronze-500">"I can't be 100% safe"</p>
              </div>
              <div class="bg-forest-50 rounded-lg p-3 text-center">
                <p class="text-sm font-medium text-bronze-700">Secondary gains</p>
                <p class="text-xs text-bronze-500">Need addressing</p>
              </div>
              <div class="bg-forest-50 rounded-lg p-3 text-center">
                <p class="text-sm font-medium text-bronze-700">Blocking beliefs</p>
                <p class="text-xs text-bronze-500">Need processing</p>
              </div>
            </div>
            <div class="bg-forest-50 rounded-lg p-4">
              <p class="text-sm text-forest-900 mb-2">A VOC of 6 may be ecological. Ask:</p>
              <p class="text-sm text-forest-900 italic">"What prevents it from being a 7?"</p>
              <p class="text-xs text-forest-500 mt-2">If the answer reveals another target, note it for future processing.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right column: Sticky Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-24 space-y-6">
          <!-- Quick Checklist -->
          <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-forest-50 px-4 py-3">
            <h2 class="text-charcoal font-semibold text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              Quick Reference
            </h2>
          </div>
          <div class="p-4">
            <ol class="space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</span>
                <span>Verify PC still fits (or adjust)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</span>
                <span>Check initial VOC (1-7)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</span>
                <span>Hold target + PC together</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</span>
                <span>Apply bilateral stimulation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">5</span>
                <span>"What do you notice?" after each set</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">6</span>
                <span>Continue until VOC = 7 or ecological</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">7</span>
                <span>Address blocking beliefs if needed</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">8</span>
                <span>Proceed to Body Scan when complete</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- Clinical Considerations -->
        <div class="bg-amber-50 rounded-xl border border-amber-300 overflow-hidden">
          <div class="px-4 py-3 border-b border-amber-300">
            <h2 class="font-semibold text-amber-800 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Clinical Notes
            </h2>
          </div>
          <ul class="p-4 space-y-2 text-sm text-amber-900/80">
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Don't force VOC to 7 if not realistic
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Blocking beliefs may indicate additional targets
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              PC should feel true in the gut, not just intellectually
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Installation prepares for Phase 6
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Document final VOC
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Doubts may need processing first
            </li>
          </ul>
        </div>
        </div>
      </div>
    </div>

</PhaseLayout>
