---
import { getEntry } from 'astro:content';
import PhaseLayout from '../../../layouts/PhaseLayout.astro';

const entry = await getEntry('emdr-phases', 'phase-8');
if (!entry) throw new Error('phase-8 not found');
---

<PhaseLayout
  phase={entry.data.phase}
  title={entry.data.title}
  shortTitle={entry.data.shortTitle}
  description={entry.data.description}
  goals={entry.data.goals}
>
    <!-- Two column layout for main content -->
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Left column: Main content cards -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Overview Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Overview
            </h2>
          </div>
          <div class="p-5">
            <p class="text-sm text-charcoal mb-4">Phase 8 occurs at the beginning of each session after processing has begun, and throughout treatment. It ensures that processing gains are maintained and guides ongoing treatment planning.</p>
            <div class="bg-forest-50/50 rounded-lg p-4 border-l-4 border-forest-200">
              <p class="text-sm text-forest-900 italic">"Reevaluation occurs at the beginning of each session. This is where we check in on the progress of the work we've done so far and ensure that the positive changes are lasting."</p>
            </div>
          </div>
        </div>

        <!-- Reevaluation Steps Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Reevaluation Steps
            </h2>
          </div>
          <div class="p-5 space-y-4">
            <!-- Step 1 -->
            <div class="border-l-4 border-forest-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-500 text-white rounded-full flex items-center justify-center text-xs font-bold">1</span>
                <h3 class="font-semibold text-forest-900">General Check-In</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"How have you been since our last session? What has stood out to you? Have any changes or memories come up?"</p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="border-l-4 border-forest-200 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-bronze-500 text-forest-900 rounded-full flex items-center justify-center text-xs font-bold">2</span>
                <h3 class="font-semibold text-forest-900">Assess the Target Memory</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3 mb-2">
                <p class="text-sm text-forest-900 italic">"Let's bring up the target memory we worked on last time. When you think about that memory now, what comes up for you?"</p>
              </div>
              <div class="grid sm:grid-cols-2 gap-2 text-sm">
                <div class="bg-forest-50 rounded p-2 text-charcoal">
                  <strong>SUD 0-2:</strong> Proceed with reinforcing
                </div>
                <div class="bg-forest-50 rounded p-2 text-amber-700">
                  <strong>SUD 3+:</strong> Check for new material/blocks
                </div>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="border-l-4 border-bronze-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-400 text-white rounded-full flex items-center justify-center text-xs font-bold">3</span>
                <h3 class="font-semibold text-forest-900">Assess the Positive Cognition</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"Think about the positive belief we installed last time. How true does it feel to you now on a scale of 1 to 7?"</p>
              </div>
              <p class="text-xs text-forest-500 mt-2">If VOC below 7, explore possible reasons and consider reprocessing.</p>
            </div>

            <!-- Step 4 -->
            <div class="border-l-4 border-bronze-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-bronze-500 text-white rounded-full flex items-center justify-center text-xs font-bold">4</span>
                <h3 class="font-semibold text-forest-900">Body Scan Reassessment</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"Let's do a quick body scan. Bring up the target memory and the positive belief, and notice if there's any discomfort or tension in your body."</p>
              </div>
              <p class="text-xs text-forest-500 mt-2">If lingering tension, process with BLS. If clear, continue reinforcing progress.</p>
            </div>

            <!-- Steps 5-7 -->
            <div class="border-l-4 border-forest-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-500 text-white rounded-full flex items-center justify-center text-xs font-bold">5</span>
                <h3 class="font-semibold text-forest-900">Address New Material</h3>
              </div>
              <div class="bg-forest-50/50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"If anything new has come up, or if there's still unresolved material, we can continue to process it."</p>
              </div>
            </div>

            <div class="border-l-4 border-forest-500 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-forest-500 text-white rounded-full flex items-center justify-center text-xs font-bold">6</span>
                <h3 class="font-semibold text-forest-900">Check Current Distress</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"On a scale from 0 to 10, how much distress does this memory still bring up for you?"</p>
              </div>
            </div>

            <div class="border-l-4 border-forest-200 pl-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 bg-bronze-500 text-forest-900 rounded-full flex items-center justify-center text-xs font-bold">7</span>
                <h3 class="font-semibold text-forest-900">Reinforce Progress</h3>
              </div>
              <div class="bg-forest-50 rounded-lg p-3">
                <p class="text-sm text-forest-900 italic">"Now that we've processed the memory and emotions, let's focus on the positive belief. Does it feel more integrated now?"</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Three-Pronged Protocol Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-forest-600 to-forest-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              Three-Pronged Protocol
            </h2>
          </div>
          <div class="p-5">
            <p class="text-sm text-forest-600 mb-4">Ensure comprehensive treatment of all three prongs. Treatment is complete when all are addressed:</p>
            <div class="space-y-3">
              <div class="flex items-center gap-4 p-4 rounded-xl bg-forest-50 border border-bronze-500">
                <div class="w-16 flex-shrink-0">
                  <span class="inline-block px-3 py-1.5 bg-bronze-500 text-forest-900 text-sm font-bold rounded-lg">PAST</span>
                </div>
                <div>
                  <p class="font-semibold text-forest-900">Past Memories</p>
                  <p class="text-sm text-forest-600">Original events that set the template</p>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-forest-50 border border-bronze-500">
                <div class="w-16 flex-shrink-0">
                  <span class="inline-block px-3 py-1.5 bg-bronze-500 text-forest-900 text-sm font-bold rounded-lg">PRESENT</span>
                </div>
                <div>
                  <p class="font-semibold text-forest-900">Present Triggers</p>
                  <p class="text-sm text-forest-600">Current situations that activate distress</p>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-forest-50 border border-forest-200">
                <div class="w-16 flex-shrink-0">
                  <span class="inline-block px-3 py-1.5 bg-bronze-500 text-forest-900 text-sm font-bold rounded-lg">FUTURE</span>
                </div>
                <div>
                  <p class="font-semibold text-forest-900">Future Templates</p>
                  <p class="text-sm text-forest-600">Positive future scenarios</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TICES Log Card -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden">
          <div class="bg-gradient-to-r from-bronze-600 to-bronze-700 px-5 py-3">
            <h2 class="text-white font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              TICES Log
            </h2>
          </div>
          <div class="p-5">
            <p class="text-sm text-forest-600 mb-4">Recommend clients track between-session experiences:</p>
            <div class="bg-forest-50 rounded-lg p-4 border-l-4 border-bronze-500 mb-4">
              <p class="text-sm text-forest-900 italic">"Did you notice any changes about your target problem since your last session? Write down what triggered you, what picture/image came to mind, thoughts, emotions, body sensations, and how much it bothered you on the SUD scale."</p>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm border border-linen rounded-lg">
                <thead class="bg-forest-50">
                  <tr>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">Date</th>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">Trigger</th>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">Picture</th>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">Thoughts</th>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">Emotions</th>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">Body</th>
                    <th class="px-2 py-2 text-left font-medium text-forest-900">SUD</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-t border-linen">
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                    <td class="px-2 py-3 text-forest-500">&nbsp;</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>

      <!-- Right column: Sidebar content -->
      <div class="space-y-6">

        <!-- Session Opening Checklist -->
        <div class="bg-sand rounded-xl border border-linen overflow-hidden sticky top-24">
          <div class="bg-forest-50 px-4 py-3">
            <h2 class="text-charcoal font-semibold text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              Session Opening
            </h2>
          </div>
          <div class="p-4">
            <ol class="space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</span>
                <span>General check-in since last session</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</span>
                <span>Assess previous target (SUD, new material)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</span>
                <span>Check VOC of installed PC</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</span>
                <span>Body scan reassessment</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">5</span>
                <span>Determine session focus</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- Treatment Planning -->
        <div class="bg-forest-50 rounded-xl border border-forest-200 overflow-hidden">
          <div class="px-4 py-3 border-b border-forest-200">
            <h2 class="font-semibold text-forest-600 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Treatment Planning
            </h2>
          </div>
          <ol class="p-4 space-y-2 text-sm">
            <li class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</span>
              <span>Evaluate symptom improvement</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</span>
              <span>Check target completion</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</span>
              <span>Assess for new targets</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</span>
              <span>Ensure three-pronged approach</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-forest-50 text-bronze-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">5</span>
              <span>Plan for termination when goals met</span>
            </li>
          </ol>
        </div>

        <!-- Clinical Considerations -->
        <div class="bg-amber-50 rounded-xl border border-amber-300 overflow-hidden">
          <div class="px-4 py-3 border-b border-amber-300">
            <h2 class="font-semibold text-amber-800 text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Clinical Notes
            </h2>
          </div>
          <ul class="p-4 space-y-2 text-sm text-amber-900/80">
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              If SUD increases, more processing needed
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              New material may reveal additional targets
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Use standardized measures (UCLA, PCL-5)
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Collaborate on treatment priorities
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Document progress systematically
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              TICES log helps identify patterns
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-700 mt-1">&bull;</span>
              Plan termination when all targets complete
            </li>
          </ul>
        </div>

      </div>
    </div>

</PhaseLayout>
