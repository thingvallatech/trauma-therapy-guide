---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import { getCollection } from 'astro:content';

const allResources = await getCollection('resources');
const resources = allResources
  .filter((r) => r.data.audience === 'clinician' || r.data.audience === 'both')
  .sort((a, b) => b.data.dateAdded.getTime() - a.data.dateAdded.getTime());

// Gather all unique tags and types for filter UI
const allTags = [...new Set(resources.flatMap((r) => r.data.tags))].sort();
const allTypes = [...new Set(resources.map((r) => r.data.type))].sort();
---

<BaseLayout title="Resource Library" description="Curated resources for trauma therapists — books, articles, worksheets, and more.">
  <section class="py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="max-w-3xl mb-8">
        <nav class="text-sm text-charcoal/60 mb-4">
          <a href="/clinicians" class="hover:text-forest-600 transition-colors">Clinicians</a>
          <span class="mx-2">/</span>
          <span class="text-charcoal">Resource Library</span>
        </nav>
        <h1 class="font-serif text-4xl font-semibold text-charcoal mb-4">
          Resource Library
        </h1>
        <p class="text-lg text-charcoal/80 leading-relaxed">
          Curated books, articles, worksheets, and tools for trauma-informed practice.
        </p>
      </div>

      <!-- Search + Filters -->
      <div class="mb-8 space-y-4">
        <!-- Search -->
        <div class="max-w-md">
          <label for="resource-search" class="sr-only">Search resources</label>
          <input
            type="text"
            id="resource-search"
            placeholder="Search resources..."
            class="w-full px-4 py-2 border border-wood-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-forest-500 focus:border-forest-500 bg-white"
          />
        </div>

        <!-- Type filters -->
        <div class="flex flex-wrap gap-2" id="type-filters" role="group" aria-label="Filter by type">
          {allTypes.map((type) => (
            <button
              data-filter-type={type}
              aria-pressed="false"
              class="px-3 py-1 rounded-full text-sm font-medium border border-wood-200 text-charcoal/70 hover:border-forest-300 hover:text-forest-700 transition-colors cursor-pointer"
            >
              {type.charAt(0).toUpperCase() + type.slice(1)}
            </button>
          ))}
        </div>

        <!-- Tag filters -->
        <div class="flex flex-wrap gap-2" id="tag-filters" role="group" aria-label="Filter by tag">
          {allTags.map((tag) => (
            <button
              data-filter-tag={tag}
              aria-pressed="false"
              class="px-3 py-1 rounded-full text-xs border border-forest-100 text-forest-700 bg-forest-50 hover:bg-forest-500 hover:text-white transition-colors cursor-pointer"
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

      <!-- Resource count -->
      <p class="text-sm text-charcoal/60 mb-6" id="resource-count">
        {resources.length} resource{resources.length !== 1 ? 's' : ''}
      </p>

      <!-- Resource grid -->
      <div class="grid md:grid-cols-2 gap-6" id="resource-grid">
        {resources.map((resource) => {
          const description = resource.body || '';
          return (
            <ResourceCard
              title={resource.data.title}
              type={resource.data.type}
              audience={resource.data.audience}
              tags={resource.data.tags}
              url={resource.data.url}
              fileUrl={resource.data.fileUrl}
              author={resource.data.author}
              description={description.trim()}
            />
          );
        })}
      </div>

      <!-- Empty state -->
      <div class="hidden text-center py-12" id="no-results">
        <p class="text-charcoal/60">No resources match your filters.</p>
        <button
          id="clear-filters"
          class="mt-2 text-sm text-forest-600 hover:text-forest-500 underline cursor-pointer"
        >
          Clear all filters
        </button>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('resource-search') as HTMLInputElement;
    const grid = document.getElementById('resource-grid')!;
    const cards = Array.from(grid.children) as HTMLElement[];
    const countEl = document.getElementById('resource-count')!;
    const noResults = document.getElementById('no-results')!;
    const clearBtn = document.getElementById('clear-filters')!;

    let activeTypes = new Set<string>();
    let activeTags = new Set<string>();

    function filterCards() {
      const query = searchInput.value.toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';
        const type = card.getAttribute('data-type') || '';
        const tags: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');

        const matchesSearch = !query || title.includes(query) || description.includes(query) || tags.some((t) => t.includes(query));
        const matchesType = activeTypes.size === 0 || activeTypes.has(type);
        const matchesTags = activeTags.size === 0 || tags.some((t) => activeTags.has(t));

        if (matchesSearch && matchesType && matchesTags) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      countEl.textContent = `${visible} resource${visible !== 1 ? 's' : ''}`;
      noResults.classList.toggle('hidden', visible > 0);
      grid.classList.toggle('hidden', visible === 0);
    }

    // Search
    searchInput.addEventListener('input', filterCards);

    // Type filter buttons
    document.querySelectorAll('[data-filter-type]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-filter-type')!;
        if (activeTypes.has(type)) {
          activeTypes.delete(type);
          btn.classList.remove('bg-forest-500', 'text-white', 'border-forest-500');
          btn.classList.add('border-wood-200', 'text-charcoal/70');
          btn.setAttribute('aria-pressed', 'false');
        } else {
          activeTypes.add(type);
          btn.classList.add('bg-forest-500', 'text-white', 'border-forest-500');
          btn.classList.remove('border-wood-200', 'text-charcoal/70');
          btn.setAttribute('aria-pressed', 'true');
        }
        filterCards();
      });
    });

    // Tag filter buttons
    document.querySelectorAll('[data-filter-tag]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-filter-tag')!;
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          btn.classList.remove('bg-forest-500', 'text-white');
          btn.classList.add('bg-forest-50', 'text-forest-700');
          btn.setAttribute('aria-pressed', 'false');
        } else {
          activeTags.add(tag);
          btn.classList.add('bg-forest-500', 'text-white');
          btn.classList.remove('bg-forest-50', 'text-forest-700');
          btn.setAttribute('aria-pressed', 'true');
        }
        filterCards();
      });
    });

    // Clear all
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      activeTypes.clear();
      activeTags.clear();
      document.querySelectorAll('[data-filter-type]').forEach((btn) => {
        btn.classList.remove('bg-forest-500', 'text-white', 'border-forest-500');
        btn.classList.add('border-wood-200', 'text-charcoal/70');
        btn.setAttribute('aria-pressed', 'false');
      });
      document.querySelectorAll('[data-filter-tag]').forEach((btn) => {
        btn.classList.remove('bg-forest-500', 'text-white');
        btn.classList.add('bg-forest-50', 'text-forest-700');
        btn.setAttribute('aria-pressed', 'false');
      });
      filterCards();
    });
  </script>
</BaseLayout>
