---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="For Clinicians" description="Quick reference guides for trauma therapists using evidence-based protocols.">
  <div class="clin-hub">
    <header class="clin-hero">
      <p class="clin-kicker">For trained clinicians</p>
      <h1 class="clin-h1">Reference between <em>sessions</em>.</h1>
      <p class="clin-lede">
        Quick-reference guides for evidence-based trauma protocols. Designed for trained therapists who need a refresher — not a replacement for training and supervision.
      </p>
    </header>

    <section class="clin-feature" aria-label="EMDR — available now">
      <div class="clin-feature-meta">
        <span class="clin-tag">Available now</span>
        <span class="clin-stat">8 phases · scripts · printable worksheets</span>
      </div>
      <a href="/clinicians/emdr" class="clin-feature-card">
        <div>
          <h2>EMDR · 8-phase protocol</h2>
          <p>The complete reference: history, preparation, assessment, desensitization, installation, body scan, closure, reevaluation. Scripts and clinical considerations on every phase.</p>
        </div>
        <span class="clin-feature-cta">Open EMDR →</span>
      </a>
    </section>

    <section class="clin-row" aria-label="Other clinician resources">
      <a href="/clinicians/resources" class="clin-mini">
        <h3>Resource library</h3>
        <p>Curated books, articles, worksheets, and tools for trauma-informed practice.</p>
      </a>
      <a href="/clinicians/emdr/tools" class="clin-mini">
        <h3>Interactive tools</h3>
        <p>BLS (visual / audio / combined), SUD &amp; VOC scales, container, safe place, breath pacer. Includes fullscreen for in-session use.</p>
      </a>
      <a href="/clinicians/emdr/print-package" class="clin-mini">
        <h3>Print package</h3>
        <p>Every phase, every script, every worksheet — printable as one PDF for between-session reference.</p>
      </a>
    </section>

    <section class="clin-coming" aria-label="In development">
      <h2 class="clin-h2">In development</h2>
      <ol class="clin-coming-list">
        <li>
          <div class="code">TF-CBT</div>
          <div class="name">Trauma-Focused Cognitive Behavioral Therapy<small>Cohen, Mannarino, Deblinger — children &amp; adolescents</small></div>
          <div class="stat">Planned</div>
        </li>
        <li>
          <div class="code">PCIT</div>
          <div class="name">Parent-Child Interaction Therapy<small>Behavioral / attachment — early childhood</small></div>
          <div class="stat">Planned</div>
        </li>
      </ol>
    </section>

    <section class="clin-how" aria-labelledby="how-h">
      <h2 id="how-h" class="clin-h2">How to use these guides</h2>
      <p>
        These reference guides are designed to support your clinical practice — not replace formal training. They assume you have completed appropriate training in each protocol.
      </p>
      <ul>
        <li>Use as a quick refresher before sessions.</li>
        <li>Reference key scripts and assessment questions.</li>
        <li>Review clinical considerations and common challenges.</li>
        <li>Access phase-by-phase guidance during consultation.</li>
      </ul>
      <p class="clin-small">Always follow your training, supervision guidance, and professional judgment when implementing any protocol.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .clin-hub {
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    max-width: 980px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    line-height: 1.6;
  }

  .clin-hero { margin-bottom: 36px; max-width: 60ch; }
  .clin-kicker {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin: 0 0 14px;
  }
  .clin-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    max-width: 18ch;
  }
  .clin-h1 em { font-style: italic; color: var(--color-deep-forest, #2d4a32); }
  .clin-lede { font-size: 17px; color: var(--color-ink-2); margin: 0; }

  .clin-feature { margin: 36px 0; }
  .clin-feature-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .clin-tag {
    background: var(--color-copper);
    color: #fff;
    padding: 4px 10px;
    border-radius: 999px;
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .clin-stat {
    font: 500 11.5px/1 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .clin-feature-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: end;
    padding: 28px 30px;
    background: var(--color-deep-forest, #2d4a32);
    color: #eaf0e1;
    border-radius: 18px;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .clin-feature-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 30px rgba(20, 30, 20, 0.18);
  }
  .clin-feature-card h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
    color: #f1efe6;
  }
  .clin-feature-card p {
    margin: 0;
    color: #c0cfbe;
    max-width: 50ch;
    font-size: 14.5px;
  }
  .clin-feature-cta {
    font: 500 13px/1 var(--font-mono);
    color: #f2dca0;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .clin-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 28px 0;
  }
  .clin-mini {
    display: block;
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    border-radius: 14px;
    padding: 18px 18px 20px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  .clin-mini:hover {
    border-color: var(--color-copper);
    box-shadow: 0 6px 20px rgba(20, 20, 10, 0.06);
  }
  .clin-mini h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    margin: 0 0 6px;
    color: var(--color-ink);
  }
  .clin-mini p {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .clin-coming { margin: 40px 0; }
  .clin-h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    color: var(--color-ink);
  }
  .clin-coming-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .clin-coming-list li {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--color-line, #e5e1d6);
    align-items: center;
  }
  .clin-coming-list li:last-child { border-bottom: 1px solid var(--color-line, #e5e1d6); }
  .clin-coming-list .code {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--color-muted);
    letter-spacing: -0.005em;
  }
  .clin-coming-list .name { font-size: 14.5px; color: var(--color-ink-2); }
  .clin-coming-list .name small {
    display: block;
    color: var(--color-muted);
    font-size: 12.5px;
    margin-top: 2px;
  }
  .clin-coming-list .stat {
    font: 500 11px/1 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .clin-how {
    background: var(--color-paper-2);
    border: 1px solid var(--color-line, #e5e1d6);
    border-radius: 14px;
    padding: 24px 26px 26px;
    margin-top: 40px;
  }
  .clin-how p { color: var(--color-ink-2); font-size: 15px; margin: 0 0 12px; }
  .clin-how ul {
    margin: 0 0 12px;
    padding-left: 22px;
    color: var(--color-ink-2);
    font-size: 15px;
  }
  .clin-how ul li { margin: 4px 0; }
  .clin-small { color: var(--color-muted); font-size: 13.5px; margin: 0 !important; }

  @media (max-width: 768px) {
    .clin-hub { padding: 24px 16px 56px; }
    .clin-feature-card { grid-template-columns: 1fr; }
    .clin-feature-cta { justify-self: start; }
    .clin-row { grid-template-columns: 1fr; }
    .clin-coming-list li { grid-template-columns: 60px 1fr; gap: 12px; }
    .clin-coming-list .stat { grid-column: 2; }
  }
</style>
