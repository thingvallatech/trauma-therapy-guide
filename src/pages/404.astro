---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." noIndex>
  <section class="py-16 sm:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-mono uppercase tracking-widest text-bronze-500 mb-4">404</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold mb-4">Page not found</h1>
      <p class="mb-2">
        The page you were looking for doesn't exist or has moved.
      </p>
      <p class="text-sm mb-10" lang="es">
        La página que buscas no existe o se ha movido.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="px-4 py-2 rounded-md bg-bronze-500 text-forest-900 font-medium hover:bg-bronze-400 transition-colors">Home</a>
        <a href="/clinicians" class="px-4 py-2 rounded-md border border-forest-600 hover:border-bronze-500 transition-colors">Clinicians</a>
        <a href="/families" class="px-4 py-2 rounded-md border border-forest-600 hover:border-bronze-500 transition-colors">Families</a>
        <a href="/es/" class="px-4 py-2 rounded-md border border-forest-600 hover:border-bronze-500 transition-colors" lang="es">Inicio en español</a>
      </div>
      <p class="mt-12 text-sm">
        In crisis right now? <a href="/help" class="underline">Crisis help</a> · Call or text <a href="tel:988" class="underline">988</a>
      </p>
    </div>
  </section>
</BaseLayout>
