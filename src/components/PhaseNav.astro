---
interface Props {
  currentPhase: number;
  totalPhases?: number;
}

const { currentPhase, totalPhases = 8 } = Astro.props;

const phases = [
  { num: 1, shortTitle: 'History' },
  { num: 2, shortTitle: 'Preparation' },
  { num: 3, shortTitle: 'Assessment' },
  { num: 4, shortTitle: 'Desensitization' },
  { num: 5, shortTitle: 'Installation' },
  { num: 6, shortTitle: 'Body Scan' },
  { num: 7, shortTitle: 'Closure' },
  { num: 8, shortTitle: 'Reevaluation' },
];

const prevPhase = currentPhase > 1 ? phases[currentPhase - 2] : null;
const nextPhase = currentPhase < totalPhases ? phases[currentPhase] : null;
---

<!-- Phase Progress Indicator -->
<div class="flex justify-center items-center gap-1.5 mt-10 mb-4" aria-label={`Phase ${currentPhase} of ${totalPhases}`}>
  {phases.map((phase) => (
    <a
      href={`/clinicians/emdr/phase-${phase.num}`}
      class:list={[
        'w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-all',
        phase.num === currentPhase
          ? 'bg-bronze-500 text-forest-900'
          : 'bg-forest-700 text-forest-400 hover:bg-forest-600 hover:text-forest-200'
      ]}
      title={`Phase ${phase.num}: ${phase.shortTitle}`}
      aria-current={phase.num === currentPhase ? 'step' : undefined}
    >
      {phase.num}
    </a>
  ))}
</div>

<nav class="flex justify-between items-center py-6 border-t border-forest-600">
  {prevPhase ? (
    <a
      href={`/clinicians/emdr/phase-${prevPhase.num}`}
      class="flex items-center gap-2 text-forest-300 hover:text-bronze-400 transition-colors group"
    >
      <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span class="text-sm">
        <span class="block text-forest-400 text-xs">Previous</span>
        <span class="font-medium">Phase {prevPhase.num}: {prevPhase.shortTitle}</span>
      </span>
    </a>
  ) : (
    <div></div>
  )}

  <a
    href="/clinicians/emdr"
    class="text-sm text-forest-400 hover:text-bronze-400 transition-colors"
  >
    All Phases
  </a>

  {nextPhase ? (
    <a
      href={`/clinicians/emdr/phase-${nextPhase.num}`}
      class="flex items-center gap-2 text-forest-300 hover:text-bronze-400 transition-colors group text-right"
    >
      <span class="text-sm">
        <span class="block text-forest-400 text-xs">Next</span>
        <span class="font-medium">Phase {nextPhase.num}: {nextPhase.shortTitle}</span>
      </span>
      <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  ) : (
    <div></div>
  )}
</nav>
