---
import { useTranslations, useTranslatedPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const smsBody = lang === 'es' ? 'HOLA' : 'HELLO';
const smsHref = `sms:741741&body=${smsBody}`;
const aboutHref = translatePath('/about');
---

<section
  class="crisis-strip"
  id="crisis-resources"
  role="region"
  aria-label={t('crisis.regionLabel')}
>
  <div class="crisis-strip-row">
    <span class="crisis-strip-ico" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2 14 9l7 1-5 5 1.5 7L12 18l-5.5 4L8 15 3 10l7-1z"/>
      </svg>
    </span>
    <div class="crisis-strip-text">
      <b>{t('crisis.inline')}</b>
      <span>{t('crisis.numbers')}</span>
    </div>
    <a class="crisis-strip-cta" href={aboutHref}>{t('crisis.cta')} ›</a>
  </div>

  <div class="crisis-strip-mobile">
    <p class="crisis-strip-mobile-title"><b>{t('crisis.mobileTitle')}</b></p>
    <div class="crisis-strip-mobile-row">
      <a href="tel:988" aria-label="Call 988">
        <span aria-hidden="true">📞</span>
        <span>988</span>
      </a>
      <a href={smsHref} aria-label={`Text ${smsBody} to 741741`}>
        <span aria-hidden="true">💬</span>
        <span>741741</span>
      </a>
      <a href="tel:911" aria-label="Call 911">
        <span aria-hidden="true">🚨</span>
        <span>911</span>
      </a>
    </div>
  </div>
</section>

<style>
  .crisis-strip {
    background: #2d4a32;
    color: #eaf0e1;
    border-radius: 14px;
    overflow: hidden;
  }

  /* Desktop layout: text + numbers + CTA */
  .crisis-strip-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 22px;
  }
  .crisis-strip-ico {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #3f5d42;
    color: #f2dca0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .crisis-strip-text {
    font-size: 13px;
    line-height: 1.4;
  }
  .crisis-strip-text b {
    display: block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 2px;
  }
  .crisis-strip-cta {
    font-size: 12px;
    color: #f2dca0;
    background: #1f3523;
    padding: 8px 14px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    font-weight: 500;
    transition: background-color 0.12s;
  }
  .crisis-strip-cta:hover {
    background: #142a18;
  }

  /* Mobile layout: three big tap targets */
  .crisis-strip-mobile {
    display: none;
    padding: 14px 16px;
  }
  .crisis-strip-mobile-title {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.3;
  }
  .crisis-strip-mobile-row {
    display: flex;
    gap: 8px;
  }
  .crisis-strip-mobile-row a {
    flex: 1;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #1f3523;
    color: #f2dca0;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    padding: 10px 8px;
  }
  .crisis-strip-mobile-row a:hover {
    background: #142a18;
  }

  @media (max-width: 640px) {
    .crisis-strip-row {
      display: none;
    }
    .crisis-strip-mobile {
      display: block;
    }
  }
</style>
