---
interface Props {
  title: string;
  type: 'book' | 'pdf' | 'article' | 'video' | 'worksheet' | 'link';
  audience: 'clinician' | 'family' | 'both';
  tags: string[];
  url: string;
  fileUrl: string;
  author: string;
  description: string;
}

const { title, type, tags, url, fileUrl, author, description } = Astro.props;

const href = fileUrl || url;
const isDownload = !!fileUrl && !url;

const typeIcons: Record<string, { label: string; path: string }> = {
  book: {
    label: 'Book',
    path: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  pdf: {
    label: 'PDF',
    path: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  article: {
    label: 'Article',
    path: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
  },
  video: {
    label: 'Video',
    path: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  worksheet: {
    label: 'Worksheet',
    path: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  },
  link: {
    label: 'Link',
    path: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
  },
};

const icon = typeIcons[type] || typeIcons.link;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="block bg-forest-800 border border-forest-600 rounded-lg p-6 hover:border-forest-500 hover:bg-forest-700 transition-all duration-200 group"
  data-tags={JSON.stringify(tags)}
  data-type={type}
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
>
  <div class="flex items-start gap-4">
    <!-- Type icon -->
    <div class="w-10 h-10 bg-forest-700 rounded-lg flex items-center justify-center flex-shrink-0">
      <svg class="w-5 h-5 text-bronze-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon.path} />
      </svg>
    </div>

    <div class="flex-1 min-w-0">
      <!-- Title + external link icon -->
      <h3 class="font-serif text-lg font-semibold text-forest-100 mb-1 group-hover:text-bronze-400 transition-colors">
        {title}
        <svg class="w-4 h-4 inline-block ml-1 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </h3>

      <!-- Author -->
      {author && (
        <p class="text-sm text-forest-400 mb-2">by {author}</p>
      )}

      <!-- Description -->
      <p class="text-forest-200 text-sm leading-relaxed mb-3 line-clamp-2">
        {description}
      </p>

      <!-- Tags + type label -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-forest-700 text-bronze-400 rounded text-xs font-medium">
          {icon.label}
        </span>
        {tags.map((tag) => (
          <span class="px-2 py-0.5 bg-forest-700 text-forest-300 rounded-full text-xs">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</a>
