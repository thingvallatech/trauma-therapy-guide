---
// SearchModal.astro — Site-wide search overlay
// Opens via Cmd/Ctrl+K or the search button in Header
// Client-side filtering against a page index with locale-appropriate URLs
import { activityContent } from '../lib/activity-content';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const tools = await getCollection('tools', (tool) => tool.data.locale === lang);
const toolPages = tools.map((tool) => ({
  title: activityContent(tool.slug.replace(/es$/, ''), lang)?.name ?? tool.data.name,
  url: translatePath(`/tools/${tool.slug.replace(/es$/, '')}`),
  description: `${tool.data.name}: ${tool.data.shortDescription}`,
  section: t('search.sectionTools'),
}));

const pages = [
  { title: t('search.page.home'), url: translatePath('/'), description: t('search.page.homeDesc'), section: t('search.sectionGeneral') },
  { title: t('search.page.help'), url: translatePath('/help'), description: t('search.page.helpDesc'), section: t('search.sectionGeneral') },
  { title: t('search.page.about'), url: translatePath('/about'), description: t('search.page.aboutDesc'), section: t('search.sectionGeneral') },
  { title: t('search.page.toolsHub'), url: translatePath('/tools'), description: t('search.page.toolsHubDesc'), section: t('search.sectionTools') },
  ...toolPages,
  { title: t('search.page.clinicians'), url: translatePath('/clinicians'), description: t('search.page.cliniciansDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.emdrOverview'), url: translatePath('/clinicians/emdr'), description: t('search.page.emdrOverviewDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase1'), url: translatePath('/clinicians/emdr/phase-1'), description: t('search.page.phase1Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase2'), url: translatePath('/clinicians/emdr/phase-2'), description: t('search.page.phase2Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase3'), url: translatePath('/clinicians/emdr/phase-3'), description: t('search.page.phase3Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase4'), url: translatePath('/clinicians/emdr/phase-4'), description: t('search.page.phase4Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase5'), url: translatePath('/clinicians/emdr/phase-5'), description: t('search.page.phase5Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase6'), url: translatePath('/clinicians/emdr/phase-6'), description: t('search.page.phase6Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase7'), url: translatePath('/clinicians/emdr/phase-7'), description: t('search.page.phase7Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase8'), url: translatePath('/clinicians/emdr/phase-8'), description: t('search.page.phase8Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.clinicianResources'), url: translatePath('/clinicians/resources'), description: t('search.page.clinicianResourcesDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.printPackage'), url: translatePath('/clinicians/emdr/print-package'), description: t('search.page.printPackageDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.families'), url: translatePath('/families'), description: t('search.page.familiesDesc'), section: t('search.sectionFamilies') },
  { title: t('search.page.familyEmdr'), url: translatePath('/families/emdr'), description: t('search.page.familyEmdrDesc'), section: t('search.sectionFamilies') },
  { title: t('search.page.familyTfcbt'), url: translatePath('/families/tfcbt'), description: t('search.page.familyTfcbtDesc'), section: t('search.sectionFamilies') },
  { title: t('search.page.familyResources'), url: translatePath('/families/resources'), description: t('search.page.familyResourcesDesc'), section: t('search.sectionFamilies') },
];


const es = lang === 'es';
const handouts = [
  ['intake-form', 'Intake form and history', 'Evaluación inicial e historia clínica', 'intake assessment history form worksheet evaluation inicial formulario historia'],
  ...[2,3,4,5,6,7,8].map(n => [`phase-${n}-scripts`, `Phase ${n} ${['', '', 'preparation', 'assessment', 'desensitization', 'installation', 'body scan', 'closure', 'reevaluation'][n]} scripts`, `Guiones de la fase ${n}: ${['', '', 'preparación', 'evaluación', 'desensibilización', 'instalación', 'escaneo corporal', 'cierre', 'reevaluación'][n]}`, 'script handout worksheet print guion imprimir hoja']),
  ['phase-2-resource-breathing', 'Breathing preparation script', 'Guion de respiración', 'breath breathe respirar respiracion preparation script'],
  ['phase-2-resource-container', 'Container preparation script', 'Guion del contenedor', 'worries container preocupacion contenedor preparation script'],
  ['phase-2-resource-lightstream', 'Lightstream preparation script', 'Guion del haz de luz', 'lightstream light luz preparation script'],
  ['phase-2-resource-safe-place', 'Calm place preparation script', 'Guion del lugar tranquilo', 'safe calm safeplace lugar tranquilo seguro preparation script'],
];
const toolKeywords: Record<string, string> = {
  breath: 'breathing breathe anxious anxiety nervous stress respirar respiracion nervios ansiedad',
  grounding: 'panic overwhelmed here now senses calm panico abrumado sentidos anclaje presente',
  'feeling-wheel': 'feel feeling emotions name sad angry emocion emociones sentimiento tristeza enojo',
  'safe-place': 'imagine calm place safe tranquilo imaginar lugar seguro',
  container: 'worry worries pause set aside preocupaciones pausa contenedor',
  sandtray: 'play scene build create figures juego escena construir crear figuras',
  sud: 'distress scale rating upset malestar escala intensidad',
};
const resources = await getCollection('resources', resource => resource.data.locale === lang);
const resourcePages = resources.map(resource => ({ title: resource.data.title, description: resource.body.slice(0, 200), keywords: `${resource.data.author} ${resource.data.tags.join(' ')}`, section: lang === 'es' ? 'Biblioteca' : 'Library', url: translatePath(`/${resource.data.audience === 'family' ? 'families' : 'clinicians'}/resources`) + `#res-${resource.slug}` }));
const searchIndex = [
  ...pages.map(page => ({ ...page, keywords: toolKeywords[page.url.split('/').pop() ?? ''] ?? '' })),
  ...handouts.map(([route, en, esTitle, keywords]) => ({ title: es ? esTitle : en, description: es ? 'Material clínico imprimible para profesionales con formación.' : 'Printable clinical reference for trained professionals.', url: translatePath(`/clinicians/emdr/${route}`), section: t('search.sectionClinicians'), keywords })),
  ...resourcePages,
];
---
<dialog id="search-modal" aria-labelledby="search-title" data-pages={JSON.stringify(searchIndex)}>
  <div class="search-panel">
    <div class="search-heading">
      <h2 id="search-title">{t('nav.searchSite')}</h2>
      <button type="button" data-search-close aria-label={es ? 'Cerrar búsqueda' : 'Close search'}>{es ? 'Cerrar' : 'Close'} ×</button>
    </div>
    <label for="search-input">{es ? 'Busca actividades, guías o materiales' : 'Find activities, guides or handouts'}</label>
    <input id="search-input" type="search" placeholder={t('search.placeholder')} autocomplete="off" />
    <p id="search-status" role="status" aria-live="polite"></p>
    <ul id="search-results"></ul>
    <a class="search-browse" href={translatePath('/tools')}>{es ? 'Explorar todas las actividades' : 'Browse all activities'}</a>
  </div>
</dialog>
<script>
  import '../scripts/search-dialog';
</script>
<style is:global>
  #search-modal { width: min(640px, calc(100% - 24px)); max-height: calc(100dvh - 32px); margin: 16px auto; border: 1px solid #ded2b6; border-radius: 16px; background: #fdfaf5; color: #2a2a1e; padding: 0; }
  #search-modal::backdrop { background: rgb(10 31 10 / .8); }
  .search-panel { padding: 20px; }
  .search-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .search-heading button { min-height: 44px; padding: 8px 12px; border: 1px solid #6b6455; border-radius: 8px; }
  #search-modal label { display: block; font-size: 14px; margin-bottom: 6px; }
  #search-input { width: 100%; min-width: 0; font-size: 16px; padding: 12px; border: 1px solid #6b6455; border-radius: 8px; background: white; color: #2a2a1e; }
  #search-input::placeholder { color: #6b6455; }
  #search-status { font-size: 13px; margin: 12px 0; color: #4f4a3d; }
  #search-results { list-style: none; padding: 0; }
  .search-result { display: flex; flex-direction: column; padding: 12px 8px; border-top: 1px solid #ded2b6; text-decoration: none; color: #2a2a1e; }
  .search-result:hover, .search-result:focus { background: #efeadd; }
  .search-result span { font-size: 14px; color: #4f4a3d; }
  .search-result small { margin-top: 4px; color: #6b6455; }
  .search-browse { display: inline-block; padding-block: 12px; color: #1f3523; text-decoration: underline; }
</style>
