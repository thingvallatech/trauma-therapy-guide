---
// SearchModal.astro — Site-wide search overlay
// Opens via Cmd/Ctrl+K or the search button in Header
// Client-side filtering against a page index with locale-appropriate URLs
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pages = [
  { title: t('search.page.home'), url: translatePath('/'), description: t('search.page.homeDesc'), section: t('search.sectionGeneral') },
  { title: t('search.page.about'), url: translatePath('/about'), description: t('search.page.aboutDesc'), section: t('search.sectionGeneral') },
  { title: t('search.page.clinicians'), url: translatePath('/clinicians'), description: t('search.page.cliniciansDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.emdrOverview'), url: translatePath('/clinicians/emdr'), description: t('search.page.emdrOverviewDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase1'), url: translatePath('/clinicians/emdr/phase-1'), description: t('search.page.phase1Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase2'), url: translatePath('/clinicians/emdr/phase-2'), description: t('search.page.phase2Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase3'), url: translatePath('/clinicians/emdr/phase-3'), description: t('search.page.phase3Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase4'), url: translatePath('/clinicians/emdr/phase-4'), description: t('search.page.phase4Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase5'), url: translatePath('/clinicians/emdr/phase-5'), description: t('search.page.phase5Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase6'), url: translatePath('/clinicians/emdr/phase-6'), description: t('search.page.phase6Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase7'), url: translatePath('/clinicians/emdr/phase-7'), description: t('search.page.phase7Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.phase8'), url: translatePath('/clinicians/emdr/phase-8'), description: t('search.page.phase8Desc'), section: t('search.sectionClinicians') },
  { title: t('search.page.clinicianResources'), url: translatePath('/clinicians/resources'), description: t('search.page.clinicianResourcesDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.printPackage'), url: translatePath('/clinicians/emdr/print-package'), description: t('search.page.printPackageDesc'), section: t('search.sectionClinicians') },
  { title: t('search.page.families'), url: translatePath('/families'), description: t('search.page.familiesDesc'), section: t('search.sectionFamilies') },
  { title: t('search.page.familyEmdr'), url: translatePath('/families/emdr'), description: t('search.page.familyEmdrDesc'), section: t('search.sectionFamilies') },
  { title: t('search.page.familyTfcbt'), url: translatePath('/families/tfcbt'), description: t('search.page.familyTfcbtDesc'), section: t('search.sectionFamilies') },
  { title: t('search.page.familyResources'), url: translatePath('/families/resources'), description: t('search.page.familyResourcesDesc'), section: t('search.sectionFamilies') },
];

const placeholderText = t('search.placeholder');
const noResultsText = t('search.noResults');
const hintText = t('search.hint');
const sectionClinicians = t('search.sectionClinicians');
const sectionFamilies = t('search.sectionFamilies');
---

<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label={t('nav.searchSite')}>
  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-forest-900/80 backdrop-blur-sm"></div>

  <!-- Modal -->
  <div class="relative flex justify-center px-4 pt-[15vh]">
    <div class="w-full max-w-lg bg-cream border border-linen rounded-xl shadow-2xl overflow-hidden">
      <!-- Search input -->
      <div class="flex items-center gap-3 px-4 border-b border-linen">
        <svg class="w-5 h-5 text-forest-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder={placeholderText}
          autocomplete="off"
          class="flex-1 bg-sand py-3.5 text-charcoal placeholder:text-forest-400 text-sm outline-none rounded px-2"
        />
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-forest-500 bg-sand border border-linen rounded">ESC</kbd>
      </div>

      <!-- Results -->
      <ul id="search-results" class="max-h-[360px] overflow-y-auto py-2">
        <!-- Populated by JS -->
      </ul>

      <!-- Empty state -->
      <div id="search-empty" class="hidden px-4 py-8 text-center text-forest-500 text-sm">
        {noResultsText}
      </div>

      <!-- Initial hint -->
      <div id="search-hint" class="px-4 py-8 text-center text-forest-500 text-sm">
        {hintText}
      </div>
    </div>
  </div>
</div>

<script define:vars={{ pages, sectionClinicians, sectionFamilies }}>
  const PAGES = pages;
  const MAX_RESULTS = 8;

  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input');
  const resultsList = document.getElementById('search-results');
  const emptyState = document.getElementById('search-empty');
  const hintState = document.getElementById('search-hint');

  let activeIndex = -1;
  let currentResults = [];

  function openSearch() {
    modal.classList.remove('hidden');
    input.value = '';
    activeIndex = -1;
    currentResults = [];
    resultsList.innerHTML = '';
    emptyState.classList.add('hidden');
    hintState.classList.remove('hidden');
    requestAnimationFrame(() => input.focus());
    document.body.style.overflow = 'hidden';
  }

  function closeSearch() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function sectionColor(section) {
    if (section === sectionClinicians) return 'bg-forest-50 text-bronze-600';
    if (section === sectionFamilies) return 'bg-amber-50 text-amber-700';
    return 'bg-sand text-forest-600';
  }

  function renderResults(results) {
    currentResults = results;
    activeIndex = -1;

    if (input.value.trim() === '') {
      resultsList.innerHTML = '';
      emptyState.classList.add('hidden');
      hintState.classList.remove('hidden');
      return;
    }

    hintState.classList.add('hidden');

    if (results.length === 0) {
      resultsList.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    resultsList.innerHTML = results.map((page, i) => `
      <li>
        <a
          href="${page.url}"
          class="search-result flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-sand cursor-pointer"
          data-index="${i}"
        >
          <div class="flex-1 min-w-0">
            <div class="text-sm font-medium text-forest-900 truncate">${highlight(page.title, input.value)}</div>
            <div class="text-xs text-forest-500 truncate mt-0.5">${highlight(page.description, input.value)}</div>
          </div>
          <span class="shrink-0 text-[10px] font-medium px-2 py-0.5 rounded-full ${sectionColor(page.section)}">${page.section}</span>
        </a>
      </li>
    `).join('');
  }

  function highlight(text, query) {
    if (!query.trim()) return text;
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp(`(${escaped})`, 'gi');
    return text.replace(re, '<mark class="bg-bronze-200/40 text-bronze-700 rounded px-0.5">$1</mark>');
  }

  function setActive(index) {
    const items = resultsList.querySelectorAll('.search-result');
    items.forEach((el, i) => {
      if (i === index) {
        el.classList.add('bg-sand', 'border-l-2', 'border-bronze-600');
        el.scrollIntoView({ block: 'nearest' });
      } else {
        el.classList.remove('bg-sand', 'border-l-2', 'border-bronze-600');
      }
    });
    activeIndex = index;
  }

  function search(query) {
    const q = query.toLowerCase().trim();
    if (!q) {
      renderResults([]);
      return;
    }
    const results = PAGES.filter(page =>
      page.title.toLowerCase().includes(q) ||
      page.description.toLowerCase().includes(q) ||
      page.section.toLowerCase().includes(q)
    ).slice(0, MAX_RESULTS);
    renderResults(results);
  }

  input.addEventListener('input', () => search(input.value));

  input.addEventListener('keydown', (e) => {
    const count = currentResults.length;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (count > 0) setActive((activeIndex + 1) % count);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (count > 0) setActive(activeIndex <= 0 ? count - 1 : activeIndex - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (activeIndex >= 0 && currentResults[activeIndex]) {
        window.location.href = currentResults[activeIndex].url;
      }
    } else if (e.key === 'Escape') {
      closeSearch();
    }
  });

  backdrop.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (modal.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeSearch();
    }
  });

  window.__openSearch = openSearch;
</script>
