---
import type { Lang } from '../../i18n';
import ToolSettings from './ToolSettings.astro';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
  warnings?: string[];
}

const { fullscreen = false, lang = 'en', warnings = [] } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-2xl mx-auto p-8 flex flex-col items-center justify-center"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600 flex flex-col items-center";

const t = {
  en: {
    patternBox: 'Box (4-4-4-4)',
    pattern478: '4-7-8',
    patternCoherent: 'Coherent (5-5)',
    ready: 'Ready',
    start: 'Start',
    stop: 'Stop',
    phaseNames: { Inhale: 'Inhale', Hold: 'Hold', Exhale: 'Exhale' },
  },
  es: {
    patternBox: 'Caja (4-4-4-4)',
    pattern478: '4-7-8',
    patternCoherent: 'Coherente (5-5)',
    ready: 'Listo',
    start: 'Comenzar',
    stop: 'Detener',
    phaseNames: { Inhale: 'Inhala', Hold: 'Sostén', Exhale: 'Exhala' },
  },
};

const s = t[lang];
---

<div class:list={[containerClass]} data-breath-widget data-breath-i18n={JSON.stringify({
  phaseNames: s.phaseNames,
  ready: s.ready,
  start: s.start,
  stop: s.stop,
})}>
  {/*
    The standard tool page renders these above the widget via ToolShell, but the
    fullscreen route renders the widget alone — so the warnings have to travel
    with it or they would vanish exactly where the tool is used in session.
  */}
  {fullscreen && warnings.length > 0 && (
    <div class="mb-2 p-2 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs w-full max-w-md">
      <ul class="list-disc list-inside space-y-1">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  )}

  <div class="w-full max-w-md">
    <ToolSettings componentName="BreathPacer" lang={lang} startOpen={!fullscreen} />
  </div>

  <div class="mb-4 flex flex-wrap gap-2 justify-center">
    <button data-breath-pattern="box" class="px-3 py-1.5 rounded-md bg-forest-700 border border-forest-600 text-forest-100 text-sm hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800 disabled:opacity-50 disabled:cursor-not-allowed">
      {s.patternBox}
    </button>
    <button data-breath-pattern="478" class="px-3 py-1.5 rounded-md bg-forest-700 border border-forest-600 text-forest-100 text-sm hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800 disabled:opacity-50 disabled:cursor-not-allowed">
      {s.pattern478}
    </button>
    <button data-breath-pattern="coherent" class="px-3 py-1.5 rounded-md bg-forest-700 border border-forest-600 text-forest-100 text-sm hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800 disabled:opacity-50 disabled:cursor-not-allowed">
      {s.patternCoherent}
    </button>
  </div>

  <div class="mb-4 flex gap-2 justify-center">
    {[1, 3, 5, 10].map((m) => (
      <button data-breath-minutes={m} class="px-3 py-1 rounded-md bg-forest-700 border border-forest-600 text-forest-200 text-xs hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800 disabled:opacity-50 disabled:cursor-not-allowed">
        {m} min
      </button>
    ))}
  </div>

  {/*
    The zone's own backdrop, not the theme palette's — comes straight from the
    "Background" picker so an explicit choice there actually shows up (the
    palette still seeds it via `--tool-accent`/`--tool-field-bg` on selection,
    same as every other tool). Falls back to the default palette's black so
    there's no flash before JS runs.
  */}
  <div
    class="relative w-64 h-64 rounded-full flex items-center justify-center my-6"
    style="background: var(--tool-field-bg, #000000);"
  >
    <div
      data-breath-circle
      class="w-32 h-32 rounded-full border-2 transition-transform ease-in-out"
      style="background-color: color-mix(in srgb, var(--tool-accent, #FFC107) 30%, transparent); border-color: var(--tool-accent, #FFC107); transform: scale(1);"
    ></div>
    <div data-breath-phase aria-live="polite" class="absolute font-serif text-xl text-forest-100">{s.ready}</div>
  </div>

  <div data-breath-remaining class="text-forest-300 text-sm mb-4"></div>

  <button
    data-breath-toggle
    class="px-6 py-2 rounded-md bg-bronze-500 text-forest-900 font-semibold hover:bg-bronze-400 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
  >
    {s.start}
  </button>
</div>

<script>
  import { onReducedMotion } from '../../scripts/motion-pref';
  import { createSettingsController } from '../../scripts/tool-settings-controller';
  import { DEFAULT_VISUAL_OPTIONS } from '../../scripts/visual-engine';
  import {
    createAudioEngine, DEFAULT_AUDIO_OPTIONS, DEFAULT_AMBIENT_OPTIONS,
    type AmbientOptions,
  } from '../../scripts/audio-engine';

  const TOOL_ID = 'BreathPacer';

  /** Time to let `playCue('complete')`'s two-note resolve ring before suspending. */
  const END_CUE_TAIL_MS = 1200;

  type Phase = { name: string; seconds: number; scale: number };
  const patterns: Record<string, Phase[]> = {
    box: [
      { name: 'Inhale', seconds: 4, scale: 2 },
      { name: 'Hold', seconds: 4, scale: 2 },
      { name: 'Exhale', seconds: 4, scale: 1 },
      { name: 'Hold', seconds: 4, scale: 1 },
    ],
    '478': [
      { name: 'Inhale', seconds: 4, scale: 2 },
      { name: 'Hold', seconds: 7, scale: 2 },
      { name: 'Exhale', seconds: 8, scale: 1 },
    ],
    coherent: [
      { name: 'Inhale', seconds: 5, scale: 2 },
      { name: 'Exhale', seconds: 5, scale: 1 },
    ],
  };

  const DEFAULTS = {
    palette: 'default',
    // No canvas here, but the shared panel still renders palette/color/
    // background — carrying their defaults is what makes those controls
    // persist correctly even though this widget reads them straight from
    // `--tool-accent` / `--tool-field-bg` instead of a canvas.
    ...DEFAULT_VISUAL_OPTIONS,
    soundOn: false, // cue sounds are opt-in, not the point of this tool.
    endCue: true,
    ...DEFAULT_AUDIO_OPTIONS,
    ambient: DEFAULT_AMBIENT_OPTIONS.kind,
    ambientVolume: DEFAULT_AMBIENT_OPTIONS.volume,
    binauralBase: DEFAULT_AMBIENT_OPTIONS.binauralBase,
    binauralBeat: DEFAULT_AMBIENT_OPTIONS.binauralBeat,
  };

  const widgets = document.querySelectorAll<HTMLElement>('[data-breath-widget]');
  widgets.forEach((root) => {
    const circle = root.querySelector<HTMLElement>('[data-breath-circle]')!;
    const phaseLabel = root.querySelector<HTMLElement>('[data-breath-phase]')!;
    const remaining = root.querySelector<HTMLElement>('[data-breath-remaining]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-breath-toggle]')!;
    const optionBtns = root.querySelectorAll<HTMLButtonElement>('[data-breath-pattern], [data-breath-minutes]');

    // The controller owns the settings panel entirely: hydration, readouts,
    // palettes, presets, persistence, and reset. It hydrates during
    // construction, so `get()` already reflects stored prefs.
    const settings = createSettingsController(root, TOOL_ID, DEFAULTS);
    let prefs = settings.get();

    function applyColors(): void {
      root.style.setProperty('--tool-accent', prefs.color);
      root.style.setProperty('--tool-field-bg', prefs.background);
    }

    const audio = createAudioEngine();

    let lastAmbient: AmbientOptions | null = null;

    function pushAmbient(): void {
      const next: AmbientOptions = {
        kind: prefs.soundOn ? prefs.ambient : 'none',
        volume: prefs.ambientVolume,
        binauralBase: prefs.binauralBase,
        binauralBeat: prefs.binauralBeat,
      };
      // `setAmbient` treats any mention of binauralBase/binauralBeat as a
      // structural change and rebuilds the whole layer, so send only the
      // fields that actually moved — see BLSAudio for the full rationale.
      const patch: Partial<AmbientOptions> = {};
      if (!lastAmbient || lastAmbient.kind !== next.kind) patch.kind = next.kind;
      if (!lastAmbient || lastAmbient.volume !== next.volume) patch.volume = next.volume;
      if (!lastAmbient || lastAmbient.binauralBase !== next.binauralBase) {
        patch.binauralBase = next.binauralBase;
      }
      if (!lastAmbient || lastAmbient.binauralBeat !== next.binauralBeat) {
        patch.binauralBeat = next.binauralBeat;
      }
      lastAmbient = next;
      if (Object.keys(patch).length > 0) audio.setAmbient(patch);
    }

    function pushToEngines(): void {
      audio.setOptions({ volume: prefs.soundOn ? (prefs.volume as number) : 0 });
      pushAmbient();
    }

    // This tool never schedules sound ahead of time — every cue is a single
    // `playCue` fired live at a phase boundary — so unlike the bilateral
    // tools there is no audio-clock/wall-clock timebase to keep in sync,
    // only whether a context exists and is live enough to be worth
    // suspending.
    let audioLive = false;
    let suspendTimer = 0;

    async function startAudio(): Promise<void> {
      try {
        await audio.ensureStarted();
        audioLive = true;
      } catch {
        // Autoplay policy or an unavailable AudioContext. The session still
        // runs; it just stays silent.
      }
    }

    /**
     * `suspend()` stops every scheduled voice, so suspending the instant a
     * session ends would swallow a completion chime just queued. A manual
     * Stop still silences everything immediately (delayMs = 0).
     */
    function suspendAudio(delayMs: number): void {
      window.clearTimeout(suspendTimer);
      if (!audioLive) return;
      if (delayMs <= 0) {
        audio.suspend();
        return;
      }
      suspendTimer = window.setTimeout(() => audio.suspend(), delayMs);
    }

    // Read live rather than once at init, so an OS-level reduced-motion
    // change takes effect on the next phase boundary instead of needing a
    // reload. The reduced-motion path used to hardcode a flat 500ms fade
    // regardless of the phase's real duration — that throws away the pacing
    // information the animation exists to carry (an 8-second exhale would
    // finish fading a full 7.5 seconds early), so it now fades over the same
    // `p.seconds` as the scale animation it replaces; only the animated
    // property changes, not the timing.
    let reducedMotion = false;
    onReducedMotion((reduced) => { reducedMotion = reduced; });

    const i18n = JSON.parse(root.getAttribute('data-breath-i18n') || '{}');
    const phaseMap: Record<string, string> = i18n.phaseNames || {};
    const readyText: string = i18n.ready || 'Ready';
    const startText: string = i18n.start || 'Start';
    const stopText: string = i18n.stop || 'Stop';

    let currentPattern: Phase[] = patterns.box;
    let totalSeconds = 3 * 60;
    let running = false;
    let phaseIdx = 0;
    let phaseElapsed = 0;
    let totalElapsed = 0;
    let rafId = 0;
    let lastTs = 0;
    let lastRemainingText = '';

    function highlight(group: string, value: string) {
      root.querySelectorAll(`[data-breath-${group}]`).forEach((b) => {
        const active = b.getAttribute(`data-breath-${group}`) === value;
        b.classList.toggle('bg-bronze-600', active);
        b.classList.toggle('text-forest-900', active);
      });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-breath-pattern]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (running) return;
        const key = btn.getAttribute('data-breath-pattern')!;
        currentPattern = patterns[key];
        highlight('pattern', key);
      });
    });
    highlight('pattern', 'box');

    root.querySelectorAll<HTMLButtonElement>('[data-breath-minutes]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (running) return;
        totalSeconds = parseInt(btn.getAttribute('data-breath-minutes')!, 10) * 60;
        highlight('minutes', String(totalSeconds / 60));
      });
    });
    highlight('minutes', '3');

    function enterPhase(i: number) {
      const p = currentPattern[i];
      phaseLabel.textContent = phaseMap[p.name] || p.name;
      circle.style.transitionProperty = reducedMotion ? 'opacity' : 'transform';
      circle.style.transitionDuration = `${p.seconds}s`;
      if (reducedMotion) {
        circle.style.opacity = p.scale > 1 ? '1' : '0.4';
      } else {
        circle.style.transform = `scale(${p.scale})`;
      }
      if (prefs.soundOn) audio.playCue(p.name === 'Exhale' ? 'advance' : 'tick');
    }

    function tick(ts: number) {
      if (!lastTs) lastTs = ts;
      const dt = (ts - lastTs) / 1000;
      lastTs = ts;
      phaseElapsed += dt;
      totalElapsed += dt;
      const current = currentPattern[phaseIdx];
      if (phaseElapsed >= current.seconds) {
        phaseElapsed = 0;
        phaseIdx = (phaseIdx + 1) % currentPattern.length;
        enterPhase(phaseIdx);
      }
      const left = Math.max(0, totalSeconds - totalElapsed);
      const remainingText = `${Math.floor(left / 60)}:${String(Math.floor(left % 60)).padStart(2, '0')}`;
      if (remainingText !== lastRemainingText) {
        lastRemainingText = remainingText;
        remaining.textContent = remainingText;
      }
      if (totalElapsed >= totalSeconds) {
        const chime = Boolean(prefs.soundOn) && Boolean(prefs.endCue);
        if (chime) audio.playCue('complete');
        stop(chime ? END_CUE_TAIL_MS : 0);
        return;
      }
      if (running) rafId = requestAnimationFrame(tick);
    }

    function start() {
      running = true;
      toggle.textContent = stopText;
      optionBtns.forEach((b) => (b.disabled = true));
      phaseIdx = 0;
      phaseElapsed = 0;
      totalElapsed = 0;
      lastTs = 0;
      lastRemainingText = '';
      window.clearTimeout(suspendTimer);
      pushToEngines();
      enterPhase(0);
      rafId = requestAnimationFrame(tick);
      if (prefs.soundOn) void startAudio().then(() => pushToEngines());
    }

    /** Stop keeps a session-end audio tail; a manual Stop click passes none. */
    function stop(audioTailMs = 0) {
      running = false;
      cancelAnimationFrame(rafId);
      toggle.textContent = startText;
      optionBtns.forEach((b) => (b.disabled = false));
      circle.style.transitionProperty = reducedMotion ? 'opacity' : 'transform';
      circle.style.transitionDuration = '500ms';
      if (reducedMotion) {
        circle.style.opacity = '1';
      } else {
        circle.style.transform = 'scale(1)';
      }
      phaseLabel.textContent = readyText;
      remaining.textContent = '';
      lastRemainingText = '';
      suspendAudio(audioTailMs);
    }

    toggle.addEventListener('click', () => (running ? stop() : start()));

    // --- settings wiring -----------------------------------------------

    settings.onChange((next) => {
      // Track the *transition*, not which control caused it. Reset emits key
      // 'reset' and can also turn sound off, and a saved preset can carry
      // soundOn — keying the teardown off the control name would leave
      // tones queued on the AudioContext timeline still firing after the
      // user asked for silence.
      const soundCameOn = Boolean(next.soundOn) && !prefs.soundOn;
      const soundWentOff = !next.soundOn && Boolean(prefs.soundOn);
      prefs = next;

      if (soundCameOn) {
        // A settings change is itself a user gesture, so the context may be
        // created here even if the session isn't running.
        void startAudio().then(() => pushToEngines());
      } else if (soundWentOff) {
        audio.cancelScheduled();
        suspendAudio(0);
      }

      pushToEngines();
      applyColors();
    });

    // The panel is hydrated by now, so this is the one push that carries
    // stored preferences into the engines.
    pushToEngines();
    applyColors();
  });
</script>
