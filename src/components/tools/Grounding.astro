---
import type { Lang } from '../../i18n';
import ToolSettings from './ToolSettings.astro';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
  warnings?: string[];
}

const { fullscreen = false, lang = 'en', warnings = [] } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-2xl mx-auto p-8"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600";

const t = {
  en: {
    subParagraph: 'Look around. Tap the button as you name each one out loud or in your head.',
    back: 'Back', skip: 'Skip this sense', alternative: 'Try another prompt',
    alternatives: ['Name 5 colors or shapes you remember', 'Name 4 textures you remember or imagine', 'Name 3 words or sounds you remember', 'Name 2 places you know or imagine', 'Name 1 thing you notice in the room'],
    remaining: 'remaining',
    tapBtn: 'I named one',
    resetBtn: 'Start over',
    done: 'You can finish here or revisit a step.',
    doneBtn: 'Done',
    stepPrompts: [
      'Name 5 things you can see',
      'Name 4 things you can touch',
      'Name 3 things you can hear',
      'Name 2 things you can smell',
      'Name 1 thing you can taste',
    ],
    stepCounts: [5, 4, 3, 2, 1],
  },
  es: {
    subParagraph: 'Mira alrededor. Toca el botón mientras nombras cada una en voz alta o en tu mente.',
    back: 'Atrás', skip: 'Omitir este sentido', alternative: 'Probar otra indicación',
    alternatives: ['Nombra 5 colores o formas que recuerdes', 'Nombra 4 texturas que recuerdes o imagines', 'Nombra 3 palabras o sonidos que recuerdes', 'Nombra 2 lugares que conozcas o imagines', 'Nombra 1 cosa que notes en la habitación'],
    remaining: 'restantes',
    tapBtn: 'Nombré una',
    resetBtn: 'Empezar de nuevo',
    done: 'Puedes terminar aquí o volver a un paso.',
    doneBtn: 'Listo',
    stepPrompts: [
      'Nombra 5 cosas que puedes ver',
      'Nombra 4 cosas que puedes tocar',
      'Nombra 3 cosas que puedes escuchar',
      'Nombra 2 cosas que puedes oler',
      'Nombra 1 cosa que puedes saborear',
    ],
    stepCounts: [5, 4, 3, 2, 1],
  },
};

const s = t[lang];

// Wired regardless of fullscreen: fullscreen is precisely when a clinician is
// running a session, and a chosen calming background matters most there. The
// fallback tracks each context's own pre-JS look (forest-800's card outside
// fullscreen, FullscreenLayout's own black inside it) so there's no color
// flash before the settings controller hydrates — this only recolors the
// widget's own card, never `FullscreenLayout` itself.
const fieldBgStyle = `background-color: var(--tool-field-bg, ${fullscreen ? '#000000' : '#122E12'});`;
---

<div
  class:list={[containerClass]}
  style={fieldBgStyle}
  data-grounding-widget
  data-grounding-i18n={JSON.stringify({
  stepPrompts: s.stepPrompts,
  alternatives: s.alternatives,
  stepCounts: s.stepCounts,
  remaining: s.remaining,
  tapBtn: s.tapBtn,
  resetBtn: s.resetBtn,
  done: s.done,
  doneBtn: s.doneBtn,
})}>
  {/*
    The standard tool page renders these above the widget via ToolShell, but the
    fullscreen route renders the widget alone — so the warnings have to travel
    with it or they would vanish exactly where the tool is used in session.
  */}
  {fullscreen && warnings.length > 0 && (
    <div class="mb-2 p-2 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs w-full max-w-md">
      <ul class="list-disc list-inside space-y-1">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  )}

  <ToolSettings componentName="Grounding" lang={lang} startOpen={false} />

  <div data-guided-content class="w-full">
  <h2
    data-grounding-prompt
    aria-live="polite"
    class="font-serif text-2xl mb-2"
    style="color: var(--tool-color, #C8E6C9);"
  >{s.stepPrompts[0]}</h2>
  <p class="text-forest-300 text-sm mb-6">{s.subParagraph} {lang === 'es' ? 'Puedes omitir cualquier sentido o usar otra indicación. No necesitas tocar, oler ni probar nada.' : 'You can skip any sense or use another prompt. You do not need to touch, smell, or taste anything.'}</p>

  <div class="flex items-center gap-4 mb-6">
    <div
      data-grounding-count
      aria-live="polite"
      aria-atomic="true"
      class="font-serif text-6xl font-semibold tabular-nums"
      style="color: var(--tool-color, #FFCA28);"
    >5</div>
    <div class="text-forest-300 text-sm">{s.remaining}</div>
  </div>

  <button
    data-grounding-tap
    class="w-full py-4 rounded-lg bg-bronze-500 text-forest-900 font-semibold hover:bg-bronze-400 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
  >
    {s.tapBtn}
  </button>

  <div class="flex flex-wrap gap-3 mt-3">
    <button data-grounding-back class="min-h-11 px-3 py-2 border border-forest-500 rounded-lg text-forest-100 disabled:opacity-50">{s.back}</button>
    <button data-grounding-skip class="min-h-11 px-3 py-2 border border-forest-500 rounded-lg text-forest-100">{s.skip}</button>
    <button data-grounding-alternative aria-pressed="false" class="min-h-11 px-3 py-2 border border-forest-500 rounded-lg text-forest-100">{s.alternative}</button>
  </div>
  <button
    data-grounding-reset
    class="w-full mt-3 py-2 text-sm text-forest-400 hover:text-forest-200 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
  >
    {s.resetBtn}
  </button>
  </div>
</div>

<script>
  import { mountGuidedFinish } from '../../scripts/guided-activity';
  import { createSettingsController } from '../../scripts/tool-settings-controller';
  import { createAudioEngine, type AmbientOptions } from '../../scripts/audio-engine';

  const TOOL_ID = 'Grounding';
  const DEFAULTS = {
    soundOn: false, volume: 0.3, palette: 'default',
    // No canvas or target here, but the shared panel still renders palette/
    // color/background — carrying their defaults is what makes those
    // controls persist correctly across a reload even though this widget
    // never reads them back out.
    color: '#FFF8E7', background: '#000000',
    ambient: 'none', ambientVolume: 0.2, binauralBase: 200, binauralBeat: 4,
  };

  const widgets = document.querySelectorAll<HTMLElement>('[data-grounding-widget]');
  widgets.forEach((root) => {
    const promptEl = root.querySelector<HTMLElement>('[data-grounding-prompt]')!;
    const countEl = root.querySelector<HTMLElement>('[data-grounding-count]')!;
    const tapBtn = root.querySelector<HTMLButtonElement>('[data-grounding-tap]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-grounding-reset]')!;

    const i18n = JSON.parse(root.getAttribute('data-grounding-i18n') || '{}');
    const stepPrompts: string[] = i18n.stepPrompts || [];
    const stepCounts: number[] = i18n.stepCounts || [];
    const tapLabel: string = i18n.tapBtn || 'I named one';
    const doneLabel: string = i18n.doneBtn || 'Done';
    const doneText: string = i18n.done || 'You are here.';

    // The controller owns the settings panel entirely: hydration, readouts,
    // palette, and persistence. It hydrates during construction, so `get()`
    // already reflects stored prefs.
    const settings = createSettingsController(root, TOOL_ID, DEFAULTS);
    let prefs = settings.get();
    const audio = createAudioEngine();

    // `color` is the foreground accent on `background`'s surface — the step
    // heading and the count numeral read `--tool-color`; the card itself
    // reads `--tool-field-bg`. This is the same pairing the settings panel's
    // own contrast warning checks (`contrastRatio(prefs.color,
    // prefs.background)`), so it stays safe without extra guarding here.
    // Buttons are deliberately left off this — their labels are a fixed
    // `text-forest-900`, which an arbitrary dark `color` would make illegible,
    // and that pairing isn't the one the contrast warning covers.
    function applyColors(): void {
      root.style.setProperty('--tool-color', prefs.color);
      root.style.setProperty('--tool-field-bg', prefs.background);
    }

    // Diffs against the ambient layer's own last-applied state before calling
    // `setAmbient`, rather than always passing every field — `setAmbient`
    // treats a defined `binauralBase`/`binauralBeat` as a structural change
    // (it has to, to catch an actual base/beat edit), so passing them
    // unconditionally would tear down and rebuild the ambient bed — an
    // audible click — on every unrelated settings change.
    let lastAmbient: AmbientOptions | null = null;
    function pushAmbient(): void {
      const next: AmbientOptions = {
        kind: prefs.soundOn ? (prefs.ambient as AmbientOptions['kind']) : 'none',
        volume: prefs.ambientVolume,
        binauralBase: prefs.binauralBase,
        binauralBeat: prefs.binauralBeat,
      };
      const patch: Partial<AmbientOptions> = {};
      if (!lastAmbient || lastAmbient.kind !== next.kind) patch.kind = next.kind;
      if (!lastAmbient || lastAmbient.volume !== next.volume) patch.volume = next.volume;
      if (!lastAmbient || lastAmbient.binauralBase !== next.binauralBase) {
        patch.binauralBase = next.binauralBase;
      }
      if (!lastAmbient || lastAmbient.binauralBeat !== next.binauralBeat) {
        patch.binauralBeat = next.binauralBeat;
      }
      lastAmbient = next;
      if (Object.keys(patch).length > 0) audio.setAmbient(patch);
    }

    function pushToEngines(): void {
      audio.setOptions({ volume: prefs.soundOn ? prefs.volume : 0 });
      pushAmbient();
    }

    // Only tracks "has this engine ever been started" — suspend() below
    // doesn't clear it, since ensureStarted() is safe to call again on an
    // already-built, merely-suspended context.
    let audioLive = false;
    const finishActivity = mountGuidedFinish(root, suspendAudio);

    async function startAudio(): Promise<void> {
      try {
        await audio.ensureStarted();
        audioLive = true;
        if (root.dataset.guidedFinished === 'true') audio.suspend();
      } catch {
        // Autoplay policy or an unavailable AudioContext — the tool still
        // works silently.
      }
    }

    function suspendAudio(): void {
      if (!audioLive) return;
      audio.cancelScheduled();
      audio.suspend();
    }

    // Every cue call starts the engine itself — a stored "sound on"
    // preference from an earlier visit still needs a fresh gesture on this
    // page load before the browser will let audio play, and a tap is exactly
    // that gesture.
    async function cue(kind: 'tick' | 'advance' | 'complete'): Promise<void> {
      if (!prefs.soundOn) return;
      await startAudio();
      if (root.dataset.guidedFinished !== 'true') audio.playCue(kind);
    }

    settings.onChange((next) => {
      // Track the *transition*, not which control caused it — Reset emits
      // key 'reset' and can also turn sound off, and a saved preset can
      // carry soundOn.
      const soundCameOn = Boolean(next.soundOn) && !prefs.soundOn;
      const soundWentOff = !next.soundOn && Boolean(prefs.soundOn);
      prefs = next;

      if (soundCameOn) void startAudio().then(() => pushToEngines());
      else if (soundWentOff) suspendAudio();

      pushToEngines();
      applyColors();
    });

    // The panel is hydrated by now, so this is the one push that carries
    // stored preferences into the engines.
    pushToEngines();
    applyColors();

    let stepIdx = 0;
    let remaining = stepCounts[0] ?? 5;
    let alternative = false;
    const back = root.querySelector<HTMLButtonElement>('[data-grounding-back]')!;
    const skip = root.querySelector<HTMLButtonElement>('[data-grounding-skip]')!;
    const alternate = root.querySelector<HTMLButtonElement>('[data-grounding-alternative]')!;
    function render() {
      const completed = stepIdx >= stepPrompts.length;
      promptEl.textContent = completed ? doneText : (alternative ? i18n.alternatives[stepIdx] : stepPrompts[stepIdx]);
      countEl.textContent = completed ? '—' : String(remaining);
      tapBtn.textContent = completed ? doneLabel : tapLabel;
      tapBtn.disabled = false;
      back.disabled = stepIdx === 0;
      skip.hidden = completed;
      alternate.hidden = completed;
      alternate.setAttribute('aria-pressed', String(alternative));
    }
    function advance() {
      stepIdx += 1;
      remaining = stepCounts[stepIdx] ?? 0;
      alternative = false;
      render();
      promptEl.tabIndex = -1;
      promptEl.focus();
    }
    function tap() {
      if (stepIdx >= stepPrompts.length) { finishActivity(); return; }
      void cue('tick');
      remaining -= 1;
      if (remaining <= 0) advance();
      else render();
    }
    back.addEventListener('click', () => {
      stepIdx = Math.max(0, stepIdx - 1); remaining = stepCounts[stepIdx]; alternative = false;
      render(); promptEl.tabIndex = -1; promptEl.focus();
    });
    skip.addEventListener('click', advance);
    alternate.addEventListener('click', () => { alternative = !alternative; render(); });
    function reset() {
      suspendAudio(); stepIdx = 0; remaining = stepCounts[0] ?? 5; alternative = false;
      render(); promptEl.tabIndex = -1; promptEl.focus();
    }
    tapBtn.addEventListener('click', tap);
    resetBtn.addEventListener('click', reset);
    render();
  });
</script>
