---
import type { Lang } from '../../i18n';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
}

const { fullscreen = false, lang = 'en' } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-5xl mx-auto p-4 flex flex-col"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600";
const trackHeight = fullscreen ? "h-96" : "h-64";

const t = {
  en: {
    combinedWarning: '⚠ Photosensitive epilepsy and headphone warnings apply. Use in clinician-supervised sessions only.',
    speed: 'Speed (Hz)',
    passes: 'Passes / set',
    tone: 'Tone (Hz)',
    volume: 'Volume',
    start: 'Start',
    stop: 'Stop',
    audio: 'audio',
    motionNotice: "This tool uses motion by design. If that's uncomfortable, consider the audio-only or butterfly-hug tool instead.",
    reducedMotionNotice: 'Your system is set to prefer reduced motion. The audio or tapping BLS tool may be a more comfortable alternative.',
  },
  es: {
    combinedWarning: '⚠ Se aplican advertencias de epilepsia fotosensible y audífonos. Usar solo en sesiones supervisadas por un clínico.',
    speed: 'Velocidad (Hz)',
    passes: 'Pases / set',
    tone: 'Tono (Hz)',
    volume: 'Volumen',
    start: 'Comenzar',
    stop: 'Detener',
    audio: 'audio',
    motionNotice: 'Esta herramienta usa movimiento por diseño. Si eso es incómodo, considera la herramienta solo de audio o el abrazo de mariposa.',
    reducedMotionNotice: 'Tu sistema está configurado para preferir movimiento reducido. La herramienta de BLS de audio o de toques puede ser una alternativa más cómoda.',
  },
};

const s = t[lang];
---

<div class:list={[containerClass]} data-bls-combined-widget data-bls-i18n={JSON.stringify({ start: s.start, stop: s.stop })}>
  <div class:list={["border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs", fullscreen ? "mb-2 p-2" : "mb-4 p-3"]}>
    {s.combinedWarning}
  </div>

  <div data-bls-rm-notice class="hidden mb-4 p-3 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs">
    {s.reducedMotionNotice}
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
    <label class="text-forest-200 text-xs">
      {s.speed}
      <input data-speed type="range" min="0.3" max="2" step="0.1" value="1.0" class="w-full accent-bronze-500" />
      <span data-speed-value class="block text-center text-forest-100 tabular-nums">1.0</span>
    </label>
    <label class="text-forest-200 text-xs">
      {s.passes}
      <input data-passes type="range" min="6" max="48" step="2" value="24" class="w-full accent-bronze-500" />
      <span data-passes-value class="block text-center text-forest-100 tabular-nums">24</span>
    </label>
    <label class="text-forest-200 text-xs">
      {s.tone}
      <input data-freq type="range" min="220" max="880" step="10" value="440" class="w-full accent-bronze-500" />
      <span data-freq-value class="block text-center text-forest-100 tabular-nums">440</span>
    </label>
    <label class="text-forest-200 text-xs">
      {s.volume}
      <input data-volume type="range" min="0" max="1" step="0.05" value="0.3" class="w-full accent-bronze-500" />
      <span data-volume-value class="block text-center text-forest-100 tabular-nums">30%</span>
    </label>
  </div>

  <div class:list={["relative w-full bg-black rounded-lg overflow-hidden", trackHeight]} data-track>
    <div
      data-dot
      class="absolute top-1/2 rounded-full"
      style="width: 48px; height: 48px; background: #FFF8E7; transform: translate(0, -50%);"
    ></div>
  </div>

  <div class="mt-4 flex items-center gap-4 flex-wrap">
    <button
      data-toggle
      class="px-6 py-2 rounded-md bg-bronze-500 text-forest-900 font-semibold hover:bg-bronze-400 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
    >
      {s.start}
    </button>
    <span data-count class="text-forest-300 text-sm tabular-nums">0 / 24</span>
    <label class="text-forest-300 text-xs flex items-center gap-2">
      <input type="checkbox" data-audio-on checked class="accent-bronze-500 focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" /> {s.audio}
    </label>
  </div>
  <p class="text-forest-400 text-xs mt-2">{s.motionNotice}</p>
</div>

<script>
  import { createBlsTimer, playBlsPulse, type BlsSide } from '../../scripts/bls-timer';

  const widgets = document.querySelectorAll('[data-bls-combined-widget]');
  widgets.forEach((root) => {
    const i18n = JSON.parse(root.getAttribute('data-bls-i18n') || '{}');
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dot = root.querySelector<HTMLElement>('[data-dot]')!;
    const speed = root.querySelector<HTMLInputElement>('[data-speed]')!;
    const speedVal = root.querySelector<HTMLElement>('[data-speed-value]')!;
    const passes = root.querySelector<HTMLInputElement>('[data-passes]')!;
    const passesVal = root.querySelector<HTMLElement>('[data-passes-value]')!;
    const freq = root.querySelector<HTMLInputElement>('[data-freq]')!;
    const freqVal = root.querySelector<HTMLElement>('[data-freq-value]')!;
    const vol = root.querySelector<HTMLInputElement>('[data-volume]')!;
    const volVal = root.querySelector<HTMLElement>('[data-volume-value]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const audioOn = root.querySelector<HTMLInputElement>('[data-audio-on]')!;
    const rmNotice = root.querySelector<HTMLElement>('[data-bls-rm-notice]');

    if (rmNotice && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rmNotice.classList.remove('hidden');
    }

    let ctx: AudioContext | null = null;

    function pulse(side: BlsSide) {
      if (!ctx || !audioOn.checked) return;
      playBlsPulse(ctx, side === 'L' ? -1 : 1, parseFloat(freq.value), parseFloat(vol.value));
    }

    const timer = createBlsTimer({
      getSpeed: () => parseFloat(speed.value),
      onFrame(phase) {
        const trackWidth = track.clientWidth - dot.clientWidth;
        const x = trackWidth * (0.5 - 0.5 * Math.cos(phase * 2 * Math.PI));
        dot.style.transform = `translate(${x}px, -50%)`;
      },
      onBeat(side, beat) {
        // Each beat is the dot arriving at an edge: pulse on that side.
        pulse(side);
        count.textContent = `${beat} / ${passes.value}`;
      },
      getTotalBeats: () => parseInt(passes.value, 10),
      onSetComplete: () => stop(),
    });

    function start() {
      // Lazily create the AudioContext on first start (never autoplay).
      ctx = ctx ?? new (window.AudioContext || (window as any).webkitAudioContext)();
      if (ctx.state === 'suspended') ctx.resume();
      count.textContent = `0 / ${passes.value}`;
      toggle.textContent = i18n.stop || 'Stop';
      timer.start();
      pulse('L'); // dot starts at the left edge
    }

    // Stop keeps the current count visible; a fresh Start resets it to 0.
    function stop() {
      timer.stop();
      toggle.textContent = i18n.start || 'Start';
      dot.style.transform = 'translate(0, -50%)';
      // Release the OS audio session while stopped.
      ctx?.suspend();
    }

    toggle.addEventListener('click', () => (timer.isRunning() ? stop() : start()));
    speed.addEventListener('input', () => (speedVal.textContent = parseFloat(speed.value).toFixed(1)));
    passes.addEventListener('input', () => {
      passesVal.textContent = passes.value;
      if (!timer.isRunning()) count.textContent = `0 / ${passes.value}`;
    });
    freq.addEventListener('input', () => (freqVal.textContent = freq.value));
    vol.addEventListener('input', () => (volVal.textContent = `${Math.round(parseFloat(vol.value) * 100)}%`));
  });
</script>
