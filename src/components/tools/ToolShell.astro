---
import EvidenceNote from '../EvidenceNote.astro';
import SessionControls from './SessionControls.astro';
import ActivitySurface from './ActivitySurface.astro';
import { activityContent } from '../../lib/activity-content';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../../i18n';

interface Props {
  tool: CollectionEntry<'tools'>;
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { tool, lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { name: clinicalName, category, evidence, shortDescription: clinicalDescription, citations, warnings } = tool.data;

const friendly = activityContent(tool.slug.replace(/es$/, ''), lang);
const name = friendly?.name ?? clinicalName;
const shortDescription = friendly?.description ?? clinicalDescription;

const categoryLabel: Record<string, string> = {
  bls: t('tools.category.bls'),
  preparation: t('tools.category.preparation'),
  assessment: t('tools.category.assessment'),
  regulation: t('tools.category.regulation'),
};

const evidenceLabel: Record<string, string> = {
  'research-backed': t('tools.evidence.research'),
  'clinical-consensus': t('tools.evidence.consensus'),
  'widely-used': t('tools.evidence.widely'),
};

const evidenceColor: Record<string, string> = {
  'research-backed': 'bg-forest-600 text-forest-50',
  'clinical-consensus': 'bg-bronze-600 text-forest-900',
  'widely-used': 'bg-wood-600 text-wood-50',
};

const slugBase = tool.slug.replace(/es$/, '');
const fullscreenHref = translatePath(`/tools/${slugBase}/fullscreen`);
---

<section class="tool-shell dark-zone py-6 sm:py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav data-guide-chrome class="text-sm text-forest-300 mb-4" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
      <a href={translatePath('/tools')} class="hover:text-forest-200 transition-colors">{t('tools.breadcrumbRoot')}</a>
      <span class="mx-2">/</span>
      <span class="text-forest-100">{name}</span>
    </nav>

    <!-- Header -->
    <div data-guide-chrome class="mb-4">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs uppercase tracking-wide text-forest-400">{categoryLabel[category]}</span>
        <span class:list={["px-2 py-0.5 rounded-full text-xs font-medium", evidenceColor[evidence]]}>
          {evidenceLabel[evidence]}
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-forest-100 mb-3">{name}</h1>
      <p class="text-forest-200 leading-relaxed">{shortDescription}</p>
    </div>

    <!-- Disclaimer -->
    <div data-guide-chrome class="mb-4 p-3 border-l-4 border-bronze-500 bg-forest-800/50 text-sm text-forest-200">
      <strong class="text-forest-100">{t('tools.disclaimerStrong')}</strong>
      {' '}{t('tools.disclaimerBody')}
    </div>

    <!-- Warnings (epilepsy, headphones, etc.) -->
    {warnings.length > 0 && (
      <div class="mb-6 p-4 border border-amber-500/50 bg-amber-900/20 rounded-lg">
        <h2 class="text-amber-200 font-semibold text-sm mb-2">{t('tools.beforeYouStart')}</h2>
        <ul class="text-amber-100 text-sm space-y-1 list-disc list-inside">
          {warnings.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    )}

    <div data-guide-chrome class="mb-4">
      <button type="button" data-client-view-toggle aria-pressed="false" disabled class="px-4 py-3 bg-bronze-500 text-forest-900 rounded-md font-semibold disabled:opacity-60">
        {lang === 'es' ? 'Mostrar solo la actividad' : 'Show activity only'}
      </button>
      <p class="text-sm text-forest-200 mt-2">{lang === 'es' ? 'Conserva tus elecciones. Puedes volver a esta guía en cualquier momento.' : 'Keeps your choices. You can return to this guide at any time.'}</p>
      <noscript><a href={fullscreenHref}>{t('tools.openFullscreen')}</a></noscript>
    </div>

    <!-- Widget slot -->
    <div class="mb-8">
      <ActivitySurface lang={lang}><slot /></ActivitySurface>
    </div>

    <!-- Citations -->
    {citations.length > 0 && (
      <details data-guide-chrome class="pt-6 border-t border-forest-700">
        <summary class="cursor-pointer text-forest-100 font-semibold">{t('tools.clinicalSources')}</summary>
        <h2 class="text-sm font-semibold text-forest-300 mb-3 uppercase tracking-wide">{t('tools.clinicalSources')}</h2>
        <p class="text-sm text-forest-200 my-3">{clinicalName}</p>
        <EvidenceNote lang={lang} />
        <ul class="text-sm text-forest-300 space-y-1">
          {citations.map((c) => (
            <li>
              {c.url ? <a href={c.url} class="underline hover:text-forest-100">{c.label}</a> : c.label}
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</section>

<SessionControls lang={lang} />
