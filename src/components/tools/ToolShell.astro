---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../../i18n';

interface Props {
  tool: CollectionEntry<'tools'>;
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { tool, lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { name, category, evidence, shortDescription, citations, warnings } = tool.data;

const categoryLabel: Record<string, string> = {
  bls: t('tools.category.bls'),
  preparation: t('tools.category.preparation'),
  assessment: t('tools.category.assessment'),
  regulation: t('tools.category.regulation'),
};

const evidenceLabel: Record<string, string> = {
  'research-backed': t('tools.evidence.research'),
  'clinical-consensus': t('tools.evidence.consensus'),
  'widely-used': t('tools.evidence.widely'),
};

const evidenceColor: Record<string, string> = {
  'research-backed': 'bg-forest-600 text-forest-50',
  'clinical-consensus': 'bg-bronze-600 text-bronze-50',
  'widely-used': 'bg-wood-600 text-wood-50',
};

const fullscreenHref = translatePath(`/tools/${tool.slug}/fullscreen`);
---

<section class="dark-zone py-10 sm:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-forest-400 mb-4">
      <a href={translatePath('/clinicians/emdr/tools')} class="hover:text-forest-200 transition-colors">{t('tools.breadcrumbRoot')}</a>
      <span class="mx-2">/</span>
      <span class="text-forest-100">{name}</span>
    </nav>

    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs uppercase tracking-wide text-forest-400">{categoryLabel[category]}</span>
        <span class:list={["px-2 py-0.5 rounded-full text-xs font-medium", evidenceColor[evidence]]}>
          {evidenceLabel[evidence]}
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-forest-100 mb-3">{name}</h1>
      <p class="text-forest-200 leading-relaxed">{shortDescription}</p>
    </div>

    <!-- Disclaimer -->
    <div class="mb-6 p-4 border-l-4 border-bronze-500 bg-forest-800/50 text-sm text-forest-200">
      <strong class="text-forest-100">{t('tools.disclaimerStrong')}</strong>
      {' '}{t('tools.disclaimerBody')}
    </div>

    <!-- Warnings (epilepsy, headphones, etc.) -->
    {warnings.length > 0 && (
      <div class="mb-6 p-4 border border-amber-500/50 bg-amber-900/20 rounded-lg">
        <h2 class="text-amber-200 font-semibold text-sm mb-2">{t('tools.beforeYouStart')}</h2>
        <ul class="text-amber-100 text-sm space-y-1 list-disc list-inside">
          {warnings.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    )}

    <!-- Fullscreen link -->
    <div class="mb-8">
      <a
        href={fullscreenHref}
        class="inline-flex items-center gap-2 px-4 py-2 bg-forest-700 border border-forest-500 text-forest-100 rounded-md hover:bg-forest-600 transition-colors text-sm font-medium focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
      >
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M4 16v4h4m8-16h4v4m-4 12h4v-4" />
        </svg>
        {t('tools.openFullscreen')}
      </a>
    </div>

    <!-- Widget slot -->
    <div class="mb-10">
      <slot />
    </div>

    <!-- Citations -->
    {citations.length > 0 && (
      <div class="pt-6 border-t border-forest-700">
        <h2 class="text-sm font-semibold text-forest-300 mb-3 uppercase tracking-wide">{t('tools.clinicalSources')}</h2>
        <ul class="text-sm text-forest-300 space-y-1">
          {citations.map((c) => (
            <li>
              {c.url ? <a href={c.url} class="underline hover:text-forest-100">{c.label}</a> : c.label}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
