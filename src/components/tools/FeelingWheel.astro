---
import type { Lang } from '../../i18n';
import ToolSettings from './ToolSettings.astro';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
  warnings?: string[];
}

const { fullscreen = false, lang = 'en', warnings = [] } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-2xl mx-auto p-8"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600";

const t = {
  en: {
    heading: 'What are you feeling?',
    intro: 'Choose a word from the cards. More specific words will appear below. You can change your choice, choose neutral, or say none fit.',
    bodyPrompt: 'If useful, notice a body sensation or what you might need. You can skip this question.',
    moreSpecifically: 'More specifically, is it...',
    core: [
      { name: 'Sad', color: '#6B8FB3', secondary: [
        { name: 'Lonely', desc: 'A sad feeling of being alone or separated from people who matter.' },
        { name: 'Gloomy', desc: 'A heavy, low sadness that colors everything gray.' },
        { name: 'Hurt', desc: 'Sad because someone or something wounded you.' },
        { name: 'Bored', desc: 'A restless, unsatisfied kind of sad — nothing interests you.' },
      ]},
      { name: 'Mad', color: '#CA8D8D', secondary: [
        { name: 'Frustrated', desc: 'Mad because something keeps getting in your way.' },
        { name: 'Jealous', desc: 'Mad because someone has something you want, or is taking something that feels yours.' },
        { name: 'Furious', desc: 'Very big anger — a mad that feels out of control.' },
        { name: 'Irritated', desc: 'Small, scratchy mad — the kind that builds up if you ignore it.' },
      ]},
      { name: 'Scared', color: '#B39B6B', secondary: [
        { name: 'Anxious', desc: "Scared about something that hasn't happened yet." },
        { name: 'Overwhelmed', desc: "Scared because there's too much at once." },
        { name: 'Insecure', desc: "Scared that you're not enough, or that people will see." },
        { name: 'Helpless', desc: "Scared because you don't know what to do." },
      ]},
      { name: 'Joyful', color: '#8DB47B', secondary: [
        { name: 'Excited', desc: 'Joyful with energy — something good is happening or coming.' },
        { name: 'Content', desc: 'Calm, settled joy — a quiet enough.' },
        { name: 'Grateful', desc: 'Joyful because of something or someone you appreciate.' },
        { name: 'Playful', desc: 'Joyful in a silly, light way.' },
      ]},
      { name: 'Peaceful', color: '#7BB39B', secondary: [
        { name: 'Relaxed', desc: 'Your body is loose and your breath is slow.' },
        { name: 'Safe', desc: 'A sense of enough safety in this moment.' },
        { name: 'Loved', desc: 'You know someone cares about you.' },
        { name: 'Calm', desc: 'Your mind is quiet and still.' },
      ]},
      { name: 'Powerful', color: '#B38D7B', secondary: [
        { name: 'Proud', desc: 'Powerful because of something you did.' },
        { name: 'Confident', desc: 'Powerful because you trust yourself.' },
        { name: 'Brave', desc: 'Powerful even though something is scary.' },
        { name: 'Capable', desc: 'Powerful because you know you can do this.' },
      ]},
    ],
  },
  es: {
    heading: '¿Qué estás sintiendo?',
    intro: 'Elige una palabra de las tarjetas. Abajo aparecerán palabras más específicas. Puedes cambiar tu elección, elegir neutral o indicar que ninguna encaja.',
    bodyPrompt: 'Si te sirve, nota una sensación corporal o algo que puedas necesitar. Puedes omitir esta pregunta.',
    moreSpecifically: 'Más específicamente, ¿es...?',
    core: [
      { name: 'Triste', color: '#6B8FB3', secondary: [
        { name: 'Solo/a', desc: 'Un sentimiento triste de estar solo o separado de personas importantes.' },
        { name: 'Melancólico/a', desc: 'Una tristeza pesada y baja que colorea todo de gris.' },
        { name: 'Herido/a', desc: 'Triste porque alguien o algo te lastimó.' },
        { name: 'Aburrido/a', desc: 'Un tipo de tristeza inquieta e insatisfecha — nada te interesa.' },
      ]},
      { name: 'Enojado/a', color: '#CA8D8D', secondary: [
        { name: 'Frustrado/a', desc: 'Enojado porque algo sigue interponiéndose en tu camino.' },
        { name: 'Celoso/a', desc: 'Enojado porque alguien tiene algo que quieres, o está tomando algo que sientes tuyo.' },
        { name: 'Furioso/a', desc: 'Enojo muy grande — un enojo que se siente fuera de control.' },
        { name: 'Irritado/a', desc: 'Enojo pequeño y raspante — el tipo que se acumula si lo ignoras.' },
      ]},
      { name: 'Asustado/a', color: '#B39B6B', secondary: [
        { name: 'Ansioso/a', desc: 'Asustado por algo que aún no ha pasado.' },
        { name: 'Abrumado/a', desc: 'Asustado porque hay demasiado a la vez.' },
        { name: 'Inseguro/a', desc: 'Asustado de no ser suficiente, o de que la gente lo vea.' },
        { name: 'Indefenso/a', desc: 'Asustado porque no sabes qué hacer.' },
      ]},
      { name: 'Alegre', color: '#8DB47B', secondary: [
        { name: 'Emocionado/a', desc: 'Alegre con energía — algo bueno está pasando o viene.' },
        { name: 'Contento/a', desc: 'Una alegría tranquila: sentir que este momento está bien.' },
        { name: 'Agradecido/a', desc: 'Alegre por algo o alguien que aprecias.' },
        { name: 'Juguetón/a', desc: 'Alegre de una manera tonta y ligera.' },
      ]},
      { name: 'En paz', color: '#7BB39B', secondary: [
        { name: 'Relajado/a', desc: 'Tu cuerpo está suelto y tu respiración es lenta.' },
        { name: 'Seguro/a', desc: 'Una sensación de suficiente seguridad en este momento.' },
        { name: 'Amado/a', desc: 'Sabes que alguien se preocupa por ti.' },
        { name: 'Calma', desc: 'Tu mente está quieta y tranquila.' },
      ]},
      { name: 'Poderoso/a', color: '#B38D7B', secondary: [
        { name: 'Orgulloso/a', desc: 'Poderoso por algo que hiciste.' },
        { name: 'Confiado/a', desc: 'Poderoso porque confías en ti mismo.' },
        { name: 'Valiente', desc: 'Poderoso aunque algo sea aterrador.' },
        { name: 'Capaz', desc: 'Poderoso porque sabes que puedes hacer esto.' },
      ]},
    ],
  },
};

const s = t[lang];
---

<div class:list={[containerClass]} data-feeling-widget data-feeling-i18n={JSON.stringify({
  core: s.core,
  moreSpecifically: s.moreSpecifically,
})}>
  {/*
    The standard tool page renders these above the widget via ToolShell, but the
    fullscreen route renders the widget alone — so the warnings have to travel
    with it or they would vanish exactly where the tool is used in session.
  */}
  {fullscreen && warnings.length > 0 && (
    <div class="mb-2 p-2 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs w-full max-w-md">
      <ul class="list-disc list-inside space-y-1">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  )}

  <ToolSettings componentName="FeelingWheel" lang={lang} startOpen={false} />

  <div data-guided-content class="w-full">
  <h2 class="font-serif text-xl mb-4" style="color: var(--tool-color, #C8E6C9);">{s.heading}</h2>
  <p class="text-forest-300 text-sm mb-6">{s.intro}</p>

  <div class="grid grid-cols-2 gap-3 mb-6" data-core-grid>
    {s.core.map((c, i) => (
      <button
        data-core-button={String(i)}
        aria-pressed="false"
        class="p-4 rounded-lg text-forest-900 font-semibold hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
        style={`background-color: ${c.color}`}
      >
        {c.name}
      </button>
    ))}
  </div>

  <div class="flex flex-wrap gap-3 mb-5">
    <button data-feeling-neutral aria-pressed="false" class="min-h-11 px-4 py-2 rounded-lg border border-forest-400 text-forest-100">{lang === 'es' ? 'Neutral' : 'Neutral'}</button>
    <button data-feeling-none aria-pressed="false" class="min-h-11 px-4 py-2 rounded-lg border border-forest-400 text-forest-100">{lang === 'es' ? 'Ninguna encaja / No sé' : 'None fit / Not sure'}</button>
    <button data-feeling-clear class="min-h-11 px-4 py-2 underline text-forest-200">{lang === 'es' ? 'Quitar elección' : 'Clear choice'}</button>
  </div>
  <div data-secondary-wrap class="hidden mb-6">
    <h3 class="text-forest-200 text-sm mb-2" data-secondary-title></h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" data-secondary-grid></div>
  </div>

  <div
    data-detail-wrap
    aria-live="polite"
    class="hidden p-4 border rounded-lg"
    style="background-color: var(--tool-field-bg, #0A1F0A); border-color: var(--tool-color, #FFC107);"
  >
    <h3 data-detail-name class="font-serif text-lg mb-2" style="color: var(--tool-color, #FFCA28);"></h3>
    <p data-detail-desc class="text-forest-200 text-sm mb-3"></p>
    <p class="text-forest-300 text-xs">{s.bodyPrompt}</p>
  </div>
  </div>
</div>

<script>
  import { markActivityReady } from '../../scripts/activity-ready';
  import { mountGuidedFinish, focusActivityPanel, setPressedChoice } from '../../scripts/guided-activity';
  import { createSettingsController } from '../../scripts/tool-settings-controller';
  import { createAudioEngine, type AmbientOptions } from '../../scripts/audio-engine';

  const TOOL_ID = 'FeelingWheel';
  const DEFAULTS = {
    soundOn: false, volume: 0.3, palette: 'default',
    // The main heading and the detail box (background, border, and its own
    // heading) all read `color`/`background` — carrying their defaults is
    // what makes those controls persist correctly across a reload.
    color: '#FFF8E7', background: '#000000',
    ambient: 'none', ambientVolume: 0.2, binauralBase: 200, binauralBeat: 4,
  };

  const widgets = document.querySelectorAll<HTMLElement>('[data-feeling-widget]');
  widgets.forEach((root) => {
    const i18n = JSON.parse(root.getAttribute('data-feeling-i18n') || '{}');
    const core: Array<{
      name: string;
      color: string;
      secondary: Array<{ name: string; desc: string }>;
    }> = i18n.core || [];
    const moreSpecifically: string = i18n.moreSpecifically || 'More specifically, is it...';

    // The controller owns the settings panel entirely: hydration, readouts,
    // palette, and persistence. It hydrates during construction, so `get()`
    // already reflects stored prefs.
    const settings = createSettingsController(root, TOOL_ID, DEFAULTS);
    let prefs = settings.get();
    const audio = createAudioEngine();

    // `color` is the foreground accent on `background`'s surface — see the
    // note in Grounding.astro for why buttons (including the six core-emotion
    // buttons, which keep their own meaningful colors regardless) are
    // deliberately left off this.
    function applyColors(): void {
      root.style.setProperty('--tool-color', prefs.color);
      root.style.setProperty('--tool-field-bg', prefs.background);
    }

    // Diffs against the ambient layer's own last-applied state before calling
    // `setAmbient` — see the note in Grounding.astro for why this avoids an
    // audible click on every unrelated settings change.
    let lastAmbient: AmbientOptions | null = null;
    function pushAmbient(): void {
      const next: AmbientOptions = {
        kind: prefs.soundOn ? (prefs.ambient as AmbientOptions['kind']) : 'none',
        volume: prefs.ambientVolume,
        binauralBase: prefs.binauralBase,
        binauralBeat: prefs.binauralBeat,
      };
      const patch: Partial<AmbientOptions> = {};
      if (!lastAmbient || lastAmbient.kind !== next.kind) patch.kind = next.kind;
      if (!lastAmbient || lastAmbient.volume !== next.volume) patch.volume = next.volume;
      if (!lastAmbient || lastAmbient.binauralBase !== next.binauralBase) {
        patch.binauralBase = next.binauralBase;
      }
      if (!lastAmbient || lastAmbient.binauralBeat !== next.binauralBeat) {
        patch.binauralBeat = next.binauralBeat;
      }
      lastAmbient = next;
      if (Object.keys(patch).length > 0) audio.setAmbient(patch);
    }

    function pushToEngines(): void {
      audio.setOptions({ volume: prefs.soundOn ? prefs.volume : 0 });
      pushAmbient();
    }

    let audioLive = false;
    mountGuidedFinish(root, suspendAudio);

    async function startAudio(): Promise<void> {
      try {
        await audio.ensureStarted();
        audioLive = true;
        if (root.dataset.guidedFinished === 'true') audio.suspend();
      } catch {
        // Autoplay policy or an unavailable AudioContext — the tool still
        // works silently.
      }
    }

    function suspendAudio(): void {
      if (!audioLive) return;
      audio.cancelScheduled();
      audio.suspend();
    }

    async function cue(kind: 'tick' | 'advance' | 'complete'): Promise<void> {
      if (!prefs.soundOn) return;
      await startAudio();
      if (root.dataset.guidedFinished !== 'true') audio.playCue(kind);
    }

    settings.onChange((next) => {
      const soundCameOn = Boolean(next.soundOn) && !prefs.soundOn;
      const soundWentOff = !next.soundOn && Boolean(prefs.soundOn);
      prefs = next;

      if (soundCameOn) void startAudio().then(() => pushToEngines());
      else if (soundWentOff) suspendAudio();

      pushToEngines();
      applyColors();
    });

    pushToEngines();
    applyColors();

    const secondaryWrap = root.querySelector<HTMLElement>('[data-secondary-wrap]')!;
    const secondaryTitle = root.querySelector<HTMLElement>('[data-secondary-title]')!;
    const secondaryGrid = root.querySelector<HTMLElement>('[data-secondary-grid]')!;
    const detailWrap = root.querySelector<HTMLElement>('[data-detail-wrap]')!;
    const detailName = root.querySelector<HTMLElement>('[data-detail-name]')!;
    const detailDesc = root.querySelector<HTMLElement>('[data-detail-desc]')!;

    const coreButtons = root.querySelectorAll<HTMLButtonElement>('[data-core-button]');
    coreButtons.forEach((btn) => {
      const c = core[parseInt(btn.getAttribute('data-core-button')!, 10)];
      if (!c) return;
      btn.addEventListener('click', () => {
        setPressedChoice(root, '[data-core-button], [data-feeling-neutral], [data-feeling-none]', btn);
        secondaryTitle.textContent = moreSpecifically;
        secondaryGrid.innerHTML = '';
        c.secondary.forEach((s) => {
          const sbtn = document.createElement('button');
          sbtn.textContent = s.name;
          sbtn.type = 'button';
          sbtn.setAttribute('aria-pressed', 'false');
          sbtn.className = 'px-3 py-2 rounded-md bg-forest-700 border border-forest-600 text-forest-100 text-sm hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800';
          sbtn.addEventListener('click', () => {
            setPressedChoice(secondaryGrid, 'button', sbtn);
            detailName.textContent = s.name;
            detailDesc.textContent = s.desc;
            detailWrap.classList.remove('hidden');
            focusActivityPanel(detailWrap);
            void cue('tick');
          });
          secondaryGrid.appendChild(sbtn);
        });
        secondaryWrap.classList.remove('hidden');
        detailName.textContent = c.name;
        detailDesc.textContent = document.documentElement.lang === 'es' ? 'Puedes quedarte con esta palabra. Elegir una más específica es opcional.' : 'This word can be enough. Choosing a more specific word is optional.';
        detailWrap.classList.remove('hidden');
        focusActivityPanel(secondaryWrap);
        void cue('advance');
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-feeling-neutral], [data-feeling-none]').forEach((button) => {
      button.addEventListener('click', () => {
        setPressedChoice(root, '[data-core-button], [data-feeling-neutral], [data-feeling-none]', button);
        secondaryWrap.classList.add('hidden'); secondaryGrid.replaceChildren();
        detailName.textContent = button.textContent;
        detailDesc.textContent = document.documentElement.lang === 'es' ? 'No necesitas encontrar una palabra exacta.' : 'You do not need to find an exact word.';
        detailWrap.classList.remove('hidden'); focusActivityPanel(detailWrap);
      });
    });
    root.querySelector('[data-feeling-clear]')?.addEventListener('click', () => {
      setPressedChoice(root, '[data-core-button], [data-feeling-neutral], [data-feeling-none], [data-secondary-grid] button', null);
      secondaryWrap.classList.add('hidden'); detailWrap.classList.add('hidden');
      secondaryGrid.replaceChildren(); coreButtons[0]?.focus(); suspendAudio();
    });
  });
  markActivityReady('[data-feeling-widget]');
</script>
