---
import type { Lang } from '../../i18n';
import ToolSettings from './ToolSettings.astro';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
  warnings?: string[];
}

const { fullscreen = false, lang = 'en', warnings = [] } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-2xl mx-auto p-8"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600";

const t = {
  en: {
    heading: 'How disturbing is it right now?',
    kidMode: 'Kid mode',
    lowLabel: '0 — none',
    midLabel: '5',
    highLabel: '10 — worst imaginable',
    ariaLabel: 'SUD level from 0 to 10',
    adultLabels: [
      'No disturbance',
      'Barely noticeable',
      'Mild',
      'Mild-moderate',
      'Moderate',
      'Moderate',
      'Moderate-high',
      'High',
      'Very high',
      'Nearly unbearable',
      'Worst imaginable',
    ],
    kidLabels: [
      'Not yucky at all',
      'A tiny bit',
      'A little',
      'Some',
      'Medium',
      'Kind of big',
      'Big',
      'Really big',
      'Super big',
      'Huge',
      'The biggest',
    ],
    adultWording: '"On a scale of 0 to 10, where 0 is no disturbance or neutral and 10 is the worst disturbance you can imagine, how disturbing does the incident feel to you now?"',
    kidWording: '"How yucky does it feel in your body right now? Zero is not yucky at all, ten is the worst yucky you can imagine."',
  },
  es: {
    heading: '¿Qué tan perturbador se siente ahora?',
    kidMode: 'Modo niño',
    lowLabel: '0 — nada',
    midLabel: '5',
    highLabel: '10 — lo peor imaginable',
    ariaLabel: 'Nivel SUD del 0 al 10',
    adultLabels: [
      'Ninguna perturbación',
      'Apenas perceptible',
      'Leve',
      'Leve-moderado',
      'Moderado',
      'Moderado',
      'Moderado-alto',
      'Alto',
      'Muy alto',
      'Casi insoportable',
      'Lo peor imaginable',
    ],
    kidLabels: [
      'Nada yucky',
      'Un poquito',
      'Un poco',
      'Algo',
      'Medio',
      'Bastante grande',
      'Grande',
      'Muy grande',
      'Super grande',
      'Enorme',
      'Lo más grande',
    ],
    adultWording: '"En una escala de 0 a 10, donde 0 es ninguna perturbación o neutral y 10 es la peor perturbación que puedas imaginar, ¿qué tan perturbador se siente el incidente ahora?"',
    kidWording: '"¿Qué tan yucky se siente en tu cuerpo ahora? Cero no es nada yucky, diez es el peor yucky que puedas imaginar."',
  },
};

const s = t[lang];
---

<div class:list={[containerClass]} data-sud-widget data-sud-i18n={JSON.stringify({
  adultLabels: s.adultLabels,
  kidLabels: s.kidLabels,
  adultWording: s.adultWording,
  kidWording: s.kidWording,
})}>
  {/*
    The standard tool page renders these above the widget via ToolShell, but the
    fullscreen route renders the widget alone — so the warnings have to travel
    with it or they would vanish exactly where the tool is used in session.
  */}
  {fullscreen && warnings.length > 0 && (
    <div class="mb-2 p-2 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs w-full max-w-md">
      <ul class="list-disc list-inside space-y-1">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  )}

  <ToolSettings componentName="SUDScale" lang={lang} startOpen={!fullscreen} />

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-forest-100 font-semibold">
      {s.heading}
    </h2>
    <label class="flex items-center gap-2 text-sm text-forest-300 cursor-pointer">
      <input type="checkbox" data-sud-kid-toggle class="w-4 h-4 accent-bronze-500 focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" />
      <span>{s.kidMode}</span>
    </label>
  </div>

  <div class="text-center mb-6">
    <div
      data-sud-display
      aria-live="polite"
      aria-atomic="true"
      class="font-serif text-7xl font-semibold text-bronze-400 mb-2 tabular-nums"
    >
      5
    </div>
    <div data-sud-label aria-live="polite" class="text-forest-300 text-sm">{s.adultLabels[5]}</div>
    <div data-sud-faces class="text-6xl hidden" aria-hidden="true">😐</div>
  </div>

  <input
    type="range"
    min="0"
    max="10"
    step="1"
    value="5"
    data-sud-slider
    aria-label={s.ariaLabel}
    class="w-full h-2 rounded-full bg-forest-700 appearance-none cursor-pointer accent-bronze-500"
  />

  <div class="flex justify-between text-xs text-forest-300 mt-2">
    <span>{s.lowLabel}</span>
    <span>{s.midLabel}</span>
    <span>{s.highLabel}</span>
  </div>

  <div class="mt-6 text-sm text-forest-300" data-sud-wording>
    <em>{s.adultWording}</em>
  </div>
</div>

<script>
  import { createSettingsController } from '../../scripts/tool-settings-controller';
  import { createAudioEngine, type AmbientOptions } from '../../scripts/audio-engine';

  const TOOL_ID = 'SUDScale';
  const DEFAULTS = {
    soundOn: false, volume: 0.3, palette: 'default',
    // No canvas or target here, but the shared panel still renders palette/
    // color/background — carrying their defaults is what makes those
    // controls persist correctly across a reload even though this widget
    // never reads them back out.
    color: '#FFF8E7', background: '#000000',
    ambient: 'none', ambientVolume: 0.2, binauralBase: 200, binauralBeat: 4,
  };

  const widgets = document.querySelectorAll<HTMLElement>('[data-sud-widget]');
  widgets.forEach((root) => {
    const slider = root.querySelector<HTMLInputElement>('[data-sud-slider]')!;
    const display = root.querySelector<HTMLElement>('[data-sud-display]')!;
    const label = root.querySelector<HTMLElement>('[data-sud-label]')!;
    const faces = root.querySelector<HTMLElement>('[data-sud-faces]')!;
    const wording = root.querySelector<HTMLElement>('[data-sud-wording]')!;
    const kidToggle = root.querySelector<HTMLInputElement>('[data-sud-kid-toggle]')!;

    const i18n = JSON.parse(root.getAttribute('data-sud-i18n') || '{}');
    const adultLabels: string[] = i18n.adultLabels || [];
    const kidLabels: string[] = i18n.kidLabels || [];
    const adultWording: string = i18n.adultWording || '';
    const kidWording: string = i18n.kidWording || '';

    const kidFaces = ['😊', '🙂', '😐', '😕', '😟', '😖', '😣', '😫', '😩', '😭', '😱'];

    // The controller owns the settings panel entirely: hydration, readouts,
    // palette, and persistence. It hydrates during construction, so `get()`
    // already reflects stored prefs.
    const settings = createSettingsController(root, TOOL_ID, DEFAULTS);
    let prefs = settings.get();
    const audio = createAudioEngine();

    // Diffs against the ambient layer's own last-applied state before calling
    // `setAmbient` — see the note in Grounding.astro for why this avoids an
    // audible click on every unrelated settings change.
    let lastAmbient: AmbientOptions | null = null;
    function pushAmbient(): void {
      const next: AmbientOptions = {
        kind: prefs.soundOn ? (prefs.ambient as AmbientOptions['kind']) : 'none',
        volume: prefs.ambientVolume,
        binauralBase: prefs.binauralBase,
        binauralBeat: prefs.binauralBeat,
      };
      const patch: Partial<AmbientOptions> = {};
      if (!lastAmbient || lastAmbient.kind !== next.kind) patch.kind = next.kind;
      if (!lastAmbient || lastAmbient.volume !== next.volume) patch.volume = next.volume;
      if (!lastAmbient || lastAmbient.binauralBase !== next.binauralBase) {
        patch.binauralBase = next.binauralBase;
      }
      if (!lastAmbient || lastAmbient.binauralBeat !== next.binauralBeat) {
        patch.binauralBeat = next.binauralBeat;
      }
      lastAmbient = next;
      if (Object.keys(patch).length > 0) audio.setAmbient(patch);
    }

    function pushToEngines(): void {
      audio.setOptions({ volume: prefs.soundOn ? prefs.volume : 0 });
      pushAmbient();
    }

    let audioLive = false;

    async function startAudio(): Promise<void> {
      try {
        await audio.ensureStarted();
        audioLive = true;
      } catch {
        // Autoplay policy or an unavailable AudioContext — the tool still
        // works silently.
      }
    }

    function suspendAudio(): void {
      if (!audioLive) return;
      audio.cancelScheduled();
      audio.suspend();
    }

    // No cue sounds on this tool — see `update()` below. This only makes
    // sure the ambient bed actually gets a user gesture to start on, since a
    // "sound on" preference restored from a previous visit still needs a
    // fresh gesture on this page load before the browser allows audio.
    function ensureAudioLive(): void {
      if (prefs.soundOn && !audioLive) void startAudio().then(() => pushToEngines());
    }

    settings.onChange((next) => {
      const soundCameOn = Boolean(next.soundOn) && !prefs.soundOn;
      const soundWentOff = !next.soundOn && Boolean(prefs.soundOn);
      prefs = next;

      if (soundCameOn) void startAudio().then(() => pushToEngines());
      else if (soundWentOff) suspendAudio();

      pushToEngines();
    });

    pushToEngines();

    function update() {
      const val = parseInt(slider.value, 10);
      const isKid = kidToggle.checked;
      display.textContent = String(val);
      if (isKid) {
        faces.textContent = kidFaces[val];
        faces.classList.remove('hidden');
        label.textContent = kidLabels[val];
        wording.innerHTML = `<em>${kidWording}</em>`;
      } else {
        faces.classList.add('hidden');
        label.textContent = adultLabels[val];
        wording.innerHTML = `<em>${adultWording}</em>`;
      }
    }

    // Deliberately no per-increment tick here, even with sound enabled — a
    // noise on every step while someone rates their own distress is the
    // wrong instinct for this tool. Only the ambient bed and palette apply.
    slider.addEventListener('input', () => { update(); ensureAudioLive(); });
    kidToggle.addEventListener('change', () => { update(); ensureAudioLive(); });
    update();
  });
</script>
