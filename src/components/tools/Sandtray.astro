---
interface Props {
  fullscreen?: boolean;
}

const { fullscreen = false } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-5xl mx-auto p-4 flex flex-col"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600 flex flex-col";
const canvasHeight = fullscreen ? "h-[28rem] sm:h-[32rem]" : "h-80 sm:h-96";

const categories = [
  {
    key: 'people',
    label: 'People',
    items: ['🧒', '👦', '👧', '🧑', '👨', '👩', '🧓', '👴', '👵', '👶', '🤰', '👨‍🦽', '👩‍🦼', '🧑‍🦯', '👪', '👨‍👩‍👧', '👨‍👩‍👦', '🧑‍🤝‍🧑', '👭', '👬'],
  },
  {
    key: 'animals',
    label: 'Animals',
    items: ['🐶', '🐱', '🐭', '🐰', '🦊', '🐻', '🐼', '🐨', '🐯', '🦁', '🐮', '🐷', '🐸', '🐵', '🙈', '🐔', '🐧', '🐦', '🦉', '🦅', '🦄', '🐴', '🦋', '🐠', '🐢', '🐙'],
  },
  {
    key: 'nature',
    label: 'Nature',
    items: ['🌲', '🌳', '🌴', '🌵', '🌱', '🌿', '🍀', '🍃', '🌷', '🌸', '🌹', '🌻', '🌼', '🌾', '🪨', '⛰️', '🏔️', '🌋', '🏞️', '🏝️', '🏖️', '🌊', '💧', '🔥', '☀️', '🌙', '⭐', '⛈️', '🌈', '❄️'],
  },
  {
    key: 'places',
    label: 'Home & Places',
    items: ['🏠', '🏡', '🏘️', '🏚️', '🏫', '🏥', '⛪', '🕌', '🏛️', '🏰', '🏯', '🗼', '⛺', '🛖', '🚪', '🪟', '🛏️', '🛋️', '🚽', '🛁'],
  },
  {
    key: 'vehicles',
    label: 'Vehicles',
    items: ['🚗', '🚙', '🚌', '🚎', '🚓', '🚑', '🚒', '🚚', '🚛', '🚜', '🏍️', '🚲', '🛴', '🛻', '✈️', '🚁', '🚀', '🛸', '⛵', '🚤', '🚢'],
  },
  {
    key: 'objects',
    label: 'Food & Objects',
    items: ['🍎', '🍞', '🍰', '🍪', '🍫', '🍭', '🎂', '☕', '🥛', '🍼', '🎁', '🎈', '🎨', '🖌️', '📚', '📖', '✏️', '🧸', '🪁', '⚽', '🎵', '🔔', '🪞', '💡', '🔑', '🗝️'],
  },
  {
    key: 'symbols',
    label: 'Feelings & Symbols',
    items: ['❤️', '🧡', '💛', '💚', '💙', '💜', '🖤', '🤍', '💔', '💕', '✨', '⭐', '🌟', '💫', '☮️', '♾️', '🕊️', '🙏', '🤝', '🫂', '💭', '💤', '🌀', '⚡', '🌞', '🌝'],
  },
  {
    key: 'conflict',
    label: 'Conflict',
    items: ['⚔️', '🛡️', '🗡️', '🔨', '⚒️', '🧱', '⛓️', '🚧', '⚠️', '❌', '🆘', '💢', '👊', '😠', '😢', '😭', '😨', '😱', '🫥'],
  },
] as const;
---

<div class:list={[containerClass]} data-sandtray-widget>
  <div class="mb-3 flex items-center justify-between flex-wrap gap-2">
    <p class="text-forest-200 text-sm">
      Tap a figure to add it. Drag to move. Double-tap to remove.
    </p>
    <button
      data-sandtray-clear
      class="px-3 py-1.5 rounded-md bg-forest-700 border border-forest-600 text-forest-100 text-sm hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
    >
      Clear tray
    </button>
  </div>

  <div
    data-sandtray-canvas
    class:list={[
      "relative w-full rounded-lg overflow-hidden border-4 border-wood-700 shadow-inner touch-none select-none",
      canvasHeight,
    ]}
    style="background: radial-gradient(ellipse at center, #e8d9a8 0%, #d4c08a 55%, #b89a5e 100%);"
    aria-label="Sandtray canvas"
  ></div>

  <div class="mt-4">
    <div class="flex flex-wrap gap-1 mb-3" role="tablist" aria-label="Figure categories">
      {categories.map((cat, idx) => (
        <button
          data-sandtray-tab={cat.key}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          class:list={[
            "px-3 py-1.5 rounded-md text-sm transition-colors border focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800",
            idx === 0
              ? "bg-bronze-500 text-forest-900 border-bronze-400 font-medium"
              : "bg-forest-700 text-forest-200 border-forest-600 hover:bg-forest-600",
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>
    <div data-sandtray-palette class="p-3 bg-forest-900 rounded-lg border border-forest-700 min-h-[6rem]">
      {categories.map((cat, idx) => (
        <div
          data-sandtray-panel={cat.key}
          class:list={[
            "flex flex-wrap gap-1",
            idx === 0 ? "" : "hidden",
          ]}
          role="tabpanel"
        >
          {cat.items.map((emoji) => (
            <button
              data-sandtray-add={emoji}
              class="w-10 h-10 sm:w-11 sm:h-11 text-2xl sm:text-3xl flex items-center justify-center rounded-md hover:bg-forest-700 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500"
              aria-label={`Add ${emoji}`}
            >
              {emoji}
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const widgets = document.querySelectorAll('[data-sandtray-widget]');
  widgets.forEach((root) => {
    const canvas = root.querySelector<HTMLElement>('[data-sandtray-canvas]')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-sandtray-clear]')!;
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-sandtray-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-sandtray-panel]');
    const addButtons = root.querySelectorAll<HTMLButtonElement>('[data-sandtray-add]');

    // Tab switching
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-sandtray-tab')!;
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.classList.toggle('bg-bronze-500', active);
          t.classList.toggle('text-forest-900', active);
          t.classList.toggle('border-bronze-400', active);
          t.classList.toggle('font-medium', active);
          t.classList.toggle('bg-forest-700', !active);
          t.classList.toggle('text-forest-200', !active);
          t.classList.toggle('border-forest-600', !active);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-sandtray-panel') !== key);
        });
      });
    });

    // Add figure to canvas (centered with small random offset)
    function addFigure(emoji: string) {
      const el = document.createElement('div');
      el.className = 'absolute text-4xl sm:text-5xl leading-none cursor-grab select-none touch-none';
      el.textContent = emoji;
      el.setAttribute('data-sandtray-item', '');
      // Random position near center
      const rect = canvas.getBoundingClientRect();
      const jitterX = (Math.random() - 0.5) * 120;
      const jitterY = (Math.random() - 0.5) * 80;
      const x = rect.width / 2 + jitterX - 24;
      const y = rect.height / 2 + jitterY - 24;
      el.style.left = `${Math.max(4, Math.min(rect.width - 48, x))}px`;
      el.style.top = `${Math.max(4, Math.min(rect.height - 48, y))}px`;
      attachItemHandlers(el);
      canvas.appendChild(el);
    }

    // Drag, click-to-front, double-tap to remove
    function attachItemHandlers(el: HTMLElement) {
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let origLeft = 0;
      let origTop = 0;
      let lastTap = 0;
      let pointerMoved = false;

      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        // Bring to front
        canvas.appendChild(el);
        dragging = true;
        pointerMoved = false;
        startX = e.clientX;
        startY = e.clientY;
        origLeft = parseFloat(el.style.left || '0');
        origTop = parseFloat(el.style.top || '0');
        el.classList.add('cursor-grabbing');
        el.setPointerCapture(e.pointerId);
      });

      el.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) pointerMoved = true;
        const rect = canvas.getBoundingClientRect();
        const newLeft = Math.max(4, Math.min(rect.width - 48, origLeft + dx));
        const newTop = Math.max(4, Math.min(rect.height - 48, origTop + dy));
        el.style.left = `${newLeft}px`;
        el.style.top = `${newTop}px`;
      });

      el.addEventListener('pointerup', (e) => {
        dragging = false;
        el.classList.remove('cursor-grabbing');
        try { el.releasePointerCapture(e.pointerId); } catch {}
        // Double-tap to remove (only if pointer didn't move)
        if (!pointerMoved) {
          const now = Date.now();
          if (now - lastTap < 350) {
            el.remove();
          }
          lastTap = now;
        }
      });

      el.addEventListener('pointercancel', () => {
        dragging = false;
        el.classList.remove('cursor-grabbing');
      });
    }

    addButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const emoji = btn.getAttribute('data-sandtray-add')!;
        addFigure(emoji);
      });
    });

    clearBtn.addEventListener('click', () => {
      canvas.querySelectorAll('[data-sandtray-item]').forEach((el) => el.remove());
    });
  });
</script>
