---
import type { Lang } from '../../i18n';
import { sandtrayCategories, sandtrayFigures } from '../../data/sandtrayFigures';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
}

const { fullscreen = false, lang = 'en' } = Astro.props;

const containerClass = fullscreen
  ? "w-full max-w-5xl mx-auto p-4 flex flex-col"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600 flex flex-col";

const t = {
  en: {
    canvasAriaLabel: 'Sandtray canvas',
    paletteLabel: 'Figure palette',
    stepBack: 'Step back',
    returnToTray: 'Return to tray',
    saveImage: 'Save image',
    levelSand: 'Level the sand',
    clearTray: 'Clear tray',
    confirmLevel: 'Level the sand?',
    confirmClear: 'Clear everything?',
    digMode: '⛏ Dig',
    buildMode: '⛰ Build',
    selected: 'Selected:',
    done: 'Done',
    sandLabel: 'Sand:',
    skinLabel: 'Skin:',
    makeSmaller: 'Make smaller',
    makeBigger: 'Make bigger',
    rotateLeft: 'Rotate left',
    rotateRight: 'Rotate right',
    removeFigure: 'Remove figure',
    chooseSkin: 'Choose skin color',
    deselect: 'Deselect',
    sandTan: 'Tan sand',
    sandBlue: 'Blue sand',
    sandWhite: 'White sand',
    sandDark: 'Dark sand',
    sandGold: 'Gold sand',
    keyboardHelp: 'Keyboard controls: focus the canvas, then press Enter or Space to place a figure chosen from the palette at the center of the tray. With a figure selected, use the arrow keys to move it (hold Shift for larger steps), plus and minus to resize it, the square bracket keys to rotate it, Delete or Backspace to remove it, and Escape to deselect.',
  },
  es: {
    canvasAriaLabel: 'Lienzo de bandeja de arena',
    paletteLabel: 'Paleta de figuras',
    stepBack: 'Da un paso atrás',
    returnToTray: 'Volver a la bandeja',
    saveImage: 'Guardar imagen',
    levelSand: 'Aplanar la arena',
    clearTray: 'Limpiar bandeja',
    confirmLevel: '¿Aplanar la arena?',
    confirmClear: '¿Limpiar todo?',
    digMode: '⛏ Cavar',
    buildMode: '⛰ Construir',
    selected: 'Seleccionado:',
    done: 'Listo',
    sandLabel: 'Arena:',
    skinLabel: 'Piel:',
    makeSmaller: 'Reducir',
    makeBigger: 'Agrandar',
    rotateLeft: 'Girar a la izquierda',
    rotateRight: 'Girar a la derecha',
    removeFigure: 'Quitar figura',
    chooseSkin: 'Elegir color de piel',
    deselect: 'Deseleccionar',
    sandTan: 'Arena tostada',
    sandBlue: 'Arena azul',
    sandWhite: 'Arena blanca',
    sandDark: 'Arena oscura',
    sandGold: 'Arena dorada',
    keyboardHelp: 'Controles de teclado: enfoca el lienzo y pulsa Enter o Espacio para colocar la figura elegida de la paleta en el centro de la bandeja. Con una figura seleccionada, usa las flechas para moverla (mantén Mayús para pasos más grandes), más y menos para cambiar su tamaño, las teclas de corchetes para girarla, Suprimir o Retroceso para quitarla y Escape para deseleccionar.',
  },
};
const s = t[lang];
---

<div
  class:list={[containerClass]}
  data-sandtray-widget
  data-sandtray-i18n={JSON.stringify(s)}
>
  <div data-sandtray-frame class="relative w-full" style="
    padding: 18px;
    border-radius: 14px;
    background:
      linear-gradient(180deg, #6b4a25 0%, #8a5f31 14%, #6e4922 50%, #8a5f31 86%, #5b3c1d 100%),
      repeating-linear-gradient(90deg, rgba(0,0,0,0.06) 0px, rgba(0,0,0,0.06) 1px, transparent 1px, transparent 6px);
    background-blend-mode: multiply;
    box-shadow:
      0 1px 0 rgba(255,235,200,0.25) inset,
      0 -2px 0 rgba(0,0,0,0.35) inset,
      0 18px 30px -12px rgba(0,0,0,0.55);
  ">
    <div data-sandtray-stage class="relative w-full" style="height: clamp(16rem, 50vw, 28rem);">
      <canvas
        data-sandtray-canvas
        tabindex="0"
        class="absolute inset-0 block w-full h-full rounded-md touch-none select-none shadow-[0_0_0_2px_#3a2611_inset,0_6px_14px_rgba(0,0,0,0.35)_inset,0_-2px_6px_rgba(255,235,200,0.18)_inset] focus:outline-none focus:ring-2 focus:ring-bronze-500"
        aria-label={s.canvasAriaLabel}
        aria-describedby="sandtray-kbd-help"
      ></canvas>
    </div>
    <p id="sandtray-kbd-help" class="sr-only">{s.keyboardHelp}</p>

    <!-- Controls bar: right below the sand, inside the wood frame -->
    <div class="mt-3 flex flex-wrap gap-2 items-center">
      <button data-sandtray-mode class="px-3 py-1.5 rounded-md bg-forest-700 text-forest-100 text-sm font-medium hover:bg-forest-600 border border-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800">{s.digMode}</button>
      <button data-sandtray-witness class="px-3 py-1.5 rounded-md bg-forest-700 text-forest-100 text-sm font-medium hover:bg-forest-600 border border-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800">{s.stepBack}</button>
      <button data-sandtray-capture class="px-3 py-1.5 rounded-md bg-forest-700 text-forest-100 text-sm font-medium hover:bg-forest-600 border border-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800">{s.saveImage}</button>
      <button data-sandtray-level class="px-3 py-1.5 rounded-md bg-forest-700 text-forest-100 text-sm font-medium hover:bg-forest-600 border border-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800">{s.levelSand}</button>
      <button data-sandtray-clear class="px-3 py-1.5 rounded-md bg-forest-700 text-forest-100 text-sm font-medium hover:bg-forest-600 border border-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800">{s.clearTray}</button>
      <span class="text-xs text-forest-100 ml-auto mr-1">{s.sandLabel}</span>
      <button data-sand-color="0xe2ceb1" class="w-10 h-10 rounded-full border-2 border-forest-600 ring-2 ring-transparent hover:ring-bronze-400 focus:outline-none focus:ring-2 focus:ring-bronze-500" style="background: #e2ceb1;" aria-label={s.sandTan} title={s.sandTan}></button>
      <button data-sand-color="0x8fb4c9" class="w-10 h-10 rounded-full border-2 border-forest-600 ring-2 ring-transparent hover:ring-bronze-400 focus:outline-none focus:ring-2 focus:ring-bronze-500" style="background: #8fb4c9;" aria-label={s.sandBlue} title={s.sandBlue}></button>
      <button data-sand-color="0xf0ebe3" class="w-10 h-10 rounded-full border-2 border-forest-600 ring-2 ring-transparent hover:ring-bronze-400 focus:outline-none focus:ring-2 focus:ring-bronze-500" style="background: #f0ebe3;" aria-label={s.sandWhite} title={s.sandWhite}></button>
      <button data-sand-color="0x6b5b4f" class="w-10 h-10 rounded-full border-2 border-forest-600 ring-2 ring-transparent hover:ring-bronze-400 focus:outline-none focus:ring-2 focus:ring-bronze-500" style="background: #6b5b4f;" aria-label={s.sandDark} title={s.sandDark}></button>
      <button data-sand-color="0xc9a96e" class="w-10 h-10 rounded-full border-2 border-forest-600 ring-2 ring-transparent hover:ring-bronze-400 focus:outline-none focus:ring-2 focus:ring-bronze-500" style="background: #c9a96e;" aria-label={s.sandGold} title={s.sandGold}></button>
    </div>
  </div>

  <!-- Figure toolbar: appears when a figure is selected -->
  <div
    data-sandtray-figure-toolbar
    class="mt-2 hidden flex-wrap gap-1.5 items-center bg-forest-800 rounded-lg border border-forest-600 px-3 py-2"
  >
    <span data-figure-toolbar-label class="text-sm text-forest-100 mr-2 font-semibold">{s.selected}</span>
    <button data-fig-scale-down class="w-9 h-9 rounded-md bg-forest-700 text-forest-100 text-lg font-bold hover:bg-forest-600 border border-forest-600 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" title={s.makeSmaller} aria-label={s.makeSmaller}>−</button>
    <button data-fig-scale-up class="w-9 h-9 rounded-md bg-forest-700 text-forest-100 text-lg font-bold hover:bg-forest-600 border border-forest-600 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" title={s.makeBigger} aria-label={s.makeBigger}>+</button>
    <span class="text-forest-500 mx-0.5">|</span>
    <button data-fig-rotate-left class="w-9 h-9 rounded-md bg-forest-700 text-forest-100 text-lg hover:bg-forest-600 border border-forest-600 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" title={s.rotateLeft} aria-label={s.rotateLeft}>↺</button>
    <button data-fig-rotate-right class="w-9 h-9 rounded-md bg-forest-700 text-forest-100 text-lg hover:bg-forest-600 border border-forest-600 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" title={s.rotateRight} aria-label={s.rotateRight}>↻</button>
    <span class="text-forest-500 mx-0.5">|</span>
    <label class="text-xs text-forest-200 mr-0.5 flex items-center gap-1">
      {s.skinLabel}
      <input
        data-fig-skin-picker
        type="color"
        value="#ffffff"
        class="w-8 h-8 rounded-full border-2 border-forest-600 cursor-pointer p-0 bg-transparent focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
        style="-webkit-appearance: none; appearance: none;"
        title={s.chooseSkin}
        aria-label={s.chooseSkin}
      />
    </label>
    <span class="text-forest-500 mx-0.5">|</span>
    <button data-fig-remove class="w-9 h-9 rounded-md bg-red-900/30 text-red-300 text-lg font-bold hover:bg-red-900/50 border border-red-500/50 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" title={s.removeFigure} aria-label={s.removeFigure}>✕</button>
    <button data-fig-deselect class="ml-auto text-sm text-forest-300 hover:text-forest-100 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800" aria-label={s.deselect}>{s.done}</button>
  </div>

  <!-- Palette -->
  <div class="mt-3 flex flex-col gap-2 p-3 bg-forest-800 rounded-lg border border-forest-600">
    <input
      data-sandtray-search
      type="search"
      placeholder={lang === 'es' ? 'Buscar figuras...' : 'Search figures...'}
      class="w-full mb-1 px-2 py-1.5 text-base bg-forest-700 text-forest-100 placeholder:text-forest-400 rounded-md border border-forest-600 focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
    />
    <div
      data-sandtray-palette
      role="group"
      aria-label={s.paletteLabel}
      class="overflow-y-auto max-h-40 sm:max-h-64"
    >
      {sandtrayCategories.map((cat) => {
        const figs = sandtrayFigures.filter((f) => f.category === cat.key);
        if (figs.length === 0) return null;
        return (
          <div class="mb-2">
            <div class="text-xs font-semibold text-forest-300 uppercase tracking-wide">
              {cat.label[lang]}
            </div>
            <div class="flex gap-1.5 mt-1 flex-wrap">
              {figs.map((f) => (
                <button
                  type="button"
                  data-sandtray-palette-item={f.id}
                  data-model-path={f.modelPath}
                  data-default-scale={f.defaultScale}
                  class="px-2 py-1 sm:px-2.5 sm:py-1.5 bg-forest-700 text-forest-100 rounded-md border border-forest-600 text-xs sm:text-sm font-medium hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
                  aria-label={f.alt[lang]}
                  aria-pressed="false"
                >
                  {f.alt[lang]}
                </button>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import * as SkeletonUtils from 'three/examples/jsm/utils/SkeletonUtils.js';

  // ----- SandRenderer -----
  // Three.js scene: subdivided plane whose vertices are displaced from a
  // Float32Array height map wrapped in a DataTexture. Carving writes into
  // the array and flags the texture needsUpdate.

  class SandRenderer {
    // Sand height map. heightData[y*mapW + x] is displacement in world units.
    static readonly MAP_W = 160;
    static readonly MAP_H = 112;
    // Tray dimensions in world units. The plane spans ±TRAY_W/2 in X and ±TRAY_H/2 in Z.
    static readonly TRAY_W = 14;
    static readonly TRAY_H = 10;

    canvas: HTMLCanvasElement;
    renderer: THREE.WebGLRenderer;
    scene: THREE.Scene;
    camera: THREE.OrthographicCamera;
    heightData!: Float32Array;
    heightTexture!: THREE.DataTexture;
    sand!: THREE.Mesh;
    sandGeometry!: THREE.PlaneGeometry;
    width: number;   // CSS pixels (was device pixels in the 2D version)
    height: number;  // CSS pixels
    cameraYaw: number = Math.PI * 0.25; // 45° so we start looking from the south-east
    cameraPitch: number = 0.72; // ~41° elevation angle (radians, 0 = horizon, PI/2 = top-down)
    cameraDistance: number = 15;
    isStepped: boolean = false;
    baseFrustumSize: number = 12;
    steppedFrustumSize: number = 18;
    reducedMotion: boolean = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.width = canvas.clientWidth || 640;
      this.height = canvas.clientHeight || 384;

      // Renderer. preserveDrawingBuffer:true is required for toDataURL() capture later.
      this.renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      this.renderer.setSize(this.width, this.height, false);
      this.renderer.setClearColor(0xfdfbf7, 0); // cream, fully transparent (matches CLAUDE.md)

      // Scene
      this.scene = new THREE.Scene();

      // Orthographic camera, isometric-ish framing.
      // World space: tray is centred at origin, spans ~14 units wide x 10 deep.
      // Camera sits up and to the south-east, looking at origin.
      const aspect = this.width / this.height;
      const frustumSize = 12;
      this.camera = new THREE.OrthographicCamera(
        (-frustumSize * aspect) / 2,
        (frustumSize * aspect) / 2,
        frustumSize / 2,
        -frustumSize / 2,
        0.1,
        100,
      );
      this.updateCamera();

      // Directional light from upper-left, matching the old 2D directional shading.
      // Shadow maps enabled for figure drop-shadows on the sand.
      this.renderer.shadowMap.enabled = true;
      this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const dir = new THREE.DirectionalLight(0xffffff, 1.3);
      dir.position.set(-6, 10, 4);
      dir.castShadow = true;
      dir.shadow.mapSize.set(1024, 1024);
      dir.shadow.camera.near = 0.5;
      dir.shadow.camera.far = 30;
      dir.shadow.camera.left = -10;
      dir.shadow.camera.right = 10;
      dir.shadow.camera.top = 10;
      dir.shadow.camera.bottom = -10;
      this.scene.add(dir);
      this.scene.add(new THREE.AmbientLight(0xffffff, 0.35));

      this.buildSand();

      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Start the render loop. Pause it entirely while the page is hidden.
      this.renderer.setAnimationLoop(() => this.render());
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          this.renderer.setAnimationLoop(null);
        } else {
          this.renderer.setAnimationLoop(() => this.render());
        }
      });
    }

    initHeightMap(target?: Float32Array): Float32Array {
      const W = SandRenderer.MAP_W;
      const H = SandRenderer.MAP_H;
      const buf = target ?? new Float32Array(W * H);
      // Faint sinusoidal noise, amplitude ~0.02 world units, to give the sand
      // some initial texture so it doesn't look like a flat green plate.
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const n = (
            Math.sin(x * 0.21 + y * 0.13) * 0.010 +
            Math.sin(x * 0.07 - y * 0.19) * 0.008 +
            Math.cos(x * 0.33 + y * 0.05) * 0.006
          );
          buf[y * W + x] = n;
        }
      }
      return buf;
    }

    buildSand(): void {
      this.heightData = this.initHeightMap();

      this.heightTexture = new THREE.DataTexture(
        this.heightData,
        SandRenderer.MAP_W,
        SandRenderer.MAP_H,
        THREE.RedFormat,
        THREE.FloatType,
      );
      this.heightTexture.minFilter = THREE.LinearFilter;
      this.heightTexture.magFilter = THREE.LinearFilter;
      this.heightTexture.needsUpdate = true;

      // Highly subdivided plane so the vertex displacement has resolution.
      this.sandGeometry = new THREE.PlaneGeometry(
        SandRenderer.TRAY_W,
        SandRenderer.TRAY_H,
        SandRenderer.MAP_W - 1,
        SandRenderer.MAP_H - 1,
      );
      // Rotate the plane so it lies flat on the XZ plane (Y = up).
      this.sandGeometry.rotateX(-Math.PI / 2);

      // Custom ShaderMaterial that displaces vertices from the height texture.
      // Three terrain zones blended by height:
      //   Below waterLevel → blue water with subtle wave sheen
      //   Around zero      → sand (user-chosen color)
      //   Above rockLevel  → grey-brown rock/mountain
      const sandMat = new THREE.ShaderMaterial({
        uniforms: {
          uHeight:     { value: this.heightTexture },
          uLightDir:   { value: new THREE.Vector3(-0.6, 1.0, 0.4).normalize() },
          uSandColor:  { value: new THREE.Color(0xe2ceb1) },
          uWaterColor: { value: new THREE.Color(0x3b7ea1) },
          uRockColor:  { value: new THREE.Color(0x7a7265) },
          uAmbient:    { value: 0.35 },
          uWaterLevel: { value: -0.15 },
          uRockLevel:  { value: 0.25 },
          uTime:       { value: 0.0 },
        },
        vertexShader: /* glsl */`
          uniform sampler2D uHeight;
          varying vec3 vNormalW;
          varying float vHeight;
          varying vec2 vUv;

          vec3 computeNormal(vec2 uv) {
            vec2 texel = vec2(1.0 / ${SandRenderer.MAP_W}.0, 1.0 / ${SandRenderer.MAP_H}.0);
            float hL = texture2D(uHeight, uv + vec2(-texel.x, 0.0)).r;
            float hR = texture2D(uHeight, uv + vec2( texel.x, 0.0)).r;
            float hD = texture2D(uHeight, uv + vec2(0.0, -texel.y)).r;
            float hU = texture2D(uHeight, uv + vec2(0.0,  texel.y)).r;
            float dx = ${SandRenderer.TRAY_W.toFixed(4)} / ${SandRenderer.MAP_W}.0;
            float dz = ${SandRenderer.TRAY_H.toFixed(4)} / ${SandRenderer.MAP_H}.0;
            vec3 n = normalize(vec3((hL - hR) / (2.0 * dx), 1.0, (hD - hU) / (2.0 * dz)));
            return n;
          }

          void main() {
            float h = texture2D(uHeight, uv).r;
            vec3 displaced = position + vec3(0.0, h, 0.0);
            vNormalW = computeNormal(uv);
            vHeight = h;
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(displaced, 1.0);
          }
        `,
        fragmentShader: /* glsl */`
          uniform vec3  uLightDir;
          uniform vec3  uSandColor;
          uniform vec3  uWaterColor;
          uniform vec3  uRockColor;
          uniform float uAmbient;
          uniform float uWaterLevel;
          uniform float uRockLevel;
          uniform float uTime;
          varying vec3  vNormalW;
          varying float vHeight;
          varying vec2  vUv;

          void main() {
            float ndotl = max(dot(normalize(vNormalW), normalize(uLightDir)), 0.0);
            float lit = uAmbient + ndotl * (1.0 - uAmbient);

            // Blend zones based on height.
            vec3 baseColor;
            if (vHeight < uWaterLevel) {
              // Water zone: flat blue with subtle animated shimmer.
              float shimmer = 0.03 * sin(vUv.x * 40.0 + uTime * 2.0) * sin(vUv.y * 30.0 + uTime * 1.5);
              float depth = smoothstep(uWaterLevel, uWaterLevel - 0.3, vHeight);
              baseColor = mix(uSandColor, uWaterColor, depth) + shimmer;
              // Water is flatter-lit (less directional shading).
              lit = mix(lit, uAmbient + 0.4, depth);
            } else if (vHeight > uRockLevel) {
              // Rock/mountain zone: grey-brown, rougher shading.
              float rockBlend = smoothstep(uRockLevel, uRockLevel + 0.2, vHeight);
              baseColor = mix(uSandColor, uRockColor, rockBlend);
              // Rock has more contrast (stronger directional light).
              lit = lit * (1.0 + rockBlend * 0.3);
            } else {
              // Sand zone: normal behavior.
              baseColor = uSandColor;
            }

            float depthShade = clamp(0.5 + vHeight * 4.0, 0.8, 1.2);
            vec3 col = baseColor * lit * depthShade;
            gl_FragColor = vec4(col, 1.0);
          }
        `,
      });

      this.sand = new THREE.Mesh(this.sandGeometry, sandMat);
      this.sand.receiveShadow = true;
      this.scene.add(this.sand);

      // Add a shadow-receiving plane just below the sand so figures cast
      // visible shadows. The custom ShaderMaterial doesn't receive Three.js
      // shadows natively, so we layer a transparent MeshStandardMaterial
      // plane underneath that captures the shadow map.
      const shadowPlane = new THREE.Mesh(
        new THREE.PlaneGeometry(SandRenderer.TRAY_W, SandRenderer.TRAY_H),
        new THREE.ShadowMaterial({ opacity: 0.3 }),
      );
      shadowPlane.rotation.x = -Math.PI / 2;
      shadowPlane.position.y = -0.01; // just below sand surface
      shadowPlane.receiveShadow = true;
      this.scene.add(shadowPlane);
    }

    resize(): void {
      const w = this.canvas.clientWidth || 640;
      const h = this.canvas.clientHeight || 384;
      if (w === this.width && h === this.height) return;
      this.width = w;
      this.height = h;
      this.renderer.setSize(w, h, false);
      this.updateZoom(this.isStepped ? this.steppedFrustumSize : this.baseFrustumSize);
    }

    updateZoom(frustumSize: number): void {
      const aspect = this.width / this.height;
      this.camera.left = (-frustumSize * aspect) / 2;
      this.camera.right = (frustumSize * aspect) / 2;
      this.camera.top = frustumSize / 2;
      this.camera.bottom = -frustumSize / 2;
      this.camera.updateProjectionMatrix();
    }

    stepBack(): void {
      this.isStepped = true;
      this.updateZoom(this.steppedFrustumSize);
    }

    stepIn(): void {
      this.isStepped = false;
      this.updateZoom(this.baseFrustumSize);
    }

    toggleStep(): boolean {
      if (this.isStepped) {
        this.stepIn();
        return false;
      }
      this.stepBack();
      return true;
    }

    updateCamera(): void {
      const horizDist = Math.cos(this.cameraPitch) * this.cameraDistance;
      const y = Math.sin(this.cameraPitch) * this.cameraDistance;
      const x = Math.sin(this.cameraYaw) * horizDist;
      const z = Math.cos(this.cameraYaw) * horizDist;
      this.camera.position.set(x, y, z);
      this.camera.lookAt(0, 0, 0);
    }

    setYaw(yaw: number): void {
      this.cameraYaw = yaw;
      this.updateCamera();
    }

    nudgeYaw(delta: number): void {
      this.cameraYaw += delta;
      this.updateCamera();
    }

    setPitch(pitch: number): void {
      // Clamp between ~10° (near horizon) and ~85° (near top-down).
      this.cameraPitch = Math.max(0.17, Math.min(1.48, pitch));
      this.updateCamera();
    }

    render(): void {
      // Update water shimmer animation time (frozen under prefers-reduced-motion).
      if (!this.reducedMotion) {
        const mat = this.sand.material as THREE.ShaderMaterial;
        mat.uniforms.uTime.value = performance.now() * 0.001;
      }
      this.renderer.render(this.scene, this.camera);
    }

    /**
     * Lower the sand in a circular region.
     * x, z are in world space (the tray plane). radius is in world units.
     * depth is the maximum additional lowering at the centre of the brush (world units).
     */
    carve(x: number, z: number, radius: number, depth: number): void {
      const W = SandRenderer.MAP_W;
      const H = SandRenderer.MAP_H;
      // Convert world (x, z) to map indices.
      // After the plane's -PI/2 X-rotation, plane-local +Y (which maps to uv.y = 1.0)
      // becomes world -Z. So row (H-1) of the height map corresponds to world z = -TRAY_H/2
      // (the "north" edge of the tray), and row 0 corresponds to world z = +TRAY_H/2.
      const cx = ((x + SandRenderer.TRAY_W / 2) / SandRenderer.TRAY_W) * (W - 1);
      const cy = ((SandRenderer.TRAY_H / 2 - z) / SandRenderer.TRAY_H) * (H - 1);
      // Convert world radius to map pixels (use the larger of the two axes for a conservative bound).
      const rPix = Math.max(
        (radius / SandRenderer.TRAY_W) * W,
        (radius / SandRenderer.TRAY_H) * H,
      );
      const rPix2 = rPix * rPix;

      const x0 = Math.max(0, Math.floor(cx - rPix));
      const x1 = Math.min(W - 1, Math.ceil(cx + rPix));
      const y0 = Math.max(0, Math.floor(cy - rPix));
      const y1 = Math.min(H - 1, Math.ceil(cy + rPix));

      for (let y = y0; y <= y1; y++) {
        for (let px = x0; px <= x1; px++) {
          const dx = px - cx;
          const dy = y - cy;
          const d2 = dx * dx + dy * dy;
          if (d2 > rPix2) continue;
          // Quadratic falloff from 1.0 at centre to 0.0 at edge.
          const falloff = 1 - d2 / rPix2;
          this.heightData[y * W + px] -= depth * falloff * falloff;
        }
      }
      this.heightTexture.needsUpdate = true;
    }

    /** Sample the height map at world (x, z) and return the Y displacement. */
    sampleHeight(x: number, z: number): number {
      const W = SandRenderer.MAP_W;
      const H = SandRenderer.MAP_H;
      const mx = ((x + SandRenderer.TRAY_W / 2) / SandRenderer.TRAY_W) * (W - 1);
      const my = ((SandRenderer.TRAY_H / 2 - z) / SandRenderer.TRAY_H) * (H - 1);
      const ix = Math.max(0, Math.min(W - 1, Math.round(mx)));
      const iy = Math.max(0, Math.min(H - 1, Math.round(my)));
      return this.heightData[iy * W + ix];
    }

    /** Change the sand color at runtime. */
    setSandColor(hex: number): void {
      const mat = this.sand.material as THREE.ShaderMaterial;
      (mat.uniforms.uSandColor.value as THREE.Color).set(hex);
    }

    level(): void {
      // Refill this.heightData (which is the same buffer the DataTexture wraps)
      // in place, so the GPU sees the refreshed noise and subsequent carve()
      // writes still land in the buffer the texture uploads.
      this.initHeightMap(this.heightData);
      this.heightTexture.needsUpdate = true;
    }
  }

  // ----- FigureManager -----
  // Loads GLB models via GLTFLoader, caches templates by path, clones them
  // for placement in the Three.js scene, and removes them on clear.

  interface PlacedFigure {
    instanceId: string;
    figureId: string;
    group: THREE.Group;
    x: number;
    z: number;
    rotationY: number;
    scale: number;
  }

  class FigureManager {
    scene: THREE.Scene;
    renderer: SandRenderer;
    loader: GLTFLoader;
    cache: Map<string, THREE.Group> = new Map();
    placed: PlacedFigure[] = [];
    idCounter: number = 0;

    constructor(scene: THREE.Scene, renderer: SandRenderer) {
      this.scene = scene;
      this.renderer = renderer;
      this.loader = new GLTFLoader();
    }

    /** Load a GLB file by path, caching the result. Returns a cloneable template group. */
    async loadTemplate(modelPath: string): Promise<THREE.Group> {
      const cached = this.cache.get(modelPath);
      if (cached) return cached;
      const gltf = await this.loader.loadAsync(modelPath);
      this.cache.set(modelPath, gltf.scene);
      return gltf.scene;
    }

    /** Place a new figure instance at the given world (x, z) position. */
    async place(figureId: string, modelPath: string, x: number, z: number, scale = 1): Promise<PlacedFigure> {
      const template = await this.loadTemplate(modelPath);
      // SkeletonUtils.clone correctly rebinds skinned meshes to their cloned
      // skeletons. Object3D.clone(true) does NOT — the cloned mesh's bones
      // still reference the original skeleton, causing armor to float and
      // rigged characters to collapse to their bind pose.
      const group = SkeletonUtils.clone(template) as THREE.Group;
      // KayKit characters are ~1.8 units tall in the Y axis. Scale accordingly.
      group.scale.setScalar(scale);
      // Snap Y to the sand surface height at this position.
      const sandY = this.renderer.sampleHeight(x, z);
      group.position.set(x, sandY, z);
      group.rotation.y = 0;
      group.userData.modelPath = modelPath; // for undo restore
      // Enable shadow casting on every mesh in the figure.
      group.traverse((child) => {
        if ((child as THREE.Mesh).isMesh) {
          child.castShadow = true;
        }
      });
      this.scene.add(group);

      const instance: PlacedFigure = {
        instanceId: `fig-${++this.idCounter}`,
        figureId,
        group,
        x,
        z,
        rotationY: 0,
        scale,
      };
      this.placed.push(instance);
      return instance;
    }

    clearAll(): void {
      for (const f of this.placed) this.scene.remove(f.group);
      this.placed = [];
    }

    remove(instanceId: string): void {
      const idx = this.placed.findIndex((f) => f.instanceId === instanceId);
      if (idx < 0) return;
      this.scene.remove(this.placed[idx].group);
      this.placed.splice(idx, 1);
    }
  }

  // ----- Bootstrap -----
  const widgets = document.querySelectorAll<HTMLElement>('[data-sandtray-widget]');
  widgets.forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-sandtray-canvas]');
    if (!canvas) return;
    const i18n = JSON.parse(root.getAttribute('data-sandtray-i18n') || '{}');
    const renderer = new SandRenderer(canvas);
    renderer.resize();

    let resizeTimer: number | null = null;
    window.addEventListener('resize', () => {
      if (resizeTimer !== null) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => renderer.resize(), 150);
    });

    // ----- Dig / Build mode toggle -----
    let buildMode = false; // false = dig down, true = build up
    const modeBtn = root.querySelector<HTMLButtonElement>('[data-sandtray-mode]');
    modeBtn?.addEventListener('click', () => {
      buildMode = !buildMode;
      if (modeBtn) {
        modeBtn.textContent = buildMode ? i18n.buildMode : i18n.digMode;
        modeBtn.classList.toggle('bg-bronze-500', buildMode);
        modeBtn.classList.toggle('text-forest-900', buildMode);
        modeBtn.classList.toggle('bg-forest-700', !buildMode);
        modeBtn.classList.toggle('text-forest-100', !buildMode);
      }
    });

    // ----- Carving interaction -----
    const raycaster = new THREE.Raycaster();
    const ndc = new THREE.Vector2();

    function canvasToWorld(evt: PointerEvent): { x: number; z: number } | null {
      const rect = canvas.getBoundingClientRect();
      ndc.x = ((evt.clientX - rect.left) / rect.width) * 2 - 1;
      ndc.y = -((evt.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(ndc, renderer.camera);
      const hits = raycaster.intersectObject(renderer.sand, false);
      if (hits.length === 0) return null;
      const p = hits[0].point;
      return { x: p.x, z: p.z };
    }

    // Pointer state for carving, two-finger twist, right-click orbit, figure drag, and pinch-to-scale.
    const activePointers = new Map<number, { x: number; y: number }>();
    let isCarving = false;
    // Snapshot taken at pointerdown but only pushed to the undo stack when the
    // gesture actually carves (not when it turns into an orbit/pinch).
    let pendingCarveSnapshot: Float32Array | null = null;

    function commitCarveSnapshot(): void {
      if (!pendingCarveSnapshot) return;
      pushUndo({ type: 'carve', snapshot: pendingCarveSnapshot });
      pendingCarveSnapshot = null;
    }
    let twistStartAngle: number | null = null;
    let twistStartYaw = 0;
    let draggingFigure: PlacedFigure | null = null;
    // Right-click orbit (mouse users who can't two-finger twist).
    let isRightDragOrbit = false;
    let rightDragStartX = 0;
    let rightDragStartY = 0;
    let rightDragStartYaw = 0;
    let rightDragStartPitch = 0;
    // Right-click on a figure → rotate it instead of orbiting the camera.
    let rightDragFigure: PlacedFigure | null = null;
    let rightDragFigureStartX = 0;
    let rightDragFigureStartRot = 0;
    // Pinch-to-scale (two-finger gesture on a placed figure).
    let pinchFigure: PlacedFigure | null = null;
    let pinchStartDist = 0;
    let pinchStartScale = 1;

    function anglesFromPointers(): number | null {
      if (activePointers.size < 2) return null;
      const [a, b] = Array.from(activePointers.values());
      return Math.atan2(b.y - a.y, b.x - a.x);
    }

    function distBetweenPointers(): number {
      if (activePointers.size < 2) return 0;
      const [a, b] = Array.from(activePointers.values());
      return Math.hypot(b.x - a.x, b.y - a.y);
    }

    function findFigureAtPointer(evt: PointerEvent | MouseEvent): PlacedFigure | null {
      const rect = canvas.getBoundingClientRect();
      ndc.x = ((evt.clientX - rect.left) / rect.width) * 2 - 1;
      ndc.y = -((evt.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(ndc, renderer.camera);
      // Raycast against every placed figure's group. Take the first hit.
      for (const fig of figureManager.placed) {
        const hits = raycaster.intersectObject(fig.group, true);
        if (hits.length > 0) return fig;
      }
      return null;
    }

    // Prevent context menu on canvas so right-drag orbit works.
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      // Two fingers down → check if first finger was on a figure (pinch-to-scale)
      // or on empty sand (two-finger orbit). Must run BEFORE the single-finger
      // carve path can fire.
      if (activePointers.size === 2) {
        isCarving = false;
        // If we were dragging a figure with the first finger, convert to pinch-scale.
        if (draggingFigure) {
          pinchFigure = draggingFigure;
          pinchStartDist = distBetweenPointers();
          pinchStartScale = draggingFigure.scale;
          draggingFigure = null; // release drag; pinch takes over
        } else {
          // No figure drag → orbit the camera (yaw + pitch).
          twistStartAngle = anglesFromPointers();
          twistStartYaw = renderer.cameraYaw;
          pinchStartDist = distBetweenPointers(); // reuse for pitch via vertical spread change
        }
        return;
      }
      // Right-click drag → orbit camera OR rotate a figure if clicking on one.
      if (e.button === 2) {
        const figHit = findFigureAtPointer(e);
        if (figHit) {
          // Right-drag on a figure → rotate it around Y.
          rightDragFigure = figHit;
          selectedFigure = figHit; // mark as selected for Ctrl+scroll scaling
          rightDragFigureStartX = e.clientX;
          rightDragFigureStartRot = figHit.rotationY;
        } else {
          // Right-drag on empty sand → orbit camera (yaw + pitch).
          isRightDragOrbit = true;
          rightDragStartX = e.clientX;
          rightDragStartY = e.clientY;
          rightDragStartYaw = renderer.cameraYaw;
          rightDragStartPitch = renderer.cameraPitch;
        }
        canvas.setPointerCapture(e.pointerId);
        return;
      }
      const w = canvasToWorld(e);
      if (!w) return;
      // Tap-to-place: if a palette figure is pending, place it and clear selection.
      if (pendingFigure) {
        const pf = pendingFigure;
        figureManager.place(pf.figureId, pf.modelPath, w.x, w.z, pf.scale)
          .then((fig) => pushUndo({ type: 'place', instanceId: fig.instanceId }))
          .catch((err) => console.error('[sandtray] place failed:', err));
        setPendingFigure(null);
        return;
      }
      // Drag existing figure? Raycast against placed figures; if we hit one, start dragging it.
      const hit = findFigureAtPointer(e);
      if (hit) {
        draggingFigure = hit;
        selectedFigure = hit; // mark as selected for Ctrl+scroll scaling
        canvas.setPointerCapture(e.pointerId);
        return;
      }
      // Single finger down → start carving at the hit point (if any).
      // Snapshot the height map now; it's only pushed to undo on the first carve.
      pendingCarveSnapshot = snapshotHeightMap();
      isCarving = true;
      canvas.setPointerCapture(e.pointerId);
      queueMicrotask(() => {
        if (isCarving && activePointers.size === 1) {
          commitCarveSnapshot();
          renderer.carve(w.x, w.z, 0.8, buildMode ? -0.12 : 0.12);
        }
      });
    });

    canvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (activePointers.has(e.pointerId)) {
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      }
      // Pinch-to-scale a placed figure.
      if (pinchFigure) {
        const dist = distBetweenPointers();
        if (pinchStartDist > 0) {
          const ratio = dist / pinchStartDist;
          const newScale = Math.max(0.2, Math.min(5.0, pinchStartScale * ratio));
          pinchFigure.scale = newScale;
          pinchFigure.group.scale.setScalar(newScale);
        }
        return;
      }
      // Right-click drag on a figure → rotate it.
      if (rightDragFigure) {
        const dx = e.clientX - rightDragFigureStartX;
        rightDragFigure.rotationY = rightDragFigureStartRot + dx * 0.015;
        rightDragFigure.group.rotation.y = rightDragFigure.rotationY;
        return;
      }
      // Right-click drag orbit → horizontal = yaw, vertical = pitch.
      if (isRightDragOrbit) {
        const dx = e.clientX - rightDragStartX;
        const dy = e.clientY - rightDragStartY;
        renderer.setYaw(rightDragStartYaw - dx * 0.008);
        renderer.setPitch(rightDragStartPitch + dy * 0.005);
        return;
      }
      // Two-finger twist in progress → update camera yaw and skip carving.
      if (twistStartAngle !== null) {
        const a = anglesFromPointers();
        if (a !== null) {
          const delta = a - twistStartAngle;
          renderer.setYaw(twistStartYaw - delta);
        }
        return;
      }
      // Drag in progress → reposition along the sand plane, snapping Y to sand height.
      if (draggingFigure) {
        const w = canvasToWorld(e);
        if (!w) return;
        draggingFigure.x = w.x;
        draggingFigure.z = w.z;
        const sandY = renderer.sampleHeight(w.x, w.z);
        draggingFigure.group.position.set(w.x, sandY, w.z);
        return;
      }
      // Single-finger carving → brush at the current hit point.
      if (!isCarving) return;
      const w = canvasToWorld(e);
      if (!w) return;
      commitCarveSnapshot();
      renderer.carve(w.x, w.z, 0.8, buildMode ? -0.08 : 0.08);
    });

    canvas.addEventListener('pointerup', (e: PointerEvent) => {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) { twistStartAngle = null; pinchFigure = null; }
      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
      isRightDragOrbit = false;
      rightDragFigure = null;
      draggingFigure = null;
      isCarving = false;
      pendingCarveSnapshot = null;
    });

    canvas.addEventListener('pointercancel', (e: PointerEvent) => {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) { twistStartAngle = null; pinchFigure = null; }
      isRightDragOrbit = false;
      rightDragFigure = null;
      draggingFigure = null;
      isCarving = false;
      pendingCarveSnapshot = null;
    });

    canvas.addEventListener('dblclick', (e: MouseEvent) => {
      const hit = findFigureAtPointer(e);
      if (hit) {
        pushUndo({
          type: 'remove',
          figureId: hit.figureId,
          modelPath: hit.group.userData.modelPath || '',
          x: hit.x,
          z: hit.z,
          rotationY: hit.rotationY,
          scale: hit.scale,
        });
        if (selectedFigure?.instanceId === hit.instanceId) selectedFigure = null;
        figureManager.remove(hit.instanceId);
      }
    });

    // Ctrl+Z / Cmd+Z → undo last action.
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
        e.preventDefault();
        const action = undoStack.pop();
        if (!action) return;
        if (action.type === 'place') {
          // Undo a placement → remove the figure.
          figureManager.remove(action.instanceId);
        } else if (action.type === 'remove') {
          // Undo a removal → re-place the figure.
          figureManager.place(action.figureId, action.modelPath, action.x, action.z, action.scale)
            .then((fig) => {
              fig.rotationY = action.rotationY;
              fig.group.rotation.y = action.rotationY;
            })
            .catch(() => {});
        } else if (action.type === 'carve' || action.type === 'level') {
          // Undo a carve stroke or leveling → restore the height map snapshot.
          renderer.heightData.set(action.snapshot);
          renderer.heightTexture.needsUpdate = true;
        } else if (action.type === 'clear') {
          // Undo a full clear → restore the height map and re-place every figure.
          renderer.heightData.set(action.snapshot);
          renderer.heightTexture.needsUpdate = true;
          for (const f of action.figures) {
            figureManager.place(f.figureId, f.modelPath, f.x, f.z, f.scale)
              .then((fig) => {
                fig.rotationY = f.rotationY;
                fig.group.rotation.y = f.rotationY;
              })
              .catch(() => {});
          }
        }
      }
    });

    // Track the last-clicked figure so Ctrl+scroll can scale it.
    let selectedFigure: PlacedFigure | null = null;

    // Scroll wheel:
    //   Plain scroll       → zoom camera
    //   Ctrl/Cmd + scroll  → scale the selected figure (last clicked/dragged)
    canvas.addEventListener('wheel', (e: WheelEvent) => {
      e.preventDefault();
      if ((e.ctrlKey || e.metaKey) && selectedFigure) {
        // Scale the selected figure.
        const scaleSpeed = 0.01;
        const newScale = Math.max(0.2, Math.min(5.0, selectedFigure.scale - e.deltaY * scaleSpeed));
        selectedFigure.scale = newScale;
        selectedFigure.group.scale.setScalar(newScale);
        return;
      }
      // Zoom camera.
      const zoomSpeed = 0.005;
      const current = renderer.isStepped ? renderer.steppedFrustumSize : renderer.baseFrustumSize;
      const next = Math.max(6, Math.min(30, current + e.deltaY * zoomSpeed));
      if (renderer.isStepped) {
        renderer.steppedFrustumSize = next;
      } else {
        renderer.baseFrustumSize = next;
      }
      renderer.updateZoom(next);
    }, { passive: false });

    // ----- Undo stack -----
    type UndoFigureState = { figureId: string; modelPath: string; x: number; z: number; rotationY: number; scale: number };
    type UndoAction =
      | { type: 'place'; instanceId: string }
      | { type: 'remove' } & UndoFigureState
      | { type: 'carve'; snapshot: Float32Array }
      | { type: 'level'; snapshot: Float32Array }
      | { type: 'clear'; snapshot: Float32Array; figures: UndoFigureState[] };
    const undoStack: UndoAction[] = [];
    const MAX_UNDO = 30;

    function pushUndo(action: UndoAction): void {
      undoStack.push(action);
      if (undoStack.length > MAX_UNDO) undoStack.shift();
    }

    function snapshotHeightMap(): Float32Array {
      return new Float32Array(renderer.heightData);
    }

    // ----- Figure manager -----
    const figureManager = new FigureManager(renderer.scene, renderer);

    // ----- Palette tap-to-place -----
    let pendingFigure: { figureId: string; modelPath: string; scale: number } | null = null;

    // Highlight the currently-selected palette button.
    function setPendingFigure(el: HTMLButtonElement | null): void {
      root.querySelectorAll<HTMLButtonElement>('[data-sandtray-palette-item]').forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        b.classList.remove('bg-bronze-500', 'text-forest-900');
        b.classList.add('bg-forest-700', 'text-forest-100');
      });
      if (el) {
        const figureId = el.dataset.sandtrayPaletteItem;
        const modelPath = el.dataset.modelPath;
        const scaleStr = el.dataset.defaultScale;
        if (!figureId || !modelPath || !scaleStr) {
          console.error('[sandtray] palette button missing data attributes', el);
          pendingFigure = null;
          return;
        }
        el.setAttribute('aria-pressed', 'true');
        el.classList.remove('bg-forest-700', 'text-forest-100');
        el.classList.add('bg-bronze-500', 'text-forest-900');
        pendingFigure = {
          figureId,
          modelPath,
          scale: parseFloat(scaleStr),
        };
      } else {
        pendingFigure = null;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-sandtray-palette-item]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const already = btn.getAttribute('aria-pressed') === 'true';
        setPendingFigure(already ? null : btn);
      });
    });

    // ----- Witness mode -----
    const witnessBtn = root.querySelector<HTMLButtonElement>('[data-sandtray-witness]');
    witnessBtn?.addEventListener('click', () => {
      const stepped = renderer.toggleStep();
      witnessBtn.textContent = stepped ? i18n.returnToTray : i18n.stepBack;
    });

    // ----- Capture / level / clear -----
    root.querySelector<HTMLButtonElement>('[data-sandtray-capture]')?.addEventListener('click', () => {
      // Force one render so the back buffer is current before we read it.
      renderer.renderer.render(renderer.scene, renderer.camera);
      const dataUrl = renderer.renderer.domElement.toDataURL('image/png');
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = 'sandtray.png';
      a.click();
    });

    // Two-step confirm: first click arms the button with a confirm label; a
    // second click within 3s runs the action, otherwise the button reverts.
    function confirmable(btn: HTMLButtonElement | null, label: string, confirmLabel: string, action: () => void): void {
      if (!btn) return;
      let timer: number | null = null;
      btn.addEventListener('click', () => {
        if (timer !== null) {
          window.clearTimeout(timer);
          timer = null;
          btn.textContent = label;
          action();
          return;
        }
        btn.textContent = confirmLabel;
        timer = window.setTimeout(() => {
          timer = null;
          btn.textContent = label;
        }, 3000);
      });
    }

    confirmable(
      root.querySelector<HTMLButtonElement>('[data-sandtray-level]'),
      i18n.levelSand,
      i18n.confirmLevel,
      () => {
        pushUndo({ type: 'level', snapshot: snapshotHeightMap() });
        renderer.level();
      },
    );

    confirmable(
      root.querySelector<HTMLButtonElement>('[data-sandtray-clear]'),
      i18n.clearTray,
      i18n.confirmClear,
      () => {
        pushUndo({
          type: 'clear',
          snapshot: snapshotHeightMap(),
          figures: figureManager.placed.map((f) => ({
            figureId: f.figureId,
            modelPath: f.group.userData.modelPath || '',
            x: f.x,
            z: f.z,
            rotationY: f.rotationY,
            scale: f.scale,
          })),
        });
        figureManager.clearAll();
        renderer.level();
      },
    );

    // ----- Sand color picker -----
    root.querySelectorAll<HTMLButtonElement>('[data-sand-color]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hex = parseInt(btn.dataset.sandColor || '0xe2ceb1');
        renderer.setSandColor(hex);
        // Highlight selected swatch.
        root.querySelectorAll<HTMLButtonElement>('[data-sand-color]').forEach((b) => {
          b.classList.toggle('ring-bronze-500', b === btn);
          b.classList.toggle('ring-transparent', b !== btn);
        });
      });
    });

    // ----- Figure search / filter -----
    const searchInput = root.querySelector<HTMLInputElement>('[data-sandtray-search]');
    searchInput?.addEventListener('input', () => {
      const q = (searchInput.value || '').toLowerCase().trim();
      root.querySelectorAll<HTMLButtonElement>('[data-sandtray-palette-item]').forEach((btn) => {
        const label = (btn.textContent || '').toLowerCase();
        btn.style.display = q && !label.includes(q) ? 'none' : '';
      });
      root.querySelectorAll<HTMLElement>('[data-sandtray-palette] > div').forEach((catDiv) => {
        const visible = catDiv.querySelectorAll<HTMLButtonElement>('[data-sandtray-palette-item]:not([style*="display: none"])');
        (catDiv as HTMLElement).style.display = visible.length === 0 && q ? 'none' : '';
      });
    });

    // ----- Figure toolbar (on-screen controls for scale / rotate / remove) -----
    const toolbar = root.querySelector<HTMLElement>('[data-sandtray-figure-toolbar]');
    const toolbarLabel = root.querySelector<HTMLElement>('[data-figure-toolbar-label]');

    function showToolbar(fig: PlacedFigure): void {
      selectedFigure = fig;
      if (!toolbar) return;
      toolbar.classList.remove('hidden');
      toolbar.classList.add('flex');
      const paletteBtn = root.querySelector<HTMLButtonElement>(`[data-sandtray-palette-item="${fig.figureId}"]`);
      const name = paletteBtn?.textContent?.trim() || fig.figureId;
      if (toolbarLabel) toolbarLabel.textContent = name + ':';
    }

    function hideToolbar(): void {
      selectedFigure = null;
      if (!toolbar) return;
      toolbar.classList.add('hidden');
      toolbar.classList.remove('flex');
    }

    // Scale buttons
    root.querySelector('[data-fig-scale-up]')?.addEventListener('click', () => {
      if (!selectedFigure) return;
      const s = Math.min(5.0, selectedFigure.scale + 0.15);
      selectedFigure.scale = s;
      selectedFigure.group.scale.setScalar(s);
    });
    root.querySelector('[data-fig-scale-down]')?.addEventListener('click', () => {
      if (!selectedFigure) return;
      const s = Math.max(0.2, selectedFigure.scale - 0.15);
      selectedFigure.scale = s;
      selectedFigure.group.scale.setScalar(s);
    });

    // Rotate buttons (22.5° per click = 16 clicks for full rotation)
    root.querySelector('[data-fig-rotate-left]')?.addEventListener('click', () => {
      if (!selectedFigure) return;
      selectedFigure.rotationY -= Math.PI / 8;
      selectedFigure.group.rotation.y = selectedFigure.rotationY;
    });
    root.querySelector('[data-fig-rotate-right]')?.addEventListener('click', () => {
      if (!selectedFigure) return;
      selectedFigure.rotationY += Math.PI / 8;
      selectedFigure.group.rotation.y = selectedFigure.rotationY;
    });

    // Remove the selected figure through the undo stack. Shared by the
    // toolbar remove button and the Delete/Backspace keyboard shortcut.
    function removeSelectedFigure(): void {
      if (!selectedFigure) return;
      pushUndo({
        type: 'remove',
        figureId: selectedFigure.figureId,
        modelPath: selectedFigure.group.userData.modelPath || '',
        x: selectedFigure.x,
        z: selectedFigure.z,
        rotationY: selectedFigure.rotationY,
        scale: selectedFigure.scale,
      });
      figureManager.remove(selectedFigure.instanceId);
      hideToolbar();
    }

    // Remove button
    root.querySelector('[data-fig-remove]')?.addEventListener('click', removeSelectedFigure);

    // Color picker — smart skin tinting:
    // Quaternius models have named materials (Skin, Face, Hair, Shirt, etc.)
    // with solid colors and no textures. We target materials named "Skin" or
    // "Face" for precise skin-tone changes.
    // KayKit models use a single texture atlas on one material. For those,
    // we tint the whole model as a fallback.
    // "Skin" = the entire body + head base (dark). "Face" = eyes, eyebrows, mouth
    // (white shapes on top of the dark head). Only tint Skin so facial features
    // stay their original color.
    const SKIN_MAT_NAMES = new Set(['skin', 'body']);

    const skinPicker = root.querySelector<HTMLInputElement>('[data-fig-skin-picker]');
    function applyModelTint(hexStr: string): void {
      if (!selectedFigure) return;
      const tint = new THREE.Color(hexStr);

      // First pass: check if this model has any named skin materials.
      let hasSkinMats = false;
      selectedFigure.group.traverse((child) => {
        const mesh = child as THREE.Mesh;
        if (!mesh.isMesh || !mesh.material) return;
        const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
        for (const m of mats) {
          if (SKIN_MAT_NAMES.has((m.name || '').toLowerCase())) {
            hasSkinMats = true;
          }
        }
      });

      // Second pass: apply tint to skin-named materials (or all, if no skin mats found).
      selectedFigure.group.traverse((child) => {
        const mesh = child as THREE.Mesh;
        if (!mesh.isMesh || !mesh.material) return;
        const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
        mats.forEach((mat, i) => {
          const m = mat as THREE.MeshStandardMaterial;
          if (!m.color) return;
          // If the model has named skin materials, only tint those.
          // Otherwise tint everything (texture atlas fallback for KayKit).
          const isSkin = SKIN_MAT_NAMES.has((m.name || '').toLowerCase());
          if (hasSkinMats && !isSkin) return;

          // Clone material on first tint so we don't affect the cached template.
          if (!mesh.userData._tinted) {
            if (Array.isArray(mesh.material)) {
              mesh.material = mesh.material.map((mt) => mt.clone());
            } else {
              mesh.material = mesh.material.clone();
            }
            mesh.userData._tinted = true;
          }
          const target = Array.isArray(mesh.material) ? mesh.material[i] : mesh.material;
          (target as THREE.MeshStandardMaterial).color.copy(tint);
        });
      });
    }
    skinPicker?.addEventListener('input', () => applyModelTint(skinPicker.value));

    // Deselect button
    root.querySelector('[data-fig-deselect]')?.addEventListener('click', () => {
      hideToolbar();
    });

    // Clicking empty sand hides the toolbar.
    canvas.addEventListener('pointerdown', () => {
      // This fires AFTER the main pointerdown handler. If selectedFigure was just
      // set (figure was clicked), the toolbar should show. If the click was on
      // empty sand (carving), selectedFigure stays null → hide toolbar.
      // Use a microtask so the main handler runs first.
      queueMicrotask(() => {
        if (selectedFigure) {
          showToolbar(selectedFigure);
        } else {
          hideToolbar();
        }
      });
    });

    // ----- Keyboard operability (canvas has tabindex="0") -----
    // Enter/Space place a pending palette figure at the tray centre.
    // With a placed figure selected: arrows nudge, +/- scale, [/] rotate,
    // Delete/Backspace removes (via the undo-aware path), Escape deselects.
    function nudgeSelectedFigure(dx: number, dz: number): void {
      if (!selectedFigure) return;
      const halfW = SandRenderer.TRAY_W / 2;
      const halfH = SandRenderer.TRAY_H / 2;
      selectedFigure.x = Math.max(-halfW, Math.min(halfW, selectedFigure.x + dx));
      selectedFigure.z = Math.max(-halfH, Math.min(halfH, selectedFigure.z + dz));
      const sandY = renderer.sampleHeight(selectedFigure.x, selectedFigure.z);
      selectedFigure.group.position.set(selectedFigure.x, sandY, selectedFigure.z);
    }

    canvas.addEventListener('keydown', (e: KeyboardEvent) => {
      // Leave browser/global shortcuts (e.g. Cmd/Ctrl+Z undo) untouched.
      if (e.ctrlKey || e.metaKey || e.altKey) return;

      // Place the pending palette figure at the centre of the tray.
      if ((e.key === 'Enter' || e.key === ' ') && pendingFigure) {
        e.preventDefault();
        const pf = pendingFigure;
        figureManager.place(pf.figureId, pf.modelPath, 0, 0, pf.scale)
          .then((fig) => {
            pushUndo({ type: 'place', instanceId: fig.instanceId });
            selectedFigure = fig;
            showToolbar(fig);
          })
          .catch((err) => console.error('[sandtray] place failed:', err));
        setPendingFigure(null);
        return;
      }

      if (e.key === 'Escape') {
        if (pendingFigure) {
          e.preventDefault();
          setPendingFigure(null);
          return;
        }
        if (selectedFigure) {
          e.preventDefault();
          hideToolbar();
        }
        return;
      }

      if (!selectedFigure) return;
      const fig = selectedFigure;
      // ~0.05 of the tray's short dimension per press; Shift for larger steps.
      const step = (e.shiftKey ? 0.15 : 0.05) * SandRenderer.TRAY_H;

      switch (e.key) {
        case 'ArrowLeft':  e.preventDefault(); nudgeSelectedFigure(-step, 0); break;
        case 'ArrowRight': e.preventDefault(); nudgeSelectedFigure(step, 0); break;
        case 'ArrowUp':    e.preventDefault(); nudgeSelectedFigure(0, -step); break;
        case 'ArrowDown':  e.preventDefault(); nudgeSelectedFigure(0, step); break;
        case '+':
        case '=': {
          e.preventDefault();
          const s = Math.min(5.0, fig.scale + 0.15);
          fig.scale = s;
          fig.group.scale.setScalar(s);
          break;
        }
        case '-':
        case '_': {
          e.preventDefault();
          const s = Math.max(0.2, fig.scale - 0.15);
          fig.scale = s;
          fig.group.scale.setScalar(s);
          break;
        }
        case '[':
          e.preventDefault();
          fig.rotationY -= Math.PI / 8;
          fig.group.rotation.y = fig.rotationY;
          break;
        case ']':
          e.preventDefault();
          fig.rotationY += Math.PI / 8;
          fig.group.rotation.y = fig.rotationY;
          break;
        case 'Delete':
        case 'Backspace':
          e.preventDefault();
          removeSelectedFigure();
          break;
      }
    });
  });
</script>
