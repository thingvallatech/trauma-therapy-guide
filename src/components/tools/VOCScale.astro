---
import type { Lang } from '../../i18n';
import ToolSettings from './ToolSettings.astro';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
  warnings?: string[];
}

const { fullscreen = false, lang = 'en', warnings = [] } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-2xl mx-auto p-8"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600";

const t = {
  en: {
    heading: 'How true does the positive belief feel?',
    pcLabel: 'Positive cognition (optional, not stored):',
    pcPlaceholder: 'e.g. I am safe now',
    initialDisplay: 'Somewhat true',
    lowLabel: '1 — completely false',
    highLabel: '7 — completely true',
    ariaLabel: 'VOC level from 1 to 7',
    quote: '"Think about that incident. When you think of the incident, how true do those words feel to you now, on a scale of 1 to 7?"',
    labels: [
      '',
      'Completely false',
      'Mostly false',
      'A little false',
      'Somewhat true',
      'Moderately true',
      'Mostly true',
      'Completely true',
    ],
  },
  es: {
    heading: '¿Qué tan verdadera se siente la creencia positiva?',
    pcLabel: 'Cognición positiva (opcional, no se guarda):',
    pcPlaceholder: 'p. ej. Estoy a salvo ahora',
    initialDisplay: 'Algo verdadera',
    lowLabel: '1 — completamente falsa',
    highLabel: '7 — completamente verdadera',
    ariaLabel: 'Nivel VOC del 1 al 7',
    quote: '"Piensa en ese incidente. Cuando piensas en el incidente, ¿qué tan verdaderas se sienten esas palabras ahora, en una escala del 1 al 7?"',
    labels: [
      '',
      'Completamente falsa',
      'Mayormente falsa',
      'Un poco falsa',
      'Algo verdadera',
      'Moderadamente verdadera',
      'Mayormente verdadera',
      'Completamente verdadera',
    ],
  },
};

const s = t[lang];

// Wired regardless of fullscreen: fullscreen is precisely when a clinician is
// running a session, and a chosen calming background matters most there. The
// fallback tracks each context's own pre-JS look (forest-800's card outside
// fullscreen, FullscreenLayout's own black inside it) so there's no color
// flash before the settings controller hydrates — this only recolors the
// widget's own card, never `FullscreenLayout` itself.
const fieldBgStyle = `background-color: var(--tool-field-bg, ${fullscreen ? '#000000' : '#122E12'});`;
---

<div
  class:list={[containerClass]}
  style={fieldBgStyle}
  data-voc-widget
  data-voc-i18n={JSON.stringify({ labels: s.labels })}
>
  {/*
    The standard tool page renders these above the widget via ToolShell, but the
    fullscreen route renders the widget alone — so the warnings have to travel
    with it or they would vanish exactly where the tool is used in session.
  */}
  {fullscreen && warnings.length > 0 && (
    <div class="mb-2 p-2 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs w-full max-w-md">
      <ul class="list-disc list-inside space-y-1">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  )}

  <ToolSettings componentName="VOCScale" lang={lang} startOpen={!fullscreen} />

  <h2 class="text-forest-100 font-semibold mb-4">{s.heading}</h2>

  <label class="block text-sm text-forest-300 mb-2">{s.pcLabel}</label>
  <input
    type="text"
    data-voc-pc
    placeholder={s.pcPlaceholder}
    class="w-full mb-6 px-3 py-2 rounded-md bg-forest-700 border border-forest-600 text-forest-100 placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
  />

  <div class="text-center mb-6">
    <div
      data-voc-display
      aria-live="polite"
      aria-atomic="true"
      class="font-serif text-7xl font-semibold mb-2 tabular-nums"
      style="color: var(--tool-color, #FFCA28);"
    >4</div>
    <div data-voc-label aria-live="polite" class="text-forest-300 text-sm">{s.initialDisplay}</div>
  </div>

  <input
    type="range"
    min="1"
    max="7"
    step="1"
    value="4"
    data-voc-slider
    aria-label={s.ariaLabel}
    class="w-full h-2 rounded-full bg-forest-700 appearance-none cursor-pointer accent-bronze-500"
  />

  <div class="flex justify-between text-xs text-forest-400 mt-2">
    <span>{s.lowLabel}</span>
    <span>{s.highLabel}</span>
  </div>

  <p class="mt-6 text-sm text-forest-300">
    <em>{s.quote}</em>
  </p>
</div>

<script>
  import { createSettingsController } from '../../scripts/tool-settings-controller';
  import { createAudioEngine, type AmbientOptions } from '../../scripts/audio-engine';

  const TOOL_ID = 'VOCScale';
  const DEFAULTS = {
    soundOn: false, volume: 0.3, palette: 'default',
    // No canvas or target here, but the shared panel still renders palette/
    // color/background — carrying their defaults is what makes those
    // controls persist correctly across a reload even though this widget
    // never reads them back out.
    color: '#FFF8E7', background: '#000000',
    ambient: 'none', ambientVolume: 0.2, binauralBase: 200, binauralBeat: 4,
  };

  const widgets = document.querySelectorAll<HTMLElement>('[data-voc-widget]');
  widgets.forEach((root) => {
    const slider = root.querySelector<HTMLInputElement>('[data-voc-slider]')!;
    const display = root.querySelector<HTMLElement>('[data-voc-display]')!;
    const label = root.querySelector<HTMLElement>('[data-voc-label]')!;

    const i18n = JSON.parse(root.getAttribute('data-voc-i18n') || '{}');
    const labels: string[] = i18n.labels || [];

    // The controller owns the settings panel entirely: hydration, readouts,
    // palette, and persistence. It hydrates during construction, so `get()`
    // already reflects stored prefs.
    const settings = createSettingsController(root, TOOL_ID, DEFAULTS);
    let prefs = settings.get();
    const audio = createAudioEngine();

    // `color` is the foreground accent on `background`'s surface — see the
    // note in Grounding.astro for why buttons are deliberately left off this.
    function applyColors(): void {
      root.style.setProperty('--tool-color', prefs.color);
      root.style.setProperty('--tool-field-bg', prefs.background);
    }

    // Diffs against the ambient layer's own last-applied state before calling
    // `setAmbient` — see the note in Grounding.astro for why this avoids an
    // audible click on every unrelated settings change.
    let lastAmbient: AmbientOptions | null = null;
    function pushAmbient(): void {
      const next: AmbientOptions = {
        kind: prefs.soundOn ? (prefs.ambient as AmbientOptions['kind']) : 'none',
        volume: prefs.ambientVolume,
        binauralBase: prefs.binauralBase,
        binauralBeat: prefs.binauralBeat,
      };
      const patch: Partial<AmbientOptions> = {};
      if (!lastAmbient || lastAmbient.kind !== next.kind) patch.kind = next.kind;
      if (!lastAmbient || lastAmbient.volume !== next.volume) patch.volume = next.volume;
      if (!lastAmbient || lastAmbient.binauralBase !== next.binauralBase) {
        patch.binauralBase = next.binauralBase;
      }
      if (!lastAmbient || lastAmbient.binauralBeat !== next.binauralBeat) {
        patch.binauralBeat = next.binauralBeat;
      }
      lastAmbient = next;
      if (Object.keys(patch).length > 0) audio.setAmbient(patch);
    }

    function pushToEngines(): void {
      audio.setOptions({ volume: prefs.soundOn ? prefs.volume : 0 });
      pushAmbient();
    }

    let audioLive = false;

    async function startAudio(): Promise<void> {
      try {
        await audio.ensureStarted();
        audioLive = true;
      } catch {
        // Autoplay policy or an unavailable AudioContext — the tool still
        // works silently.
      }
    }

    function suspendAudio(): void {
      if (!audioLive) return;
      audio.cancelScheduled();
      audio.suspend();
    }

    // No cue sounds on this tool — see `update()` below. This only makes
    // sure the ambient bed actually gets a user gesture to start on, since a
    // "sound on" preference restored from a previous visit still needs a
    // fresh gesture on this page load before the browser allows audio.
    function ensureAudioLive(): void {
      if (prefs.soundOn && !audioLive) void startAudio().then(() => pushToEngines());
    }

    settings.onChange((next) => {
      const soundCameOn = Boolean(next.soundOn) && !prefs.soundOn;
      const soundWentOff = !next.soundOn && Boolean(prefs.soundOn);
      prefs = next;

      if (soundCameOn) void startAudio().then(() => pushToEngines());
      else if (soundWentOff) suspendAudio();

      pushToEngines();
      applyColors();
    });

    pushToEngines();
    applyColors();

    function update() {
      const v = parseInt(slider.value, 10);
      display.textContent = String(v);
      label.textContent = labels[v] || '';
    }
    // Deliberately no per-increment tick here, even with sound enabled — a
    // noise on every step while someone rates how true a belief feels is the
    // wrong instinct for this tool. Only the ambient bed and palette apply.
    slider.addEventListener('input', () => { update(); ensureAudioLive(); });
    update();
  });
</script>
