---
import type { Lang } from '../../i18n';
import ToolSettings from './ToolSettings.astro';

interface Props {
  fullscreen?: boolean;
  lang?: Lang;
  warnings?: string[];
}

const { fullscreen = false, lang = 'en', warnings = [] } = Astro.props;
const containerClass = fullscreen
  ? "w-full max-w-2xl mx-auto p-8 flex flex-col items-center"
  : "w-full p-6 bg-forest-800 rounded-lg border border-forest-600 flex flex-col items-center";

const t = {
  en: {
    heading: 'Pick a healing color',
    instructions: 'Choose the color that feels most soothing to you right now. There is no wrong answer.',
    nextText: 'Next',
    finishText: 'Finish',
    doneHeading: 'The light is with you.',
    doneBody: "Notice anything that shifted. When you're ready, gently bring your attention back to the room.",
    doItAgain: 'Do it again',
    colorLabels: ['Gold', 'Blue', 'Green', 'White', 'Pink', 'Violet'],
    bodyAreaLabels: [
      'Let the color begin at the top of your head. Notice where it feels warm and soft.',
      'Let it flow down into your face and jaw. Soften anything tight.',
      'Into your neck and shoulders. Let them drop a little.',
      'Into your chest. Notice your breath under the color.',
      'Into your belly. Let it warm the center of you.',
      'Into your hips and low back.',
      'Down through your legs.',
      'All the way to your feet. Let it pool there.',
    ],
  },
  es: {
    heading: 'Elige un color sanador',
    instructions: 'Elige el color que se sienta más calmante para ti ahora. No hay respuesta incorrecta.',
    nextText: 'Siguiente',
    finishText: 'Terminar',
    doneHeading: 'La luz está contigo.',
    doneBody: 'Nota cualquier cosa que haya cambiado. Cuando estés listo/a, regresa suavemente tu atención a la habitación.',
    doItAgain: 'Hazlo de nuevo',
    colorLabels: ['Oro', 'Azul', 'Verde', 'Blanco', 'Rosa', 'Violeta'],
    bodyAreaLabels: [
      'Deja que el color comience en la parte superior de tu cabeza. Nota dónde se siente cálido y suave.',
      'Deja que fluya hacia tu cara y mandíbula. Suaviza cualquier tensión.',
      'Hacia tu cuello y hombros. Déjalos caer un poco.',
      'Hacia tu pecho. Nota tu respiración bajo el color.',
      'Hacia tu vientre. Deja que caliente tu centro.',
      'Hacia tus caderas y espalda baja.',
      'Hacia abajo por tus piernas.',
      'Hasta tus pies. Deja que se acumule ahí.',
    ],
  },
};

const s = t[lang];

// The tool's own meaning, not chrome — left untouched by the palette system.
const colors = [
  { hex: '#F5C46B' },
  { hex: '#6BB3F5' },
  { hex: '#7BC47B' },
  { hex: '#FFFFFF' },
  { hex: '#F5A5C4' },
  { hex: '#B78BE0' },
];
---

<div class:list={[containerClass]} data-lightstream-widget data-lightstream-i18n={JSON.stringify({
  bodyAreas: s.bodyAreaLabels,
  next: s.nextText,
  finish: s.finishText,
})}>
  {/*
    The standard tool page renders these above the widget via ToolShell, but the
    fullscreen route renders the widget alone — so the warnings have to travel
    with it or they would vanish exactly where the tool is used in session.
  */}
  {fullscreen && warnings.length > 0 && (
    <div class="mb-2 p-2 border border-amber-500/50 bg-amber-900/20 rounded-md text-amber-100 text-xs w-full max-w-md">
      <ul class="list-disc list-inside space-y-1">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  )}

  <div class="w-full max-w-md">
    <ToolSettings componentName="Lightstream" lang={lang} startOpen={!fullscreen} />
  </div>

  <div data-step="color" data-step-active class="w-full">
    <h2 class="font-serif text-xl text-forest-100 mb-3">{s.heading}</h2>
    <p class="text-forest-300 text-sm mb-4">{s.instructions}</p>
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
      {colors.map((c, i) => (
        <button
          data-pick-color={c.hex}
          data-color-label={s.colorLabels[i]}
          class="aspect-square rounded-full border-2 border-forest-600 hover:border-white transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
          style={`background-color: ${c.hex}`}
          aria-label={s.colorLabels[i]}
        ></button>
      ))}
    </div>
  </div>

  <div data-step="flow" class="hidden w-full flex flex-col items-center">
    {/*
      This backdrop is the "Background" picker's field — not the theme
      palette's — matching the idiom every other tool uses: the palette
      seeds a sensible starting color, then the picker can override it.
    */}
    <div
      class="relative w-48 h-72 mb-4 rounded-lg"
      style="background: var(--tool-field-bg, transparent);"
    >
      <svg viewBox="0 0 100 150" class="w-full h-full" aria-hidden="true">
        <circle cx="50" cy="18" r="12" fill="none" stroke="var(--tool-accent, #8DB496)" stroke-width="2" />
        <rect x="35" y="30" width="30" height="50" rx="6" fill="none" stroke="var(--tool-accent, #8DB496)" stroke-width="2" />
        <rect x="40" y="80" width="20" height="50" rx="4" fill="none" stroke="var(--tool-accent, #8DB496)" stroke-width="2" />
        <line x1="35" y1="35" x2="25" y2="65" stroke="var(--tool-accent, #8DB496)" stroke-width="2" />
        <line x1="65" y1="35" x2="75" y2="65" stroke="var(--tool-accent, #8DB496)" stroke-width="2" />
        <circle
          data-lightstream-blob
          cx="50" cy="18" r="14"
          fill="#F5C46B"
          opacity="0.55"
          class="transition-all duration-1000 ease-in-out"
        />
      </svg>
    </div>
    <p data-flow-script aria-live="polite" class="text-forest-100 text-center text-lg mb-6 min-h-[4em]"></p>
    <button
      data-flow-next
      class="px-6 py-2 rounded-md bg-bronze-500 text-forest-900 font-semibold hover:bg-bronze-400 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800"
    >
      {s.nextText}
    </button>
  </div>

  <div data-step="done" class="hidden text-center">
    <h2 class="font-serif text-2xl text-forest-100 mb-3">{s.doneHeading}</h2>
    <p class="text-forest-300 mb-6">{s.doneBody}</p>
    <button data-restart class="px-4 py-2 rounded-md bg-forest-700 border border-forest-600 text-forest-100 hover:bg-forest-600 transition-colors focus:outline-none focus:ring-2 focus:ring-bronze-500 focus:ring-offset-2 focus:ring-offset-forest-800">{s.doItAgain}</button>
  </div>
</div>

<script>
  import { onReducedMotion } from '../../scripts/motion-pref';
  import { createSettingsController } from '../../scripts/tool-settings-controller';
  import { DEFAULT_VISUAL_OPTIONS } from '../../scripts/visual-engine';
  import {
    createAudioEngine, DEFAULT_AUDIO_OPTIONS, DEFAULT_AMBIENT_OPTIONS,
    type AmbientOptions,
  } from '../../scripts/audio-engine';

  const TOOL_ID = 'Lightstream';

  const DEFAULTS = {
    palette: 'default',
    // No canvas here, but the shared panel still renders palette/color/
    // background — carrying their defaults is what makes those controls
    // persist correctly even though this widget reads them straight from
    // `--tool-accent` / `--tool-field-bg` instead of a canvas.
    ...DEFAULT_VISUAL_OPTIONS,
    soundOn: false, // cue sounds are opt-in.
    endCue: true,
    ...DEFAULT_AUDIO_OPTIONS,
    ambient: DEFAULT_AMBIENT_OPTIONS.kind,
    ambientVolume: DEFAULT_AMBIENT_OPTIONS.volume,
    binauralBase: DEFAULT_AMBIENT_OPTIONS.binauralBase,
    binauralBeat: DEFAULT_AMBIENT_OPTIONS.binauralBeat,
  };

  const widgets = document.querySelectorAll<HTMLElement>('[data-lightstream-widget]');
  widgets.forEach((root) => {
    const i18n = JSON.parse(root.getAttribute('data-lightstream-i18n') || '{}');
    const labels: string[] = i18n.bodyAreas || [];
    const cyCoords = [18, 28, 38, 50, 68, 85, 105, 130];
    const bodyAreas = labels.map((label, i) => ({ label, cy: cyCoords[i] }));

    const steps: Record<string, HTMLElement> = {};
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
      steps[el.getAttribute('data-step')!] = el;
    });
    const blob = root.querySelector<SVGCircleElement>('[data-lightstream-blob]')!;
    const scriptEl = root.querySelector<HTMLElement>('[data-flow-script]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-flow-next]')!;

    // The controller owns the settings panel entirely: hydration, readouts,
    // palettes, presets, persistence, and reset. It hydrates during
    // construction, so `get()` already reflects stored prefs.
    const settings = createSettingsController(root, TOOL_ID, DEFAULTS);
    let prefs = settings.get();

    function applyColors(): void {
      root.style.setProperty('--tool-accent', prefs.color);
      root.style.setProperty('--tool-field-bg', prefs.background);
    }

    const audio = createAudioEngine();

    let lastAmbient: AmbientOptions | null = null;

    function pushAmbient(): void {
      const next: AmbientOptions = {
        kind: prefs.soundOn ? prefs.ambient : 'none',
        volume: prefs.ambientVolume,
        binauralBase: prefs.binauralBase,
        binauralBeat: prefs.binauralBeat,
      };
      const patch: Partial<AmbientOptions> = {};
      if (!lastAmbient || lastAmbient.kind !== next.kind) patch.kind = next.kind;
      if (!lastAmbient || lastAmbient.volume !== next.volume) patch.volume = next.volume;
      if (!lastAmbient || lastAmbient.binauralBase !== next.binauralBase) {
        patch.binauralBase = next.binauralBase;
      }
      if (!lastAmbient || lastAmbient.binauralBeat !== next.binauralBeat) {
        patch.binauralBeat = next.binauralBeat;
      }
      lastAmbient = next;
      if (Object.keys(patch).length > 0) audio.setAmbient(patch);
    }

    function pushToEngines(): void {
      audio.setOptions({ volume: prefs.soundOn ? (prefs.volume as number) : 0 });
      pushAmbient();
    }

    // No beat scheduling here either — each cue is a single live `playCue`
    // triggered by a click, so only "is there a context worth suspending"
    // needs tracking, not a timebase.
    let audioLive = false;

    async function startAudio(): Promise<void> {
      try {
        await audio.ensureStarted();
        audioLive = true;
      } catch {
        // Autoplay policy or an unavailable AudioContext; the visualization
        // still runs, just silently.
      }
    }

    function suspendAudio(): void {
      if (!audioLive) return;
      audio.cancelScheduled();
      audio.suspend();
    }

    // Read live rather than once at init, so an OS-level reduced-motion
    // change takes effect on the very next step instead of needing a reload.
    let reducedMotion = false;
    onReducedMotion((reduced) => {
      reducedMotion = reduced;
      blob.style.transitionDuration = reducedMotion ? '0ms' : '1000ms';
    });

    let idx = 0;

    function showStep(n: string) {
      Object.values(steps).forEach((el) => el.classList.add('hidden'));
      steps[n].classList.remove('hidden');
    }

    function renderFlow() {
      if (idx >= bodyAreas.length) {
        if (prefs.soundOn && prefs.endCue) audio.playCue('complete');
        showStep('done');
        return;
      }
      const area = bodyAreas[idx];
      scriptEl.textContent = area.label;
      blob.setAttribute('cy', String(area.cy));
      nextBtn.textContent = idx === bodyAreas.length - 1 ? i18n.finish : i18n.next;
      if (prefs.soundOn) audio.playCue('tick');
    }

    root.querySelectorAll<HTMLButtonElement>('[data-pick-color]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hex = btn.getAttribute('data-pick-color')!;
        blob.setAttribute('fill', hex);
        idx = 0;
        // Picking a color is the user gesture that starts the session, same
        // as pressing Start elsewhere — the context may not exist yet even
        // if sound was already on from a stored preference.
        if (prefs.soundOn) void startAudio().then(() => pushToEngines());
        showStep('flow');
        renderFlow();
      });
    });

    nextBtn.addEventListener('click', () => {
      idx += 1;
      renderFlow();
    });

    root.querySelector<HTMLButtonElement>('[data-restart]')!.addEventListener('click', () => {
      idx = 0;
      showStep('color');
      // Returning to the color picker is a session boundary, same as Stop
      // elsewhere — silence rather than leaving the ambient bed running
      // under a screen that no longer has anything to do with it.
      suspendAudio();
    });

    // --- settings wiring -----------------------------------------------

    settings.onChange((next) => {
      // Track the *transition*, not which control caused it — Reset emits
      // key 'reset' and can also turn sound off, and a saved preset can
      // carry soundOn.
      const soundCameOn = Boolean(next.soundOn) && !prefs.soundOn;
      const soundWentOff = !next.soundOn && Boolean(prefs.soundOn);
      prefs = next;

      if (soundCameOn) {
        void startAudio().then(() => pushToEngines());
      } else if (soundWentOff) {
        suspendAudio();
      }

      pushToEngines();
      applyColors();
    });

    // The panel is hydrated by now, so this is the one push that carries
    // stored preferences into the engines.
    pushToEngines();
    applyColors();
  });
</script>
