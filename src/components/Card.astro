---
interface Props {
  href?: string;
  title: string;
  description?: string;
  variant?: 'default' | 'featured';
}

const { href, title, description, variant = 'default' } = Astro.props;

const Tag = href ? 'a' : 'div';
const baseClasses = 'block bg-sand border rounded-lg p-6 transition-all duration-200';
const variantClasses = {
  default: 'border-linen hover:bg-forest-50 hover:border-forest-300 hover:shadow-md',
  featured: 'border-bronze-600/50 shadow-sm hover:bg-forest-50 hover:border-bronze-500 hover:shadow-md',
};
---

<Tag
  href={href}
  class:list={[baseClasses, variantClasses[variant], href && 'cursor-pointer']}
>
  <h3 class="font-serif text-lg font-semibold text-bronze-700 mb-2">
    {title}
  </h3>
  {description && (
    <p class="text-charcoal text-sm leading-relaxed">
      {description}
    </p>
  )}
  <slot />
</Tag>
