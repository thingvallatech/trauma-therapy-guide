---
import { getLangFromUrl, useTranslations, useTranslatedPath, getAlternateLocaleUrl, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentPath = Astro.url.pathname;
const alternateUrl = getAlternateLocaleUrl(Astro.url, lang);
const helpHref = translatePath('/help');

const navLinks = [
  { href: translatePath('/'), label: t('nav.home') },
  { href: translatePath('/clinicians'), label: t('nav.clinicians') },
  { href: translatePath('/families'), label: t('nav.families') },
  { href: translatePath('/about'), label: t('nav.about') },
];

function isActive(href: string): boolean {
  if (href === '/' || href === '/es/') {
    return currentPath === '/' || currentPath === '/es/' || currentPath === '/es';
  }
  return currentPath.startsWith(href);
}
---

<header class="bg-forest-900 backdrop-blur-sm border-b border-forest-700 sticky top-0 z-50 no-print">
  <div class="h-[1px] bg-bronze-500"></div>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 gap-4">
      <a href={translatePath('/')} class="group flex items-center gap-2 font-serif text-xl font-semibold transition-colors flex-shrink-0">
        <img src="/logo.png" alt="Trauma Therapy Guide" class="w-9 h-9 rounded-full" />
        <span class="text-bronze-gradient hidden sm:inline">Trauma Therapy Guide</span>
      </a>

      <button
        type="button"
        class="md:hidden p-2 rounded-md text-forest-100 hover:bg-forest-700 transition-colors"
        aria-label={t('nav.toggleMenu')}
        id="mobile-menu-button"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <ul class="hidden md:flex items-center gap-6 lg:gap-8 flex-shrink-0">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors',
                isActive(link.href)
                  ? 'text-bronze-400'
                  : 'text-forest-100 hover:text-bronze-400'
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="hidden md:flex items-center gap-3 flex-shrink min-w-0">
        <button
          type="button"
          id="search-trigger"
          class="hidden xl:flex w-56 items-center gap-2 px-3 py-1.5 rounded-md bg-forest-800 border border-forest-700 text-forest-300 hover:text-forest-100 hover:border-forest-600 transition-colors"
          aria-label={t('nav.searchSite')}
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="text-sm truncate text-left flex-1">{t('nav.searchPlaceholder')}</span>
          <kbd class="text-[10px] font-mono text-forest-400 bg-forest-900 border border-forest-700 rounded px-1.5 py-0.5 flex-shrink-0">&#8984;K</kbd>
        </button>

        <button
          type="button"
          id="search-trigger-icon"
          class="xl:hidden flex items-center justify-center w-9 h-9 rounded-md text-forest-300 hover:text-forest-100 hover:bg-forest-800 transition-colors flex-shrink-0"
          aria-label={t('nav.searchSite')}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <a
          href={alternateUrl}
          class="text-sm font-medium px-2 py-1 text-forest-300 hover:text-forest-100 border border-forest-700 rounded transition-colors flex-shrink-0"
          aria-label={t('lang.switchLabel')}
        >
          {t('lang.switch')}
        </a>

        <a
          href={helpHref}
          class="text-sm text-forest-200 hover:text-forest-100 underline-offset-4 hover:underline flex-shrink-0 whitespace-nowrap"
          aria-label={t('nav.crisisLinkLabel')}
        >
          {t('nav.crisisLink')}
        </a>
      </div>
    </div>

    <ul class="hidden md:hidden pb-4 space-y-2 bg-forest-800 rounded-b-lg -mx-4 px-4" id="mobile-menu">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'bg-forest-700 text-bronze-400'
                : 'text-forest-100 hover:bg-forest-700'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <button
          type="button"
          class="search-trigger-mobile flex items-center gap-2 w-full px-3 py-2 rounded-md text-sm font-medium text-forest-100 hover:bg-forest-700 transition-colors"
        >
          <svg class="w-4 h-4 text-forest-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          {t('nav.search')}
        </button>
      </li>
      <li>
        <a
          href={alternateUrl}
          class="block px-3 py-2 rounded-md text-sm font-medium text-forest-300 hover:bg-forest-700 transition-colors"
        >
          {t('lang.switchLabel')}
        </a>
      </li>
      <li>
        <a
          href={helpHref}
          class="block px-3 py-2 rounded-md text-sm font-medium text-forest-100 hover:bg-forest-700 transition-colors"
        >
          {t('nav.crisisLinkLabel')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  const searchTrigger = document.getElementById('search-trigger');
  const searchTriggerIcon = document.getElementById('search-trigger-icon');
  const mobileSearchTrigger = document.querySelector('.search-trigger-mobile');

  function handleSearchOpen() {
    if (typeof (window as any).__openSearch === 'function') {
      (window as any).__openSearch();
    }
  }

  searchTrigger?.addEventListener('click', handleSearchOpen);
  searchTriggerIcon?.addEventListener('click', handleSearchOpen);
  mobileSearchTrigger?.addEventListener('click', handleSearchOpen);
</script>
