---
import { getLangFromUrl, useTranslations, useTranslatedPath, getAlternateLocaleUrl, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentPath = Astro.url.pathname;
const alternateUrl = getAlternateLocaleUrl(Astro.url, lang);

const navLinks = [
  { href: translatePath('/'), label: t('nav.home') },
  { href: translatePath('/clinicians'), label: t('nav.clinicians') },
  { href: translatePath('/families'), label: t('nav.families') },
  { href: translatePath('/tools'), label: t('nav.tools') },
  { href: translatePath('/about'), label: t('nav.about') },
];

function isActive(href: string): boolean {
  if (href === '/' || href === '/es/') {
    return currentPath === '/' || currentPath === '/es/' || currentPath === '/es';
  }
  return currentPath.startsWith(href);
}
---

<header class="bg-forest-900 backdrop-blur-sm border-b border-forest-600 sticky top-0 z-50">
  <!-- Bronze accent line -->
  <div class="h-[1px] bg-bronze-500"></div>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href={translatePath('/')} class="group flex items-center gap-2 font-serif text-xl font-semibold transition-colors">
        <img src="/logo.png" alt="Trauma Therapy Guide" class="w-9 h-9 rounded-full" />
        <span class="bg-gradient-to-r from-[#C49A47] to-[#D4AA63] bg-clip-text text-transparent">Trauma Therapy Guide</span>
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 rounded-md text-bronze-400 hover:bg-forest-700 transition-colors"
        aria-label={t('nav.toggleMenu')}
        id="mobile-menu-button"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Desktop navigation -->
      <ul class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors',
                isActive(link.href)
                  ? 'text-bronze-400'
                  : 'text-forest-100 hover:text-bronze-400'
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <button
            type="button"
            id="search-trigger"
            class="flex items-center gap-1.5 text-sm text-forest-300 hover:text-forest-100 transition-colors"
            aria-label={t('nav.searchSite')}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <kbd class="hidden lg:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-forest-400 bg-forest-700 border border-forest-600 rounded">&#8984;K</kbd>
          </button>
        </li>
        <li>
          <a
            href={alternateUrl}
            class="text-sm font-medium px-2 py-1 text-forest-300 hover:text-forest-100 border border-forest-600 rounded transition-colors"
            aria-label={t('lang.switchLabel')}
          >
            {t('lang.switch')}
          </a>
        </li>
        <li>
          <a
            href="#crisis-resources"
            class="text-sm font-medium px-3 py-1.5 bg-bronze-400/20 text-bronze-400 rounded-full hover:bg-bronze-400/30 transition-colors"
          >
            {t('nav.crisisLink')}
          </a>
        </li>
      </ul>
    </div>

    <!-- Mobile navigation -->
    <ul class="hidden md:hidden pb-4 space-y-2 bg-forest-800 rounded-b-lg -mx-4 px-4" id="mobile-menu">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'bg-forest-700 text-bronze-400'
                : 'text-forest-100 hover:bg-forest-700'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <button
          type="button"
          class="search-trigger-mobile flex items-center gap-2 w-full px-3 py-2 rounded-md text-sm font-medium text-forest-100 hover:bg-forest-700 transition-colors"
        >
          <svg class="w-4 h-4 text-forest-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          {t('nav.search')}
        </button>
      </li>
      <li>
        <a
          href={alternateUrl}
          class="block px-3 py-2 rounded-md text-sm font-medium text-forest-300 hover:bg-forest-700 transition-colors"
        >
          {t('lang.switchLabel')}
        </a>
      </li>
      <li>
        <a
          href="#crisis-resources"
          class="block px-3 py-2 rounded-md text-sm font-medium text-bronze-400 hover:bg-bronze-400/20 transition-colors"
        >
          {t('nav.crisisLink')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Search trigger buttons
  const searchTrigger = document.getElementById('search-trigger');
  const mobileSearchTrigger = document.querySelector('.search-trigger-mobile');

  function handleSearchOpen() {
    if (typeof (window as any).__openSearch === 'function') {
      (window as any).__openSearch();
    }
  }

  searchTrigger?.addEventListener('click', handleSearchOpen);
  mobileSearchTrigger?.addEventListener('click', handleSearchOpen);
</script>
