---
import { getLangFromUrl, useTranslations, useTranslatedPath, getAlternateLocaleUrl, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentPath = Astro.url.pathname;
const alternateUrl = getAlternateLocaleUrl(Astro.url, lang);
const helpHref = translatePath('/help');

interface NavItem {
  href: string;
  label: string;
  submenu?: { href: string; label: string }[];
}

const navItems: NavItem[] = [
  { href: translatePath('/'), label: t('nav.home') },
  {
    href: translatePath('/clinicians'),
    label: t('nav.clinicians'),
    submenu: [
      { href: translatePath('/clinicians'), label: t('nav.overview') },
      { href: translatePath('/clinicians/emdr'), label: t('footer.emdrProtocol') },
      { href: translatePath('/clinicians/emdr/tools'), label: t('nav.tools') },
      { href: translatePath('/clinicians/resources'), label: t('footer.resourceLibrary') },
    ],
  },
  {
    href: translatePath('/families'),
    label: t('nav.families'),
    submenu: [
      { href: translatePath('/families'), label: t('nav.overview') },
      { href: translatePath('/families/emdr/tools'), label: t('nav.tools') },
      { href: translatePath('/families/resources'), label: t('footer.resourceLibrary') },
    ],
  },
  { href: translatePath('/about'), label: t('nav.about') },
];

function isActive(href: string): boolean {
  if (href === '/' || href === '/es/') {
    return currentPath === '/' || currentPath === '/es/' || currentPath === '/es';
  }
  return currentPath.startsWith(href);
}

function isParentActive(item: NavItem): boolean {
  if (isActive(item.href)) return true;
  return item.submenu?.some((s) => currentPath.startsWith(s.href)) ?? false;
}
---

<header class="bg-forest-900 backdrop-blur-sm border-b border-forest-700 sticky top-0 z-50 no-print">
  <div class="h-[1px] bg-bronze-500"></div>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 gap-4">
      <a href={translatePath('/')} class="group flex items-center gap-2 font-serif text-xl font-semibold transition-colors flex-shrink-0">
        <img src="/logo.png" alt="" class="w-9 h-9 rounded-full" />
        <span class="sr-only sm:hidden">Trauma Therapy Guide</span>
        <span class="text-bronze-gradient hidden sm:inline">Trauma Therapy Guide</span>
      </a>

      <button
        type="button"
        class="md:hidden p-2 rounded-md text-forest-100 hover:bg-forest-700 transition-colors"
        aria-label={t('nav.toggleMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <ul class="hidden md:flex items-center gap-6 lg:gap-8 flex-shrink-0">
        {navItems.map((item) => (
          item.submenu ? (
            <li class="relative" data-dropdown>
              <button
                type="button"
                class:list={[
                  'flex items-center gap-1 text-sm font-medium transition-colors',
                  isParentActive(item)
                    ? 'text-bronze-400'
                    : 'text-forest-100 hover:text-bronze-400'
                ]}
                aria-haspopup="true"
                aria-expanded="false"
                data-dropdown-trigger
              >
                {item.label}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div
                class="hidden absolute top-full left-0 mt-2 w-56 bg-forest-800 border border-forest-700 rounded-lg shadow-2xl py-1 z-50"
                role="menu"
                data-dropdown-menu
              >
                {item.submenu.map((sub) => (
                  <a
                    href={sub.href}
                    role="menuitem"
                    class:list={[
                      'block px-4 py-2 text-sm transition-colors',
                      currentPath.startsWith(sub.href) && sub.href !== item.href
                        ? 'text-bronze-400 bg-forest-900/50'
                        : currentPath === sub.href
                          ? 'text-bronze-400 bg-forest-900/50'
                          : 'text-forest-100 hover:bg-forest-700 hover:text-bronze-400'
                    ]}
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'text-sm font-medium transition-colors',
                  isActive(item.href)
                    ? 'text-bronze-400'
                    : 'text-forest-100 hover:text-bronze-400'
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        ))}
      </ul>

      <div class="hidden md:flex items-center gap-3 flex-shrink min-w-0">
        <button
          type="button"
          id="search-trigger"
          class="hidden xl:flex w-56 items-center gap-2 px-3 py-1.5 rounded-md bg-forest-800 border border-forest-700 text-forest-300 hover:text-forest-100 hover:border-forest-600 transition-colors"
          aria-label={t('nav.searchSite')}
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="text-sm truncate text-left flex-1">{t('nav.searchPlaceholder')}</span>
          <kbd class="text-[10px] font-mono text-forest-400 bg-forest-900 border border-forest-700 rounded px-1.5 py-0.5 flex-shrink-0">&#8984;K</kbd>
        </button>

        <button
          type="button"
          id="search-trigger-icon"
          class="xl:hidden flex items-center justify-center w-9 h-9 rounded-md text-forest-300 hover:text-forest-100 hover:bg-forest-800 transition-colors flex-shrink-0"
          aria-label={t('nav.searchSite')}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <a
          href={alternateUrl}
          class="text-sm font-medium px-2 py-1 text-forest-300 hover:text-forest-100 border border-forest-700 rounded transition-colors flex-shrink-0"
          aria-label={t('lang.switchLabel')}
        >
          {t('lang.switch')}
        </a>

        <a
          href={helpHref}
          class="text-sm text-forest-200 hover:text-forest-100 underline-offset-4 hover:underline flex-shrink-0 whitespace-nowrap"
          aria-label={t('nav.crisisLinkLabel')}
        >
          {t('nav.crisisLink')}
        </a>
      </div>
    </div>

    <ul class="hidden md:hidden pb-4 space-y-1 bg-forest-800 rounded-b-lg -mx-4 px-4" id="mobile-menu">
      {navItems.map((item) => (
        item.submenu ? (
          <li>
            <details class="group" open={isParentActive(item) || undefined}>
              <summary class:list={[
                'flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium transition-colors cursor-pointer list-none',
                isParentActive(item) ? 'text-bronze-400' : 'text-forest-100 hover:bg-forest-700'
              ]}>
                <span>{item.label}</span>
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <ul class="mt-1 ml-4 space-y-1 border-l border-forest-700 pl-3">
                {item.submenu.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class:list={[
                        'block px-3 py-2 rounded-md text-sm transition-colors',
                        currentPath === sub.href || (sub.href !== item.href && currentPath.startsWith(sub.href))
                          ? 'text-bronze-400 bg-forest-900/40'
                          : 'text-forest-200 hover:bg-forest-700 hover:text-bronze-400'
                      ]}
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li>
            <a
              href={item.href}
              class:list={[
                'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'bg-forest-700 text-bronze-400'
                  : 'text-forest-100 hover:bg-forest-700'
              ]}
            >
              {item.label}
            </a>
          </li>
        )
      ))}
      <li>
        <button
          type="button"
          class="search-trigger-mobile flex items-center gap-2 w-full px-3 py-2 rounded-md text-sm font-medium text-forest-100 hover:bg-forest-700 transition-colors"
        >
          <svg class="w-4 h-4 text-forest-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          {t('nav.search')}
        </button>
      </li>
      <li>
        <a
          href={alternateUrl}
          class="block px-3 py-2 rounded-md text-sm font-medium text-forest-300 hover:bg-forest-700 transition-colors"
        >
          {t('lang.switchLabel')}
        </a>
      </li>
      <li>
        <a
          href={helpHref}
          class="block px-3 py-2 rounded-md text-sm font-medium text-forest-100 hover:bg-forest-700 transition-colors"
        >
          {t('nav.crisisLinkLabel')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    mobileBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Search triggers
  const searchTrigger = document.getElementById('search-trigger');
  const searchTriggerIcon = document.getElementById('search-trigger-icon');
  const mobileSearchTrigger = document.querySelector('.search-trigger-mobile');
  function handleSearchOpen() {
    if (typeof (window as any).__openSearch === 'function') {
      (window as any).__openSearch();
    }
  }
  searchTrigger?.addEventListener('click', handleSearchOpen);
  searchTriggerIcon?.addEventListener('click', handleSearchOpen);
  mobileSearchTrigger?.addEventListener('click', handleSearchOpen);

  // Desktop dropdown menus
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown]'));
  const closeAllDropdowns = (except?: HTMLElement) => {
    dropdowns.forEach((d) => {
      if (d === except) return;
      const menu = d.querySelector<HTMLElement>('[data-dropdown-menu]');
      const trigger = d.querySelector<HTMLElement>('[data-dropdown-trigger]');
      menu?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
    });
  };
  dropdowns.forEach((d) => {
    const trigger = d.querySelector<HTMLElement>('[data-dropdown-trigger]');
    const menu = d.querySelector<HTMLElement>('[data-dropdown-menu]');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = menu?.classList.contains('hidden');
      closeAllDropdowns(d);
      if (willOpen) {
        menu?.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      } else {
        menu?.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    const insideDropdown = dropdowns.some((d) => d.contains(target));
    if (!insideDropdown) closeAllDropdowns();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const openTrigger = dropdowns
        .map((d) => d.querySelector<HTMLElement>('[data-dropdown-trigger][aria-expanded="true"]'))
        .find(Boolean);
      closeAllDropdowns();
      openTrigger?.focus();
    }
  });
</script>
