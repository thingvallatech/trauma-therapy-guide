---
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();
const smsBody = lang === 'es' ? 'HOLA' : 'HELLO';
---

<footer class="bg-forest-900 text-forest-100 mt-auto no-print">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <div class="md:col-span-1">
        <h3 class="font-serif text-lg font-semibold text-bronze-gradient mb-4">Trauma Therapy Guide</h3>
        <p class="text-forest-200 text-sm leading-relaxed mb-3">
          {t('footer.tagline')}
        </p>
        <p class="text-forest-300 text-xs leading-relaxed italic">
          {t('footer.dontSell')}
        </p>
      </div>

      <div class="md:col-span-1">
        <h4 class="text-bronze-400 font-semibold text-sm uppercase tracking-wide mb-4">{t('footer.quickLinks')}</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={translatePath('/clinicians')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('nav.clinicians')}
            </a>
          </li>
          <li>
            <a href={translatePath('/families')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('nav.families')}
            </a>
          </li>
          <li>
            <a href={translatePath('/clinicians/emdr')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('footer.emdrProtocol')}
            </a>
          </li>
          <li>
            <a href={translatePath('/clinicians/resources')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('footer.resourceLibrary')}
            </a>
          </li>
          <li>
            <a href={translatePath('/about')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('nav.about')}
            </a>
          </li>
        </ul>
      </div>

      <div id="crisis-resources" class="md:col-span-1">
        <div class="bg-forest-800 border border-forest-700 rounded-xl p-5">
          <h4 class="text-bronze-400 font-semibold text-sm uppercase tracking-wide mb-3">{t('footer.crisisTitle')}</h4>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="tel:988" class="text-forest-100 hover:text-bronze-400 transition-colors font-medium">
                {t('footer.crisis988')}
              </a>
              <p class="text-forest-300 text-xs mt-0.5">{t('footer.crisis988desc')}</p>
            </li>
            <li>
              <a href={`sms:741741&body=${smsBody}`} class="text-forest-100 hover:text-bronze-400 transition-colors font-medium">
                {t('footer.crisisText')}
              </a>
              <p class="text-forest-300 text-xs mt-0.5">{t('footer.crisisTextDesc')}</p>
            </li>
            <li>
              <a href="tel:18006564673" class="text-forest-100 hover:text-bronze-400 transition-colors font-medium">
                {t('footer.rainn')}
              </a>
              <p class="text-forest-300 text-xs mt-0.5">{t('footer.rainnDesc')}</p>
            </li>
            <li>
              <a href="tel:911" class="text-forest-100 hover:text-bronze-400 transition-colors font-medium">
                {t('footer.emergency')}
              </a>
            </li>
          </ul>
          <a href={translatePath('/help')} class="mt-4 inline-flex items-center gap-1 text-bronze-400 text-sm hover:text-bronze-500 transition-colors">
            {t('footer.helpPage')} →
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-forest-700 mt-10 pt-6 text-xs text-forest-400 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p>&copy; {currentYear} {t('footer.copyright')}</p>
      <p>{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>
