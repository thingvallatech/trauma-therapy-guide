---
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-forest-900 text-forest-100 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h3 class="font-serif text-lg font-semibold text-bronze-gradient mb-4">Trauma Therapy Guide</h3>
        <p class="text-forest-200 text-sm leading-relaxed">
          {t('footer.tagline')}
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-bronze-gradient mb-4">{t('footer.quickLinks')}</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={translatePath('/clinicians')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('nav.clinicians')}
            </a>
          </li>
          <li>
            <a href={translatePath('/families')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('nav.families')}
            </a>
          </li>
          <li>
            <a href={translatePath('/about')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('nav.about')}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-bronze-gradient mb-4">{t('footer.resources')}</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={translatePath('/clinicians/emdr')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('footer.emdrProtocol')}
            </a>
          </li>
          <li>
            <a href={translatePath('/clinicians/resources')} class="text-forest-200 hover:text-bronze-400 transition-colors">
              {t('footer.resourceLibrary')}
            </a>
          </li>
        </ul>
      </div>

      <div id="crisis-resources">
        <h4 class="font-semibold text-bronze-400 mb-4">{t('footer.crisisTitle')}</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="tel:988" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              {t('footer.crisis988')}
            </a>
            <p class="text-forest-400 text-xs">{t('footer.crisis988desc')}</p>
          </li>
          <li>
            <a href={lang === 'es' ? 'sms:741741&body=HOLA' : 'sms:741741&body=HELLO'} class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              {t('footer.crisisText')}
            </a>
            <p class="text-forest-400 text-xs">{t('footer.crisisTextDesc')}</p>
          </li>
          <li>
            <a href="tel:18006564673" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              {t('footer.rainn')}
            </a>
            <p class="text-forest-400 text-xs">{t('footer.rainnDesc')}</p>
          </li>
          <li>
            <a href="tel:911" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              {t('footer.emergency')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-forest-600 mt-8 pt-8 text-center text-sm text-forest-300">
      <p>&copy; {currentYear} {t('footer.copyright')}</p>
      <p class="mt-2">{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>
