---
const currentYear = new Date().getFullYear();
---

<footer class="bg-forest-900 text-forest-100 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h3 class="font-serif text-lg font-semibold text-bronze-gradient mb-4">Trauma Therapy Guide</h3>
        <p class="text-forest-200 text-sm leading-relaxed">
          A free resource for trauma therapists and families navigating evidence-based treatment.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-bronze-gradient mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/clinicians" class="text-forest-200 hover:text-bronze-400 transition-colors">
              For Clinicians
            </a>
          </li>
          <li>
            <a href="/families" class="text-forest-200 hover:text-bronze-400 transition-colors">
              For Patients & Families
            </a>
          </li>
          <li>
            <a href="/about" class="text-forest-200 hover:text-bronze-400 transition-colors">
              About
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-bronze-gradient mb-4">Resources</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/clinicians/emdr" class="text-forest-200 hover:text-bronze-400 transition-colors">
              EMDR Protocol
            </a>
          </li>
          <li>
            <a href="/clinicians/resources" class="text-forest-200 hover:text-bronze-400 transition-colors">
              Resource Library
            </a>
          </li>
        </ul>
      </div>

      <div id="crisis-resources">
        <h4 class="font-semibold text-bronze-400 mb-4">Need Help Now?</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="tel:988" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              988 Suicide & Crisis Lifeline
            </a>
            <p class="text-forest-400 text-xs">Call or text 988</p>
          </li>
          <li>
            <a href="sms:741741&body=HELLO" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              Crisis Text Line
            </a>
            <p class="text-forest-400 text-xs">Text HELLO to 741741</p>
          </li>
          <li>
            <a href="tel:18006564673" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              RAINN Hotline
            </a>
            <p class="text-forest-400 text-xs">1-800-656-4673</p>
          </li>
          <li>
            <a href="tel:911" class="text-forest-200 hover:text-bronze-400 transition-colors font-medium">
              Emergency: 911
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-forest-600 mt-8 pt-8 text-center text-sm text-forest-300">
      <p>&copy; {currentYear} Trauma Therapy Guide. For educational purposes only.</p>
      <p class="mt-2">This site does not provide medical advice. Always consult qualified professionals.</p>
    </div>
  </div>
</footer>
