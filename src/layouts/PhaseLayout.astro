---
import BaseLayout from './BaseLayout.astro';
import ClinicalBanner from '../components/ClinicalBanner.astro';
import References from '../components/References.astro';
import PhaseNav from '../components/PhaseNav.astro';
import Callout from '../components/Callout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../i18n';

interface Props {
  phase: number;
  title: string;
  shortTitle: string;
  description: string;
  goals: string[];
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url);
const { phase, title, shortTitle, description, goals, lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={`${t('phase.phase')} ${phase}: ${shortTitle} - EMDR`} description={description} lang={lang}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <ol class="flex items-center gap-2 text-forest-500">
        <li><a href={translatePath('/clinicians')} class="hover:text-forest-700 transition-colors">{t('breadcrumb.clinicians')}</a></li>
        <li>/</li>
        <li><a href={translatePath('/clinicians/emdr')} class="hover:text-forest-700 transition-colors">{t('breadcrumb.emdr')}</a></li>
        <li>/</li>
        <li class="text-forest-900 font-medium">{t('phase.phase')} {phase}</li>
      </ol>
    </nav>

    <ClinicalBanner lang={lang} />

    <!-- Header -->
    <header class="mb-8">
      <p class="text-forest-600 font-medium mb-2">{t('phase.phase')} {phase} {t('phase.of')} 8</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-forest-900 mb-4">
        {title}
      </h1>
      <p class="text-lg text-charcoal leading-relaxed">
        {description}
      </p>
    </header>

    <!-- Goals -->
    <Callout type="tip" title={t('phase.goals')} lang={lang}>
      <ul class="list-disc list-inside space-y-1">
        {goals.map((goal) => (
          <li>{goal}</li>
        ))}
      </ul>
    </Callout>

    <!-- Main content -->
    <article class="prose mt-8">
      <slot />
    </article>

    <References lang={lang} />

    <!-- Navigation -->
    <PhaseNav currentPhase={phase} lang={lang} />
  </div>
</BaseLayout>
